{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kriseva",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./website/dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
