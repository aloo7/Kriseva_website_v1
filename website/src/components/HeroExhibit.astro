---
/**
 * HeroExhibit
 * ------------------------------------------------------------------------
 * Cinematic-but-lightweight bundle → decision exhibit for the homepage hero.
 *
 * Visual: three offset paper cards (RFP / BOQ / ATC) on a navy panel; a
 * brass evidence-trail line drops from the bundle to a BID / REVIEW / SKIP
 * decision strip. Bundle chips below give the rest of the document family.
 *
 * Implementation notes:
 *  - 100% HTML + scoped CSS + tiny SVG. No canvas, no WebGL, no JS framework.
 *  - Cards / connector / pills enter on first viewport entry via the existing
 *    site-wide `.reveal` → `.is-visible` mechanism in BaseLayout.astro. Each
 *    moving element carries `--idx` so transition-delay cascades 80 ms apart.
 *  - The brass orb pulses ONCE via a non-looping CSS keyframe.
 *  - Reduced-motion: cards render at final state instantly, orb does not pulse.
 *  - Pointer-coarse: no hover-only affordances are exposed.
 *  - Sample labels are abstract document types — no real tender numbers,
 *    agency names, or sensitive values appear.
 *  - Cards are decorative. The exhibit's accessible name is set via aria-label
 *    on the figure; inner content is `aria-hidden="true"` so a screen reader
 *    reads one short caption rather than every card label.
 */
---
<figure class="exhibit reveal" aria-label="Sample exhibit — a tender bundle resolves into a BID / REVIEW / SKIP recommendation. Decorative.">
  <header class="exhibit__head">
    <span class="exhibit__caption">EXHIBIT · BUNDLE → DECISION</span>
    <span class="exhibit__id">SAMPLE / KRISEVA-EXH-01</span>
  </header>

  <div class="exhibit__stack" aria-hidden="true">
    <article class="exhibit__card exhibit__card--1" style="--idx: 0;">
      <div class="exhibit__card-head">
        <span class="exhibit__tag">RFP</span>
        <span class="exhibit__type">BID DOCUMENT</span>
        <span class="exhibit__orb" aria-hidden="true"></span>
      </div>
      <div class="exhibit__lines">
        <span style="width: 78%"></span>
        <span style="width: 92%"></span>
        <span style="width: 64%"></span>
      </div>
    </article>

    <article class="exhibit__card exhibit__card--2" style="--idx: 1;">
      <div class="exhibit__card-head">
        <span class="exhibit__tag">BOQ</span>
        <span class="exhibit__type">BILL OF QUANTITIES</span>
      </div>
      <div class="exhibit__lines">
        <span style="width: 88%"></span>
        <span style="width: 70%"></span>
      </div>
    </article>

    <article class="exhibit__card exhibit__card--3" style="--idx: 2;">
      <div class="exhibit__card-head">
        <span class="exhibit__tag">ATC</span>
        <span class="exhibit__type">ADDITIONAL TERMS</span>
      </div>
      <div class="exhibit__lines">
        <span style="width: 60%"></span>
        <span style="width: 84%"></span>
      </div>
    </article>
  </div>

  <ul class="exhibit__chips" aria-hidden="true">
    <li>RFP</li>
    <li>BOQ</li>
    <li>ATC</li>
    <li>CORRIGENDUM</li>
    <li>ANNEXURE</li>
    <li>SPEC</li>
  </ul>

  <svg class="exhibit__connector" viewBox="0 0 240 60" preserveAspectRatio="none" aria-hidden="true">
    <path
      class="exhibit__connector-path"
      d="M 12 4 L 12 24 C 12 32 20 32 28 32 L 212 32 C 220 32 228 32 228 40 L 228 56"
      fill="none"
      stroke="var(--accent-primary)"
      stroke-width="1.5"
      stroke-linecap="round"
    />
    <circle class="exhibit__connector-dot" cx="120" cy="32" r="2.5" />
  </svg>

  <div class="exhibit__decision" aria-hidden="true">
    <span class="exhibit__pill exhibit__pill--bid"    style="--idx: 0;"><span class="exhibit__pill-dot"></span>BID</span>
    <span class="exhibit__pill exhibit__pill--review" style="--idx: 1;"><span class="exhibit__pill-dot"></span>REVIEW</span>
    <span class="exhibit__pill exhibit__pill--skip"   style="--idx: 2;"><span class="exhibit__pill-dot"></span>SKIP</span>
  </div>

  <figcaption class="exhibit__caveat">
    Sample exhibit · structural reference · not a real tender
  </figcaption>
</figure>

<style>
  .exhibit {
    position: relative;
    margin: 0;
    padding: 22px 22px 18px;
    background:
      radial-gradient(120% 60% at 0% 0%, rgba(193, 138, 62, 0.06) 0%, transparent 55%),
      var(--surface-base);
    border: 1px solid rgba(193, 138, 62, 0.32);
    border-radius: var(--radius-frame);
    box-shadow: var(--shadow-depth);
    overflow: hidden;
    display: grid;
    gap: 14px;
  }
  /* Faint corner brass tab — picks up the dossier-tab idiom. */
  .exhibit::before {
    content: "";
    position: absolute;
    top: 0; left: 22px; right: 22px;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--accent-primary) 18%,
      var(--accent-primary) 22%,
      transparent 22%,
      transparent 28%,
      var(--accent-primary) 28%,
      var(--accent-primary) 100%
    );
    opacity: 0.55;
  }

  .exhibit__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 4px;
  }
  .exhibit__caption {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    color: var(--accent-primary);
    text-transform: uppercase;
  }
  .exhibit__id {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    color: var(--text-faint);
    text-transform: uppercase;
  }

  /* ─────────────── Bundle stack ─────────────── */

  .exhibit__stack {
    position: relative;
    height: 184px;
    margin-top: 6px;
  }
  .exhibit__card {
    position: absolute;
    left: 0; right: 0;
    height: 96px;
    padding: 12px 14px;
    background: var(--surface-paper);
    border: 1px solid rgba(193, 138, 62, 0.55);
    border-radius: var(--radius-panel);
    box-shadow: 0 12px 28px rgba(3, 10, 20, 0.36);
    display: grid;
    gap: 10px;
    align-content: start;
    color: var(--ink-primary);
    /* Reveal mechanics — start hidden + slightly off, transition into final
       transform when the parent gains .is-visible. Stagger via --idx. */
    opacity: 0;
    transform: translate(var(--tx, 0), var(--ty, 0)) translateY(18px) rotate(var(--rot, 0deg));
    transition:
      opacity 540ms var(--ease-out),
      transform 540ms var(--ease-out);
    transition-delay: calc(var(--idx, 0) * 80ms);
  }
  .exhibit.is-visible .exhibit__card {
    opacity: 1;
    transform: translate(var(--tx, 0), var(--ty, 0)) rotate(var(--rot, 0deg));
  }
  /* Final positions for each card — stacked diagonally. */
  .exhibit__card--1 { --tx: 0; --ty: 0px; --rot: -1.2deg; z-index: 3; }
  .exhibit__card--2 { --tx: 16px; --ty: 38px; --rot: 0.4deg; z-index: 2; }
  .exhibit__card--3 { --tx: -10px; --ty: 76px; --rot: -0.6deg; z-index: 1; }

  .exhibit__card-head {
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px dashed rgba(16, 35, 59, 0.18);
    padding-bottom: 8px;
  }
  .exhibit__tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--accent-soft);
    background: rgba(193, 138, 62, 0.08);
    border: 1px solid rgba(193, 138, 62, 0.22);
    padding: 2px 7px;
    border-radius: 3px;
  }
  .exhibit__type {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--ink-quiet);
    text-transform: uppercase;
  }
  .exhibit__orb {
    margin-left: auto;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-primary);
    flex-shrink: 0;
    /* One-shot pulse, never loops, never reduced-motion. */
    animation: exhibit-orb-pulse 1300ms cubic-bezier(0.2, 0.7, 0.2, 1) 700ms 1 both;
  }
  @keyframes exhibit-orb-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(193, 138, 62, 0.0); }
    35%  { box-shadow: 0 0 0 6px rgba(193, 138, 62, 0.32); }
    100% { box-shadow: 0 0 0 14px rgba(193, 138, 62, 0); }
  }
  .exhibit__lines {
    display: grid;
    gap: 6px;
  }
  .exhibit__lines span {
    display: block;
    height: 6px;
    border-radius: 1px;
    background: rgba(16, 35, 59, 0.16);
  }
  .exhibit__lines span:first-child {
    background: rgba(16, 35, 59, 0.32);
  }

  /* ─────────────── Document family chips ─────────────── */

  .exhibit__chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
    padding: 0;
  }
  .exhibit__chips li {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    color: var(--accent-primary);
    background: rgba(193, 138, 62, 0.08);
    border: 1px solid rgba(193, 138, 62, 0.22);
    padding: 3px 8px;
    border-radius: 3px;
    text-transform: uppercase;
  }

  /* ─────────────── Connector ─────────────── */

  .exhibit__connector {
    width: 100%;
    height: 50px;
    margin: 4px 0 0;
  }
  .exhibit__connector-path {
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    transition: stroke-dashoffset 900ms var(--ease-out);
    transition-delay: 360ms;
  }
  .exhibit.is-visible .exhibit__connector-path {
    stroke-dashoffset: 0;
  }
  .exhibit__connector-dot {
    fill: var(--accent-primary);
    opacity: 0;
    transition: opacity 240ms var(--ease-out);
    transition-delay: 1100ms;
  }
  .exhibit.is-visible .exhibit__connector-dot {
    opacity: 1;
  }

  /* ─────────────── Decision strip ─────────────── */

  .exhibit__decision {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: 2px;
  }
  .exhibit__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 9px 6px;
    background: var(--surface-paper);
    border: 1px solid rgba(193, 138, 62, 0.34);
    border-radius: var(--radius-control);
    box-shadow: 0 6px 14px rgba(3, 10, 20, 0.28);
    /* Reveal mechanics. */
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 360ms var(--ease-out),
      transform 360ms var(--ease-out);
    transition-delay: calc(900ms + var(--idx, 0) * 80ms);
  }
  .exhibit.is-visible .exhibit__pill {
    opacity: 1;
    transform: none;
  }
  .exhibit__pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }
  .exhibit__pill--bid    { color: var(--decision-bid); }
  .exhibit__pill--review { color: var(--decision-review); }
  .exhibit__pill--skip   { color: var(--decision-skip); }

  /* ─────────────── Caveat ─────────────── */

  .exhibit__caveat {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: var(--text-faint);
    text-transform: uppercase;
    text-align: center;
    border-top: 1px dashed rgba(193, 138, 62, 0.2);
    padding-top: 10px;
  }

  /* ─────────────── Responsive ─────────────── */

  /* Tablet: shrink slightly, keep all elements visible. */
  @media (max-width: 1024px) {
    .exhibit { padding: 18px; }
    .exhibit__stack { height: 168px; }
    .exhibit__card { height: 88px; padding: 10px 12px; }
    .exhibit__card--2 { --ty: 34px; }
    .exhibit__card--3 { --ty: 68px; }
  }
  /* Mobile: collapse the diagonal cascade into a near-flat stack so the
     exhibit reads cleanly at 360 px without horizontal overflow. */
  @media (max-width: 600px) {
    .exhibit { padding: 16px 14px 14px; }
    .exhibit__stack { height: 156px; }
    .exhibit__card { height: 76px; padding: 9px 11px; gap: 7px; }
    .exhibit__card--1 { --rot: -0.8deg; }
    .exhibit__card--2 { --tx: 6px;  --ty: 32px; --rot: 0.3deg; }
    .exhibit__card--3 { --tx: -4px; --ty: 64px; --rot: -0.4deg; }
    .exhibit__type { font-size: 0.58rem; }
    .exhibit__chips { gap: 5px; }
    .exhibit__chips li { font-size: 0.55rem; padding: 2px 6px; }
    .exhibit__decision { gap: 6px; }
    .exhibit__pill { font-size: 0.66rem; padding: 8px 4px; }
  }
  @media (max-width: 380px) {
    .exhibit__pill { letter-spacing: 0.12em; }
  }

  /* ─────────────── Reduced motion ─────────────── */

  @media (prefers-reduced-motion: reduce) {
    .exhibit__card,
    .exhibit__connector-path,
    .exhibit__connector-dot,
    .exhibit__pill {
      opacity: 1 !important;
      transform: translate(var(--tx, 0), var(--ty, 0)) rotate(var(--rot, 0deg)) !important;
      stroke-dashoffset: 0 !important;
      transition: none !important;
      animation: none !important;
    }
    .exhibit__connector-dot { opacity: 1 !important; }
    .exhibit__pill { transform: none !important; }
    .exhibit__orb { animation: none !important; box-shadow: none; }
  }
</style>
