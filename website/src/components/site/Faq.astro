---
// Faq.astro: native details/summary accordion (works without JS).
import type { Faq as FaqItem } from '../../data/faq';

interface Props {
  items: FaqItem[];
  index?: string;
  title?: string;
  id?: string;
}
const { items, index = '08', title = 'Questions we hear first.', id = 'faq' } = Astro.props;
---
<section class="section faq" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap faq__wrap">
    <header class="faq__head">
      <p class="eyebrow">{index} · FAQ</p>
      <h2 id={`${id}-title`} class="h2">{title}</h2>
      <p class="faq__more">Not here? <a href="mailto:ayush@kriseva.in">Ask the founder</a>, or read the <a href="/resources#glossary">glossary</a>.</p>
    </header>
    <div class="faq__list">
      {items.map((f, i) => (
        <details class="faq__item" open={i === 0}>
          <summary>
            <span class="faq__n mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="faq__q">{f.q}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <p class="faq__a">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__wrap {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .faq__head {
    display: grid;
    gap: 1.25rem;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .faq__more {
    color: var(--ink-3);
    font-size: var(--t-small);
  }

  .faq__more a {
    color: var(--ink);
  }

  .faq__item {
    border-top: 1px solid var(--line-strong);
  }

  .faq__item:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .faq__item summary {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) 24px;
    gap: 0.75rem;
    align-items: center;
    padding: 1.2rem 0;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__n {
    color: var(--brass-ink);
    font-size: 0.6875rem;
  }

  .faq__q {
    font-family: var(--f-serif);
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
    line-height: 1.3;
  }

  .faq__icon {
    position: relative;
    width: 24px;
    height: 24px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% 6px auto;
    height: 1.5px;
    background: currentcolor;
    transform: translateY(-50%);
    transition: transform 0.3s var(--ease);
  }

  .faq__icon::after {
    transform: translateY(-50%) rotate(90deg);
  }

  .faq__item[open] .faq__icon::after {
    transform: translateY(-50%) rotate(0deg);
  }

  .faq__a {
    padding: 0 2.5rem 1.4rem 3.15rem;
    color: var(--ink-2);
    max-width: 46rem;
  }

  @media (width <= 860px) {
    .faq__wrap {
      grid-template-columns: minmax(0, 1fr);
    }

    .faq__head {
      position: static;
    }

    .faq__a {
      padding-left: 0;
      padding-right: 0;
    }
  }
</style>
