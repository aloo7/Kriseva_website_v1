---
// Logo.astro: the Kriseva mark (from public/assets/brand/kriseva-mark.svg)
// plus wordmark, drawn in currentColor so it works on paper and navy.
interface Props {
  size?: number;
  wordmark?: boolean;
}
const { size = 30, wordmark = true } = Astro.props;
---
<span class="logo">
  <svg viewBox="20 18 140 136" width={size} height={size} aria-hidden="true">
    <rect x="26" y="42" width="128" height="8" rx="4" fill="currentColor" />
    <circle cx="90" cy="26" r="5.5" fill="var(--brass)" />
    <path d="M 48,50 L 64,50 L 64,142 Q 64,147 59,147 L 53,147 Q 48,147 48,142 Z" fill="currentColor" />
    <path d="M 64,98 L 64,84 Q 64,81 67,80 L 122,52 Q 128,49 131,54 L 136,62 Q 139,67 133,70 L 81,98 Z" fill="currentColor" />
    <path d="M 64,88 L 64,102 Q 64,105 67,106 L 122,134 Q 128,137 131,132 L 136,124 Q 139,119 133,116 L 81,88 Z" fill="currentColor" />
  </svg>
  {wordmark && <span class="logo__word">Kriseva</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .logo__word {
    font-family: var(--f-sans);
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    padding-left: 0.65rem;
    border-left: 1px solid currentcolor;
    border-color: color-mix(in srgb, currentcolor 35%, transparent);
    line-height: 1.6;
  }
</style>
