---
// VignetteDefence.astro: a defence MSME shop floor in section view. Sawtooth
// roof, overhead crane, a machining centre (A: what the shop can make), a
// parts rack and a bid desk with a stack of tender papers (B: what the tender
// asks). The dashed arc is the match TAS makes. A schematic, not a real site.
---
<svg viewBox="0 0 400 280" role="img" aria-label="Schematic of a defence MSME shop floor in section: a workshop with a sawtooth roof, an overhead crane, a machining centre marked A, a parts rack, and a desk with a stack of tender papers marked B. A dashed arc joins A to B.">
  <!-- Ground -->
  <path d="M8 232H392" stroke="#0a1f44" stroke-width="2" />
  <path d="M8 238H392" stroke="#0a1f44" stroke-opacity=".22" />

  <!-- Chimney, then building and roof -->
  <rect x="336" y="62" width="10" height="46" fill="#0a1f44" />
  <rect x="336" y="68" width="10" height="3" fill="#d2a660" />
  <circle class="puff" cx="341" cy="52" r="5" fill="none" stroke="#8c98ad" stroke-width="1.2" />
  <circle class="puff puff--2" cx="341" cy="52" r="5" fill="none" stroke="#8c98ad" stroke-width="1.2" />
  <rect x="30" y="112" width="340" height="120" fill="#fbf8f2" stroke="#0a1f44" stroke-width="1.8" />
  <path d="M30 112V88L98 112V88L166 112V88L234 112V88L302 112V88L370 112Z" fill="#0a1f44" />
  <path d="M30 88V112M98 88V112M166 88V112M234 88V112M302 88V112" stroke="#d2a660" stroke-width="3" />

  <!-- Overhead crane -->
  <path d="M38 132H362" stroke="#8c98ad" stroke-width="2" />
  <rect x="148" y="128" width="24" height="8" fill="#0a1f44" />
  <path d="M160 136V148" stroke="#0a1f44" stroke-width="1.6" />
  <path d="M160 148q0 8 -6 6" fill="none" stroke="#0a1f44" stroke-width="2" stroke-linecap="round" />

  <!-- Machining centre -->
  <rect x="48" y="172" width="106" height="60" fill="#ede6d7" stroke="#0a1f44" stroke-width="1.6" />
  <rect x="58" y="180" width="54" height="34" fill="#0a1f44" />
  <rect x="62" y="184" width="46" height="26" fill="#1b3869" />
  <path d="M62 210L84 184" stroke="#f5f0e6" stroke-opacity=".3" />
  <rect x="82" y="184" width="6" height="14" fill="#d2a660" />
  <path d="M85 198V204" stroke="#f5f0e6" stroke-width="1.6" />
  <rect x="120" y="180" width="28" height="42" fill="#fbf8f2" stroke="#0a1f44" stroke-width="1.2" />
  <rect x="124" y="185" width="20" height="11" fill="#0a1f44" />
  <path d="M127 190H141" stroke="#d2a660" stroke-width="1.4" />
  <circle cx="128" cy="205" r="2" fill="#b07f35" /><circle cx="136" cy="205" r="2" fill="#b07f35" /><circle cx="144" cy="205" r="2" fill="#a8322a" />
  <rect x="48" y="228" width="106" height="4" fill="#0a1f44" />

  <!-- Parts rack -->
  <path d="M178 150V232M254 150V232" stroke="#0a1f44" stroke-width="2.4" />
  <path d="M174 172H258M174 198H258M174 224H258" stroke="#0a1f44" stroke-width="2" />
  <g stroke="#0a1f44" stroke-width="1.1">
    <rect x="184" y="158" width="16" height="14" fill="#d2a660" /><rect x="206" y="162" width="12" height="10" fill="#ede6d7" /><rect x="224" y="156" width="22" height="16" fill="#d2a660" />
    <rect x="184" y="182" width="22" height="16" fill="#ede6d7" /><rect x="212" y="186" width="14" height="12" fill="#d2a660" /><rect x="232" y="180" width="16" height="18" fill="#ede6d7" />
    <rect x="184" y="208" width="30" height="16" fill="#d2a660" /><rect x="220" y="204" width="28" height="20" fill="#ede6d7" />
  </g>

  <!-- Bid desk -->
  <rect x="276" y="204" width="84" height="6" fill="#0a1f44" />
  <path d="M282 210V232M354 210V232" stroke="#0a1f44" stroke-width="3" />
  <rect x="292" y="172" width="38" height="26" fill="#0a1f44" />
  <rect x="296" y="176" width="30" height="18" fill="#1b3869" />
  <path d="M299 181H318M299 186H312M299 190H320" stroke="#d2a660" stroke-width="1.4" />
  <path d="M311 198V204M303 204H319" stroke="#0a1f44" stroke-width="2.4" />
  <g stroke="#0a1f44" stroke-width="1">
    <rect x="334" y="196" width="24" height="8" fill="#fcf9f2" />
    <rect x="336" y="190" width="24" height="6" fill="#fcf9f2" />
    <rect x="333" y="184" width="24" height="6" fill="#fcf9f2" />
  </g>
  <rect x="333" y="184" width="8" height="3" fill="#a8322a" />

  <!-- Callouts and the match -->
  <path d="M100 160V172" stroke="#0a1f44" stroke-width="1.2" />
  <circle cx="100" cy="150" r="10" fill="#0a1f44" />
  <text x="100" y="154.5" text-anchor="middle" class="dv-ltr">A</text>
  <path d="M346 166V184" stroke="#0a1f44" stroke-width="1.2" />
  <circle cx="346" cy="156" r="10" fill="#0a1f44" />
  <text x="346" y="160.5" text-anchor="middle" class="dv-ltr">B</text>
  <path class="match" d="M112 148Q226 92 334 148" fill="none" stroke="#b07f35" stroke-width="1.8" stroke-dasharray="5 5" />
  <path d="M327 143L335 149L325 152" fill="none" stroke="#b07f35" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />

  <!-- Dimension line -->
  <g stroke="#56627c" stroke-width="1" fill="none">
    <path d="M30 256H126M274 256H370M30 250V262M370 250V262" />
  </g>
  <text x="200" y="260" text-anchor="middle" class="dv-dim">SHOP FLOOR</text>
</svg>

<style>
  .dv-ltr {
    font-family: var(--f-mono);
    font-size: 12px;
    font-weight: 600;
    fill: #f5f0e6;
  }

  .dv-dim {
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    fill: #56627c;
  }

  .puff {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    animation: dv-puff 5s ease-out infinite;
  }

  .puff--2 {
    animation-delay: -2.5s;
  }

  .match {
    animation: dv-flow 1.6s linear infinite;
  }

  @keyframes dv-puff {
    0% { opacity: 0.8; transform: translateY(0) scale(0.6); }
    100% { opacity: 0; transform: translateY(-34px) scale(2); }
  }

  @keyframes dv-flow {
    to { stroke-dashoffset: -20; }
  }
</style>
