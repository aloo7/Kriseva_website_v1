---
// RouteMap.astro: the hero visual for /solutions. The bridge in miniature with
// four numbered entry points (two on the supplier shore, two on the buyer
// shore) and an HTML legend that doubles as in-page navigation. The numbers in
// the drawing match the legend, so the picture still reads at phone width where
// the in-drawing labels are hidden.

const routes = [
  { n: '1', id: 'defence-suppliers', name: 'Defence suppliers', product: 'TAS' },
  { n: '2', id: 'space-suppliers', name: 'Space suppliers', product: 'TAS' },
  { n: '3', id: 'evaluation-committees', name: 'Evaluation committees', product: 'Evaluator' },
  { n: '4', id: 'labs-and-psus', name: 'Labs and PSUs', product: 'Evaluator and TAS' },
];

// Main span: towers at x=243 and x=357, cable top y=92, deck y=214.
const main: { x: number; y: number }[] = [];
for (let x = 255; x <= 345; x += 10) {
  const t = (x - 243) / 114;
  main.push({ x, y: 92 + 352 * t * (1 - t) });
}
// Side spans: quadratic from the anchor to the tower top.
const side = (x0: number, c: number, x2: number, y0: number, y1: number) => {
  const pts: { x: number; y: number }[] = [];
  for (let t = 0.2; t < 0.95; t += 0.15) {
    const u = 1 - t;
    pts.push({ x: u * u * x0 + 2 * u * t * c + t * t * x2, y: u * u * y0 + 2 * u * t * 150 + t * t * y1 });
  }
  return pts;
};
const left = side(150, 193, 243, 214, 92);
const right = side(450, 407, 357, 214, 92);
const hangers = [...main, ...left, ...right];
---
<div class="rmap">
  <svg class="rmap__svg" viewBox="0 0 600 330" aria-hidden="true" focusable="false">
    <!-- River and shores -->
    <rect x="150" y="236" width="300" height="94" fill="#e2e8ef" />
    <path d="M150 238.5H450" stroke="#aebcce" stroke-width="1.5" />
    <g fill="none" stroke="#9eb0c6" stroke-width="1.5" stroke-linecap="round">
      <path d="M178 270q7 -4 14 0t14 0" /><path d="M300 292q7 -4 14 0t14 0" /><path d="M404 262q7 -4 14 0t14 0" /><path d="M236 310q7 -4 14 0t14 0" />
    </g>
    <path d="M0 220H152L146 232L156 262L146 330H0Z" fill="#0a1f44" />
    <path d="M600 220H448L454 232L444 262L454 330H600Z" fill="#0a1f44" />
    <path d="M0 220.5H150M450 220.5H600" stroke="#d2a660" stroke-opacity=".7" />

    <!-- Piers -->
    <rect x="236" y="238" width="14" height="92" fill="#7f90ab" fill-opacity=".45" />
    <rect x="350" y="238" width="14" height="92" fill="#7f90ab" fill-opacity=".45" />

    <!-- Cables and hangers -->
    <g fill="none" stroke="#0a1f44" stroke-linecap="round">
      <g stroke-width="1" stroke-opacity=".7">
        {hangers.map((h) => <path d={`M${h.x.toFixed(1)} ${h.y.toFixed(1)}V212`} />)}
      </g>
      <path d="M150 214Q193 150 243 92" stroke-width="3" />
      <path d="M243 92Q300 268 357 92" stroke-width="3" />
      <path d="M357 92Q407 150 450 214" stroke-width="3" />
    </g>

    <!-- Towers (TAS on the supplier side, Evaluator on the buyer side) -->
    <g fill="#0a1f44">
      <rect x="236" y="92" width="14" height="146" /><rect x="230" y="84" width="26" height="9" /><rect x="237" y="78" width="12" height="7" />
      <rect x="350" y="92" width="14" height="146" /><rect x="344" y="84" width="26" height="9" /><rect x="351" y="78" width="12" height="7" />
    </g>
    <g fill="#b07f35"><rect x="232" y="140" width="22" height="3" /><rect x="346" y="140" width="22" height="3" /></g>
    <text x="243" y="68" text-anchor="middle" class="rmap__plate">TAS</text>
    <text x="357" y="68" text-anchor="middle" class="rmap__plate">Evaluator</text>

    <!-- Deck with bids in transit -->
    <rect x="132" y="210" width="336" height="4" fill="#b07f35" />
    <rect x="132" y="214" width="336" height="10" fill="#0a1f44" />
    <g class="rmap__bids">
      <rect class="rmap__bid" x="206" y="198" width="14" height="12" fill="#fcf9f2" stroke="#0a1f44" stroke-width="1" />
      <rect class="rmap__bid rmap__bid--2" x="206" y="198" width="14" height="12" fill="#fcf9f2" stroke="#0a1f44" stroke-width="1" />
    </g>

    <!-- 1: defence supplier, a factory with a sawtooth roof -->
    <g>
      <path d="M26 220V194H92V220Z" fill="#0a1f44" />
      <path d="M26 194V178L48 194V178L70 194V178L92 194Z" fill="#0a1f44" />
      <path d="M26 178V194M48 178V194M70 178V194" stroke="#d2a660" stroke-width="2.5" />
      <rect x="34" y="202" width="8" height="7" fill="#f5f0e6" /><rect x="50" y="202" width="8" height="7" fill="#f5f0e6" /><rect x="72" y="204" width="12" height="16" fill="#d2a660" />
      <path d="M59 178V158" stroke="#0a1f44" stroke-width="2" />
    </g>
    <!-- 2: space supplier, a rocket on a short gantry -->
    <g>
      <rect x="100" y="216" width="40" height="4" fill="#0a1f44" />
      <path d="M106 216V176M112 216V176" stroke="#0a1f44" stroke-width="1.6" />
      <path d="M106 184L112 190M112 184L106 190M106 196L112 202M112 196L106 202M106 208L112 214M112 208L106 214" stroke="#0a1f44" stroke-width=".8" />
      <rect x="120" y="178" width="10" height="38" fill="#f8f4ec" stroke="#0a1f44" stroke-width="1.4" />
      <path d="M120 178L125 160L130 178Z" fill="#f8f4ec" stroke="#0a1f44" stroke-width="1.4" />
      <path d="M120 206L114 216H120ZM130 206L136 216H130Z" fill="#f8f4ec" stroke="#0a1f44" stroke-width="1.2" />
      <rect x="120" y="190" width="10" height="3" fill="#b07f35" />
    </g>
    <!-- 3: evaluation committee, a domed building -->
    <g>
      <rect x="462" y="206" width="56" height="14" fill="#9a4a35" />
      <rect x="468" y="184" width="44" height="22" fill="#f3ead8" stroke="#0a1f44" stroke-width="1.3" />
      <path d="M476 184A14 14 0 0 1 504 184Z" fill="#f3ead8" stroke="#0a1f44" stroke-width="1.3" />
      <rect x="474" y="176" width="32" height="8" fill="#f3ead8" stroke="#0a1f44" stroke-width="1.2" />
      <path d="M490 170V156" stroke="#0a1f44" stroke-width="1.4" /><rect x="490" y="156" width="12" height="3" fill="#ff9933" /><rect x="490" y="159" width="12" height="3" fill="#fff" stroke="#0a1f44" stroke-width=".3" /><rect x="490" y="162" width="12" height="3" fill="#138808" />
      <g fill="#0a1f44" fill-opacity=".8"><rect x="473" y="188" width="3" height="18" /><rect x="483" y="188" width="3" height="18" /><rect x="494" y="188" width="3" height="18" /><rect x="504" y="188" width="3" height="18" /></g>
    </g>
    <!-- 4: labs and PSUs, a plant with a stack and a lab block -->
    <g>
      <rect x="532" y="196" width="50" height="24" fill="#f3ead8" stroke="#0a1f44" stroke-width="1.3" />
      <path d="M532 196L544 186H582V196" fill="#f3ead8" stroke="#0a1f44" stroke-width="1.3" />
      <rect x="538" y="203" width="8" height="8" fill="#0a1f44" /><rect x="552" y="203" width="8" height="8" fill="#0a1f44" /><rect x="566" y="203" width="8" height="17" fill="#d2a660" />
      <rect x="568" y="160" width="8" height="28" fill="#0a1f44" /><rect x="566" y="156" width="12" height="5" fill="#0a1f44" /><rect x="568" y="166" width="8" height="3" fill="#b07f35" />
    </g>

    <!-- Entry points -->
    <g class="rmap__marks">
      <g>
        <path d="M59 148V158" stroke="#0a1f44" stroke-width="1.4" />
        <circle cx="59" cy="136" r="13" fill="#0a1f44" /><text x="59" y="141.5" text-anchor="middle" class="rmap__num">1</text>
        <text x="59" y="108" text-anchor="middle" class="rmap__lab"><tspan x="59">Defence</tspan><tspan x="59" dy="14">suppliers</tspan></text>
      </g>
      <g>
        <path d="M125 142V158" stroke="#0a1f44" stroke-width="1.4" />
        <circle cx="125" cy="130" r="13" fill="#0a1f44" /><text x="125" y="135.5" text-anchor="middle" class="rmap__num">2</text>
        <text x="125" y="102" text-anchor="middle" class="rmap__lab"><tspan x="125">Space</tspan><tspan x="125" dy="14">suppliers</tspan></text>
      </g>
      <g>
        <path d="M490 148V154" stroke="#0a1f44" stroke-width="1.4" />
        <circle cx="490" cy="136" r="13" fill="#0a1f44" /><text x="490" y="141.5" text-anchor="middle" class="rmap__num">3</text>
        <text x="490" y="108" text-anchor="middle" class="rmap__lab"><tspan x="490">Evaluation</tspan><tspan x="490" dy="14">committees</tspan></text>
      </g>
      <g>
        <path d="M558 143V186" stroke="#0a1f44" stroke-width="1.4" />
        <circle cx="558" cy="130" r="13" fill="#0a1f44" /><text x="558" y="135.5" text-anchor="middle" class="rmap__num">4</text>
        <text x="558" y="102" text-anchor="middle" class="rmap__lab"><tspan x="558">Labs and</tspan><tspan x="558" dy="14">PSUs</tspan></text>
      </g>
    </g>
  </svg>

  <ol class="rmap__legend" role="list" aria-label="Jump to your route">
    {routes.map((r) => (
      <li>
        <a class="rmap__item" href={`#${r.id}`}>
          <span class="rmap__n mono" aria-hidden="true">{r.n}</span>
          <span class="rmap__name">{r.name}</span>
          <span class="rmap__tag mono">{r.product}</span>
        </a>
      </li>
    ))}
  </ol>
</div>

<style>
  .rmap {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .rmap__svg {
    width: 100%;
    height: auto;
    background-color: var(--card);
    background-image:
      linear-gradient(rgb(10 31 68 / 5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(10 31 68 / 5%) 1px, transparent 1px);
    background-size: 24px 24px;
    border: 1px solid var(--line-strong);
  }

  .rmap__plate {
    font-family: var(--f-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    fill: #855a1a;
    text-transform: uppercase;
  }

  .rmap__num {
    font-family: var(--f-mono);
    font-size: 15px;
    font-weight: 600;
    fill: #f5f0e6;
  }

  .rmap__lab {
    font-family: var(--f-sans);
    font-size: 12.5px;
    font-weight: 500;
    fill: #0a1f44;
  }

  /* Bids travel the deck. Reduced motion stops this via the global rule. */
  .rmap__bid {
    animation: rmap-cross 9s linear infinite;
  }

  .rmap__bid--2 {
    animation-delay: -4.5s;
  }

  @keyframes rmap-cross {
    0% { transform: translateX(0); opacity: 0; }
    8% { opacity: 1; }
    92% { opacity: 1; }
    100% { transform: translateX(240px); opacity: 0; }
  }

  .rmap__legend {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .rmap__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas: 'n name' 'n tag';
    column-gap: 0.7rem;
    align-items: center;
    min-height: 56px;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--card);
    text-decoration: none;
    transition: background-color 0.3s, color 0.3s;
  }

  .rmap__item:hover,
  .rmap__item:focus-visible {
    background: var(--navy);
    color: var(--on-navy);
  }

  .rmap__n {
    grid-area: n;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--on-navy);
    font-size: 0.75rem;
  }

  .rmap__item:hover .rmap__n,
  .rmap__item:focus-visible .rmap__n {
    background: var(--brass-light);
    color: var(--navy);
  }

  .rmap__name {
    grid-area: name;
    font-family: var(--f-serif);
    font-size: 1rem;
    line-height: 1.2;
  }

  .rmap__tag {
    grid-area: tag;
    font-size: 0.625rem;
    color: var(--brass-ink);
  }

  .rmap__item:hover .rmap__tag,
  .rmap__item:focus-visible .rmap__tag {
    color: var(--brass-light);
  }

  @media (width <= 520px) {
    .rmap__lab {
      display: none;
    }

    .rmap__legend {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
