---
// PageHero.astro: shared hero for inner pages. Blueprint paper (or navy),
// breadcrumb, eyebrow, H1, lead, actions, and a visual slot on the right.
//
// <PageHero eyebrow="Products · For suppliers" title="..." lead="..." crumbs={[{name:'TAS', path:'/tas'}]}>
//   <Fragment slot="actions">...buttons...</Fragment>
//   <Fragment slot="visual">...svg...</Fragment>
// </PageHero>
interface Crumb {
  name: string;
  path: string;
}
interface Props {
  eyebrow: string;
  title: string;
  /** Word or phrase in the title to set in italic accent. */
  accent?: string;
  lead?: string;
  crumbs?: Crumb[];
  tone?: 'paper' | 'navy';
}
const { eyebrow, title, accent, lead, crumbs = [], tone = 'paper' } = Astro.props;
const hasVisual = Astro.slots.has('visual');
const parts = accent && title.includes(accent) ? title.split(accent) : [title];
---
<section class:list={['phero', `phero--${tone}`, { 'phero--split': hasVisual }]} aria-labelledby="page-title">
  <div class="wrap phero__grid">
    <div class="phero__copy">
      {crumbs.length > 0 && (
        <nav class="phero__crumbs mono" aria-label="Breadcrumb">
          <ol role="list">
            <li><a href="/">Home</a></li>
            {crumbs.map((c, i) => (
              <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</li>
            ))}
          </ol>
        </nav>
      )}
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="page-title" class="display phero__title">
        {parts.length === 2 ? (<>{parts[0]}<em>{accent}</em>{parts[1]}</>) : title}
      </h1>
      {lead && <p class="lead phero__lead">{lead}</p>}
      {Astro.slots.has('actions') && <div class="phero__actions"><slot name="actions" /></div>}
    </div>
    {hasVisual && <div class="phero__visual"><slot name="visual" /></div>}
  </div>
  <div class="wrap phero__dim" aria-hidden="true"><span></span></div>
</section>

<style>
  .phero {
    position: relative;
    padding-block: clamp(3rem, 2rem + 5vw, 6.5rem) clamp(2.5rem, 1.5rem + 4vw, 5rem);
    overflow: hidden;
  }

  .phero--paper {
    background-color: var(--paper);
    background-image:
      linear-gradient(rgb(10 31 68 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(10 31 68 / 4%) 1px, transparent 1px);
    background-size: 44px 44px;
    background-position: center top;
  }

  .phero--navy {
    background-color: var(--navy);
    background-image: repeating-linear-gradient(135deg, rgb(255 255 255 / 3.2%) 0 1px, transparent 1px 13px);
    color: var(--on-navy);
  }

  .phero__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .phero--split .phero__grid {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  }

  .phero__copy {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .phero__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.6875rem;
    color: var(--ink-3);
  }

  .phero--navy .phero__crumbs ol {
    color: var(--on-navy-2);
  }

  .phero__crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    opacity: 0.6;
  }

  .phero__crumbs a {
    text-decoration: none;
  }

  .phero__crumbs a:hover {
    text-decoration: underline;
  }

  .phero__title {
    max-width: 16em;
  }

  .phero--navy .phero__title :global(em) {
    color: var(--brass-light);
  }

  .phero__lead {
    max-width: 36rem;
  }

  .phero--navy .phero__lead {
    color: var(--on-navy-2);
  }

  .phero--navy .eyebrow {
    color: var(--brass-light);
  }

  .phero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }

  .phero__visual {
    min-width: 0;
  }

  .phero__dim {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .phero__dim span {
    display: block;
    height: 1px;
    background: currentcolor;
    opacity: 0.25;
    position: relative;
  }

  .phero__dim span::before,
  .phero__dim span::after {
    content: '';
    position: absolute;
    top: -6px;
    width: 1px;
    height: 13px;
    background: currentcolor;
  }

  .phero__dim span::before {
    left: 0;
  }

  .phero__dim span::after {
    right: 0;
  }

  @media (width <= 900px) {
    .phero--split .phero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
