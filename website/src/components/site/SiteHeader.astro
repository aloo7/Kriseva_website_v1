---
// SiteHeader.astro: fixed header with mega menus (desktop) and a full-screen
// sheet (mobile). Behaviour lives in src/scripts/site.ts (data-nav hooks).
import { nav, company } from '../../data/kriseva';
import Logo from './Logo.astro';

interface Props {
  tone?: 'paper' | 'navy';
  path: string;
  /** The page's first section sits under the header (it pads itself). */
  overlay?: boolean;
}
const { tone = 'paper', path, overlay = false } = Astro.props;
const isActive = (href?: string, items?: { href: string }[]) => {
  const hrefs = [href, ...(items ?? []).map((i) => i.href)].filter(Boolean) as string[];
  return hrefs.some((h) => h.split('#')[0] === path);
};
---
<header class="hdr" data-tone={tone} data-hdr>
  <div class="hdr__bar wrap">
    <a href="/" class="hdr__brand" aria-label="Kriseva home">
      <Logo />
    </a>

    <nav class="hdr__nav" aria-label="Primary">
      <ul role="list" class="hdr__list">
        {nav.map((g, i) => (
          <li class="hdr__item">
            {g.items ? (
              <button
                class:list={['hdr__link', { 'is-current': isActive(g.href, g.items) }]}
                type="button"
                aria-expanded="false"
                aria-controls={`mega-${i}`}
                data-mega-trigger={`mega-${i}`}
              >
                {g.label}
                <svg class="hdr__caret" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
              </button>
            ) : (
              <a href={g.href} class:list={['hdr__link', { 'is-current': isActive(g.href) }]} aria-current={isActive(g.href) ? 'page' : undefined}>{g.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__actions">
      <a class="hdr__mail" href={`mailto:${company.email}`} aria-label={`Email the founder at ${company.email}`} title={company.email}>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="1" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M3 5.5l7 5.5 7-5.5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      </a>
      <a class="btn hdr__cta" href="/contact?intent=demo">Book a demo</a>
      <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="sheet" data-sheet-trigger>
        <span class="sr-only">Menu</span>
        <span class="hdr__burger-lines" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  {nav.map((g, i) => g.items && (
    <div class="mega" id={`mega-${i}`} data-mega hidden>
      <div class="mega__inner wrap">
        <p class="mega__title mono">{g.label}</p>
        <ul role="list" class:list={['mega__links', { 'mega__links--two': g.items.length <= 2 }]}>
          {g.items.map((l) => (
            <li>
              <a href={l.href} class="mega__link">
                {l.tag && <span class="mega__tag mono">{l.tag}</span>}
                <span class="mega__label">{l.label}<span class="mega__arrow" aria-hidden="true">&rarr;</span></span>
                {l.note && <span class="mega__note">{l.note}</span>}
              </a>
            </li>
          ))}
        </ul>
        {g.feature && (
          <a class="mega__feature" href={g.feature.href}>
            <svg class="mega__bridge" viewBox="0 0 220 70" aria-hidden="true">
              <path d="M10 56 H210" stroke="currentColor" stroke-width="3" />
              <path d="M58 56 V10 M162 56 V10" stroke="currentColor" stroke-width="5" />
              <path d="M10 54 Q34 34 58 12 Q110 70 162 12 Q186 34 210 54" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
            <span class="mega__ftitle">{g.feature.title}</span>
            <span class="mega__fbody">{g.feature.body}</span>
            <span class="link-arrow">{g.feature.cta} <span aria-hidden="true">&rarr;</span></span>
          </a>
        )}
      </div>
    </div>
  ))}

  <div class="sheet" id="sheet" data-sheet hidden>
    <div class="sheet__inner wrap">
      {nav.map((g) => (
        <div class="sheet__group">
          {g.items ? (
            <details>
              <summary class="sheet__head">{g.label}<span aria-hidden="true">+</span></summary>
              <ul role="list">
                {g.items.map((l) => (
                  <li><a href={l.href} class="sheet__link">{l.label}{l.tag && <span class="mono"> · {l.tag}</span>}</a></li>
                ))}
              </ul>
            </details>
          ) : (
            <a class="sheet__head" href={g.href}>{g.label}<span aria-hidden="true">&rarr;</span></a>
          )}
        </div>
      ))}
      <div class="sheet__cta">
        <a class="btn" href="/contact?intent=demo">Book a demo</a>
        <a class="btn btn--ghost" href={`mailto:${company.email}`}>{company.email}</a>
      </div>
    </div>
  </div>
</header>
{!overlay && <div class="hdr-spacer" aria-hidden="true"></div>}

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--ink);
    transition: background-color 0.35s var(--ease), color 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }

  .hdr-spacer {
    height: var(--header-h);
  }

  .hdr[data-tone='navy'] + .hdr-spacer {
    background: var(--navy);
  }

  .hdr[data-tone='navy'] {
    color: var(--on-navy);
  }

  .hdr.is-solid,
  .hdr.is-open {
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 1px 0 var(--line);
  }

  .hdr__bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .hdr__brand {
    display: inline-flex;
    text-decoration: none;
    flex: none;
  }

  .hdr__nav {
    margin-inline: auto;
  }

  .hdr__list {
    display: flex;
    gap: 0.25rem;
  }

  .hdr__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.85rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius);
    position: relative;
  }

  .hdr__link::after {
    content: '';
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0.3rem;
    height: 1px;
    background: currentcolor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }

  .hdr__link:hover::after,
  .hdr__link[aria-expanded='true']::after,
  .hdr__link.is-current::after {
    transform: scaleX(1);
  }

  .hdr__caret {
    transition: transform 0.3s var(--ease);
  }

  .hdr__link[aria-expanded='true'] .hdr__caret {
    transform: rotate(180deg);
  }

  .hdr__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: none;
  }

  .hdr__mail {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid currentcolor;
    border-color: color-mix(in srgb, currentcolor 30%, transparent);
    border-radius: var(--radius);
  }

  .hdr__mail:hover {
    border-color: currentcolor;
  }

  .hdr[data-tone='navy']:not(.is-solid, .is-open) .hdr__cta {
    --btn-bg: var(--brass-light);
    --btn-fg: var(--navy);
    --btn-fill: var(--paper);
  }

  .hdr__burger {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
  }

  .hdr__burger-lines,
  .hdr__burger-lines::before,
  .hdr__burger-lines::after {
    display: block;
    width: 20px;
    height: 1.5px;
    background: currentcolor;
    transition: transform 0.3s var(--ease);
  }

  .hdr__burger-lines {
    position: relative;
  }

  .hdr__burger-lines::before,
  .hdr__burger-lines::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .hdr__burger-lines::before {
    top: -6px;
  }

  .hdr__burger-lines::after {
    top: 6px;
  }

  .hdr__burger[aria-expanded='true'] .hdr__burger-lines {
    background: transparent;
  }

  .hdr__burger[aria-expanded='true'] .hdr__burger-lines::before {
    transform: translateY(6px) rotate(45deg);
  }

  .hdr__burger[aria-expanded='true'] .hdr__burger-lines::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mega menu */
  .mega {
    position: absolute;
    inset: var(--header-h) 0 auto;
    background: var(--paper);
    color: var(--ink);
    border-top: 1px solid var(--line);
    box-shadow: 0 24px 48px -24px rgb(10 31 68 / 28%);
  }

  .mega__inner {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr) 20rem;
    gap: 2rem;
    padding-block: 2rem 2.4rem;
  }

  .mega__title {
    color: var(--brass-ink);
    padding-top: 0.4rem;
  }

  .mega__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem 1.5rem;
  }

  .mega__link {
    display: grid;
    gap: 0.2rem;
    padding: 0.9rem 1rem;
    text-decoration: none;
    border-radius: var(--radius);
    transition: background-color 0.25s var(--ease);
  }

  .mega__link:hover {
    background: var(--paper-2);
  }

  .mega__tag {
    color: var(--brass-ink);
    font-size: 0.6875rem;
  }

  .mega__label {
    font-family: var(--f-serif);
    font-size: 1.35rem;
    font-weight: 400;
    display: inline-flex;
    gap: 0.5rem;
    align-items: baseline;
  }

  .mega__arrow {
    font-family: var(--f-sans);
    font-size: 1rem;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.25s, transform 0.25s var(--ease);
  }

  .mega__link:hover .mega__arrow {
    opacity: 1;
    transform: none;
  }

  .mega__note {
    font-size: var(--t-small);
    color: var(--ink-3);
  }

  .mega__feature {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.25rem;
    background: var(--navy);
    color: var(--on-navy);
    text-decoration: none;
    border-radius: var(--radius);
  }

  .mega__bridge {
    width: 100%;
    color: var(--brass-light);
    margin-bottom: 0.5rem;
  }

  .mega__ftitle {
    font-family: var(--f-serif);
    font-size: 1.2rem;
  }

  .mega__fbody {
    font-size: var(--t-small);
    color: var(--on-navy-2);
  }

  .mega__feature .link-arrow {
    color: var(--brass-light);
    justify-self: start;
  }

  /* Mobile sheet */
  .sheet {
    position: fixed;
    inset: var(--header-h) 0 0;
    background: var(--paper);
    color: var(--ink);
    overflow-y: auto;
    border-top: 1px solid var(--line);
  }

  .sheet__inner {
    padding-block: 1rem 3rem;
  }

  .sheet__group {
    border-bottom: 1px solid var(--line);
  }

  .sheet__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem 0;
    font-family: var(--f-serif);
    font-size: 1.6rem;
    font-weight: 300;
    text-decoration: none;
    list-style: none;
    cursor: pointer;
  }

  .sheet__head::-webkit-details-marker {
    display: none;
  }

  .sheet__group ul {
    padding-bottom: 1rem;
  }

  .sheet__link {
    display: block;
    padding: 0.6rem 0;
    text-decoration: none;
  }

  .sheet__link .mono {
    color: var(--brass-ink);
  }

  .sheet__cta {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .sheet__cta .btn {
    justify-content: center;
  }

  @media (width <= 1080px) {
    .hdr__nav,
    .hdr__mail {
      display: none;
    }

    .hdr__burger {
      display: grid;
    }

    .hdr__bar {
      justify-content: space-between;
    }
  }

  @media (width <= 520px) {
    .hdr__cta {
      display: none;
    }
  }
</style>
