---
// Properties.astro: the four properties a buyer can test in their own room.
// Each carries a "How to test it in your room" line. No certificate stands in
// for any of them.

const props = [
  {
    n: '01',
    t: 'Offline',
    d: 'Both products run on your own machines with local models. Evaluator needs no network; TAS goes online only to read public portals, when you allow it.',
    test: 'Turn the Wi-Fi off and pull the network cable. Start Evaluator from cold and open a bid pack. It should start and run offline.',
    icon: '<rect x="-15" y="-13" width="30" height="10" rx="1"/><rect x="-15" y="1" width="30" height="10" rx="1"/><circle cx="9" cy="-8" r="1.4"/><circle cx="9" cy="6" r="1.4"/>',
  },
  {
    n: '02',
    t: 'Wi-Fi off, cold start',
    d: 'Evaluator, tested on 6 October 2026: a cold start with the Wi-Fi off, and zero application requests left the machine.',
    test: 'Run your own packet capture or firewall log during a cold start with the Wi-Fi off, and look for requests from the Kriseva processes. We recorded zero. Count for yourself.',
    icon: '<path d="M-15 -3a21 21 0 0 1 30 0M-10 3a14 14 0 0 1 20 0M-5 9a7 7 0 0 1 10 0"/><path d="M-14 -14L14 14"/>',
  },
  {
    n: '03',
    t: 'Tamper-evident record',
    d: 'Every finding and decision is written, in order, to a hash-chained record. One edit after the fact breaks the chain, visibly.',
    test: 'Run the chain check on a tender’s record. It walks the chain entry by entry and reports whether it holds. Ask us to show the same check failing after a deliberate edit on a test copy.',
    icon: '<rect x="-16" y="-6" width="16" height="12" rx="6"/><rect x="0" y="-6" width="16" height="12" rx="6"/>',
  },
  {
    n: '04',
    t: 'Officers decide',
    d: 'Evaluator proposes, with evidence. A named officer decides, and the reason is recorded with the decision.',
    test: 'Open the record for any finding. It shows what Kriseva proposed, which source page it came from, and the officer’s decision and reason, each as its own entry.',
    icon: '<circle cx="0" cy="-7" r="6"/><path d="M-12 14a12 12 0 0 1 24 0"/>',
  },
];
---
<section class="section props on-paper-2" id="properties" aria-labelledby="props-title">
  <div class="wrap">
    <header class="section-head section-head--split">
      <p class="eyebrow">02 · Four properties</p>
      <h2 id="props-title" class="h2">Each one you can <em>test in your room.</em></h2>
      <p class="lead">We hold no certificate to wave. Instead, each property comes with a test your own team can run, on your own machine, with the Wi-Fi off if you like.</p>
    </header>

    <ol role="list" class="props__grid rv-stagger" data-inview>
      {props.map((p) => (
        <li class="props__card">
          <div class="props__top">
            <svg class="props__seal" viewBox="-40 -40 80 80" aria-hidden="true" focusable="false">
              <circle r="37" class="props__ring" />
              <circle r="30" class="props__ring props__ring--in" />
              <g class="props__icon" set:html={p.icon} />
            </svg>
            <p class="props__n mono">Property {p.n}</p>
          </div>
          <h3 class="props__t">{p.t}</h3>
          <p class="props__d">{p.d}</p>
          <div class="props__test">
            <p class="props__tk mono">How to test it in your room</p>
            <p class="props__tt">{p.test}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .props__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.85rem, 1.8vw, 1.25rem);
  }

  .props__card {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    min-width: 0;
    padding: clamp(1.4rem, 1rem + 1.4vw, 2.2rem);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .props__top {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .props__seal {
    width: 64px;
    height: 64px;
    flex: none;
    overflow: visible;
  }

  .props__ring {
    fill: none;
    stroke: var(--brass);
    stroke-width: 1.3;
  }

  .props__ring--in {
    stroke-dasharray: 2 4;
    fill: rgb(176 127 53 / 8%);
  }

  .props__icon {
    fill: none;
    stroke: var(--navy);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .props__n {
    color: var(--brass-ink);
  }

  .props__t {
    font-family: var(--f-serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 1.2rem + 0.8vw, 1.9rem);
    line-height: 1.15;
  }

  .props__d {
    color: var(--ink-2);
    line-height: 1.6;
  }

  .props__test {
    margin-top: 0.5rem;
    padding: 1rem 1.15rem 1.1rem;
    background: var(--paper);
    border-left: 3px solid var(--brass);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .props__tk {
    margin-bottom: 0.4rem;
    color: var(--brass-ink);
  }

  .props__tt {
    font-size: var(--t-small);
    line-height: 1.6;
    color: var(--ink);
  }

  @media (width <= 860px) {
    .props__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
