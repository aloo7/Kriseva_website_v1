---
// BridgeHero.astro: the signature. Two shores, a river of paper, and a bridge
// that builds itself as the visitor scrolls (src/scripts/bridge.ts).
// Without JS or with reduced motion the finished bridge renders as drawn here:
// the composition of the Together 7.0 brief.
//
// Scene units: viewBox 0 60 1600 740. Ground at y=470, deck road at y=452,
// water surface at y=488. Towers at x=600 (TAS) and x=1000 (Evaluator).
import { stats } from '../../../data/stats';

const VB = { x: 0, y: 60, w: 1600, h: 740 };
const pos = (x: number, y: number) => `--x:${(((x - VB.x) / VB.w) * 100).toFixed(3)}%;--y:${(((y - VB.y) / VB.h) * 100).toFixed(3)}%`;

// Main span cable: M600,172 Q800,568 1000,172 (vertex y = 370).
const main = [] as { x: number; y: number }[];
for (let x = 616; x <= 984; x += 16) {
  const t = (x - 600) / 400;
  main.push({ x, y: 172 + 792 * t * (1 - t) });
}
// Side spans: M428,450 Q514,330 600,172 and its mirror.
const side = (x0: number, y0: number, y2: number) => (x: number) => {
  const t = (x - x0) / 172;
  return (1 - t) ** 2 * y0 + 2 * t * (1 - t) * 330 + t ** 2 * y2;
};
const leftY = side(428, 450, 172);
const rightY = side(1000, 172, 450);
const sideL = [] as { x: number; y: number }[];
for (let x = 444; x <= 588; x += 16) sideL.push({ x, y: leftY(x) });
const sideR = [] as { x: number; y: number }[];
for (let x = 1012; x <= 1156; x += 16) sideR.push({ x, y: rightY(x) });

// Build order for hangers: outward from each tower, so the deck "hangs" as
// the cables finish.
const hangers = [
  ...main.map((h) => ({ ...h, o: Math.min(Math.abs(h.x - 600), Math.abs(1000 - h.x)) / 200 })),
  ...sideL.map((h) => ({ ...h, o: (600 - h.x) / 172 })),
  ...sideR.map((h) => ({ ...h, o: (h.x - 1000) / 172 })),
];

const posts = [] as number[];
for (let x = 426; x <= 1176; x += 10) posts.push(x);
const trussL = [] as number[];
for (let x = 420; x < 800; x += 38) trussL.push(x);
const trussR = [] as number[];
for (let x = 800; x < 1180; x += 38) trussR.push(x);

const papers = [
  { x: 690, y: 590, r: -8, item: 'Rugged display unit', org: 'Defence buyer', due: '24-09' },
  { x: 802, y: 574, r: 3, item: 'Gaskets and O-rings', org: 'Defence buyer', due: '02-10' },
  { x: 914, y: 592, r: -3, item: 'S-band transponder', org: 'Space buyer', due: '28-09' },
];
const gates = [
  { x: 700, label: 'Answered' },
  { x: 800, label: 'Evidenced' },
  { x: 900, label: 'Decided' },
];
const waves = [
  [458, 520], [476, 602], [452, 684], [498, 752], [1118, 532], [1100, 626], [1126, 704], [1080, 770], [612, 778], [990, 760],
];
const beats = [
  { k: 'The gap', t: 'Tenders and bids cross on paper: hundreds of pages, read by hand on both sides.' },
  { k: 'The pillars', t: 'TAS stands with the supplier. Evaluator stands with the buyer.' },
  { k: 'The crossing', t: 'Every bid crosses with its evidence attached. Officers decide.' },
];
---
<section class="hero" data-bridge aria-labelledby="hero-title">
  <div class="hero__sticky">
    <div class="hero__text wrap">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow">Defence and space procurement · India</p>
        <h1 id="hero-title" class="display hero__title">
          <span class="hero__l1">India’s defence and space orders cross a gap made of <em>paper</em>.</span>
          <span class="hero__l2">Kriseva is the <span class="hero__bridge-word">bridge<span class="hero__underline" data-k="underline" aria-hidden="true"></span></span>.</span>
        </h1>
      </div>
      <div class="hero__side">
        <p class="hero__sub">
          <strong>TAS</strong> helps suppliers find, read and answer the tenders they can win.
          <strong>Evaluator</strong> helps government committees check every bid, with the page behind every finding.
          Both run on your premises.
        </p>
        <div class="hero__ctas">
          <a class="btn" href="/contact?intent=demo">Book a demo <span class="arrow" aria-hidden="true">&rarr;</span></a>
          <a class="btn btn--ghost" href="#pillars">See the two products</a>
        </div>
      </div>
    </div>

    <div class="hero__stage">
      <div class="hero__sky" aria-hidden="true"></div>
      <div class="hero__ground" aria-hidden="true"></div>

      <ol class="hero__beats" role="list" aria-label="How the bridge works">
        {beats.map((b, i) => (
          <li class="hero__beat" data-beat={i} data-active={i === 2 ? '' : undefined}>
            <span class="mono hero__beat-k"><span class="hero__beat-n">0{i + 1}</span> {b.k}</span>
            <span class="hero__beat-t">{b.t}</span>
          </li>
        ))}
      </ol>

      <div class="hero__scene">
        <svg class="bridge" viewBox={`${VB.x} ${VB.y} ${VB.w} ${VB.h}`} role="img" aria-labelledby="bridge-title bridge-desc" preserveAspectRatio="xMidYMax meet">
          <title id="bridge-title">The Kriseva bridge</title>
          <desc id="bridge-desc">On the left shore, defence and space suppliers: a factory, a drone, a satellite and a ground station. On the right shore, government buyers: a domed government building with the national flag, and a launch vehicle on its pad. Between them, bid documents float in a river of paper. A suspension bridge spans the river. Its left pillar is TAS, for bidders; its right pillar is Evaluator, for buyers; the deck is the Kriseva Evidence Engine, with three checkpoints: answered, evidenced, decided.</desc>
          <defs>
            <linearGradient id="k-water" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#e9eef4" />
              <stop offset="1" stop-color="#cdd7e3" />
            </linearGradient>
            <linearGradient id="k-pier" x1="0" y1="0" x2="0" y2="1">
