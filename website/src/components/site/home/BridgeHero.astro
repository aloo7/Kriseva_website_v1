            <!-- factory -->
            <path d="M200 470V420H316V470Z" fill="#0a1f44" />
            <path d="M200 421V397L229 409V397L258 409V397L287 409V397L316 409V421Z" fill="#0a1f44" />
            <path d="M200 397V409M229 397V409M258 397V409M287 397V409" stroke="#d2a660" stroke-width="3" />
            <rect x="304" y="372" width="8" height="30" fill="#0a1f44" />
            <rect x="212" y="432" width="12" height="11" fill="#f5f0e6" />
            <rect x="232" y="432" width="12" height="11" fill="#f5f0e6" />
            <rect x="252" y="432" width="12" height="11" fill="#f5f0e6" />
            <rect x="282" y="442" width="18" height="28" fill="#d2a660" />
            <!-- solar array with signal -->
            <rect x="335" y="414" width="5" height="56" fill="#0a1f44" />
            <g transform="rotate(-24 338 408)">
              <rect x="318" y="396" width="40" height="24" fill="#d2a660" stroke="#0a1f44" stroke-width="2" />
              <path d="M328 396V420M338 396V420M348 396V420M318 408H358" stroke="#0a1f44" stroke-width="1" />
            </g>
            <g class="radio" fill="none" stroke="#b07f35" stroke-width="2" stroke-linecap="round">
              <path d="M368 384q6 -8 2 -18" />
              <path d="M376 388q10 -12 3 -28" />
              <path d="M384 392q14 -17 4 -38" />
            </g>
            <!-- mobile ground station -->
            <rect x="358" y="444" width="38" height="20" rx="1" fill="#0a1f44" />
            <rect x="364" y="449" width="16" height="7" fill="#f5f0e6" />
            <path d="M396 450H408L414 457V464H396Z" fill="#0a1f44" />
            <rect x="399" y="452" width="7" height="5" fill="#f5f0e6" />
            <circle cx="368" cy="466" r="5" fill="#071530" stroke="#f5f0e6" stroke-width="1.5" />
            <circle cx="406" cy="466" r="5" fill="#071530" stroke="#f5f0e6" stroke-width="1.5" />
            <path d="M378 444V424" stroke="#0a1f44" stroke-width="2" />
            <path d="M370 424Q378 432 386 422" fill="none" stroke="#0a1f44" stroke-width="2.2" />
            <circle class="beacon" cx="378" cy="420" r="2.6" fill="#a8322a" />
          </g>

          <!-- Right shore: government buyers -->
          <g class="shore shore--r">
            <rect x="1190" y="452" width="156" height="18" fill="#9a4a35" />
            <rect x="1198" y="410" width="140" height="42" fill="#f3ead8" stroke="#0a1f44" stroke-width="1.6" />
            <rect x="1192" y="403" width="152" height="8" fill="#9a4a35" />
            <g fill="#0a1f44" fill-opacity=".85">
              <rect x="1207" y="414" width="4" height="38" /><rect x="1224" y="414" width="4" height="38" /><rect x="1241" y="414" width="4" height="38" />
              <rect x="1291" y="414" width="4" height="38" /><rect x="1308" y="414" width="4" height="38" /><rect x="1325" y="414" width="4" height="38" />
            </g>
            <path d="M1258 452V430Q1268 418 1278 430V452Z" fill="#0a1f44" />
            <rect x="1244" y="390" width="48" height="13" fill="#f3ead8" stroke="#0a1f44" stroke-width="1.6" />
            <path d="M1240 390A28 28 0 0 1 1296 390Z" fill="#f3ead8" stroke="#0a1f44" stroke-width="1.6" />
            <path d="M1254 390Q1258 372 1268 362M1282 390Q1278 372 1268 362" fill="none" stroke="#0a1f44" stroke-width="1" />
            <rect x="1250" y="386" width="36" height="4" fill="#9a4a35" />
            <g><rect x="1205" y="392" width="16" height="11" fill="#f3ead8" stroke="#0a1f44" stroke-width="1.3" /><path d="M1203 392A10 10 0 0 1 1223 392Z" fill="#f3ead8" stroke="#0a1f44" stroke-width="1.3" /></g>
            <g><rect x="1315" y="392" width="16" height="11" fill="#f3ead8" stroke="#0a1f44" stroke-width="1.3" /><path d="M1313 392A10 10 0 0 1 1333 392Z" fill="#f3ead8" stroke="#0a1f44" stroke-width="1.3" /></g>
            <path d="M1268 362V318" stroke="#0a1f44" stroke-width="1.8" />
