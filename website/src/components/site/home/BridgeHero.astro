---
import HomeNextStep from './HomeNextStep.astro';
import BridgeScene from './bridge/BridgeScene.astro';

const stages = [
  { name: 'The gap', title: 'Too much paper. Too little clarity.', text: 'Requirements, answers and evidence are scattered across hundreds of pages.' },
  { name: 'The bridge', title: 'Two products. One evidence trail.', text: 'TAS helps suppliers prepare. Evaluator helps committees review. Both run on your premises.' },
  { name: 'Your next step', title: 'Evidence crosses. People decide.', text: 'Choose your side of the bridge.' },
];
const views = [
  { id: 'overview', name: 'Overview' },
  { id: 'suppliers', name: 'Suppliers' },
  { id: 'bridge', name: 'The bridge' },
  { id: 'buyers', name: 'Buyers' },
];
---
<section class="hero" data-bridge data-quick-home data-stage="2" aria-labelledby="hero-title">
  <div class="hero__intro wrap">
    <div>
      <p class="eyebrow">Defence and space · India</p>
      <h1 id="hero-title" class="display" data-quick-copy>From paperwork<br /> <em>to proof.</em></h1>
    </div>
    <div class="hero__side">
      <p data-quick-copy>Kriseva is the bridge between defence and space suppliers and government procurement.</p>
      <div class="hero__ctas">
        <a class="btn" href="/contact?intent=demo">Book a demo <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </div>

  <div class="crossing wrap">
    <div class="crossing__frame">
      <div class="crossing__topline">
        <p class="mono"><span class="crossing__dot" aria-hidden="true"></span> The Kriseva crossing</p>
      <div class="crossing__playback" data-bridge-controls hidden>
        <button type="button" class="crossing__play" data-play-story aria-controls="bridge-canvas">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="m9 5 11 7-11 7Z" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          <span data-play-label>Play the story</span>
        </button>
        <div class="crossing__progress" aria-hidden="true"><span data-k="progress"></span></div>
        <span class="mono crossing__duration">12 SECONDS</span>
      </div>
      </div>
      <div class="crossing__canvas" id="bridge-canvas">
        <div class="crossing__grid" aria-hidden="true"></div>
        <BridgeScene />
        <span class="crossing__coordinate crossing__coordinate--l mono" aria-hidden="true">01 / SUPPLY</span>
        <span class="crossing__coordinate crossing__coordinate--r mono" aria-hidden="true">02 / PROCUREMENT</span>
      </div>
      <div class="crossing__toolbar" data-bridge-controls hidden>
        <div class="crossing__views" role="group" aria-label="Explore the illustration">
          {views.map((view, i) => <button type="button" class="crossing__view" data-view={view.id} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="bridge-canvas">{view.name}</button>)}
        </div>
        <button class="crossing__motion" type="button" data-motion-toggle aria-pressed="false">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M5 3v10M11 3v10" fill="none" stroke="currentColor" stroke-width="2" /></svg>
          <span data-motion-label>Pause motion</span>
        </button>
      </div>
      <p class="crossing__view-description" data-view-description hidden></p>
    </div>

    <div class="crossing__story">
      <div class="crossing__steps" role="group" aria-label="Choose a step in the story" data-bridge-controls hidden>
        {stages.map((stage, i) => (
          <button type="button" class="crossing__step" data-stage-button={i} aria-pressed={i === 2 ? 'true' : 'false'} aria-controls="bridge-story">
            <span class="crossing__step-num mono">0{i + 1}</span><span>{stage.name}</span><span class="crossing__step-arrow" aria-hidden="true">&rarr;</span>
          </button>
        ))}
      </div>
      <div class="crossing__explanation" id="bridge-story" aria-live="polite" aria-atomic="true">
        {stages.map((stage, i) => <div data-story={i} data-quick-copy hidden={i !== 2}><h2>{stage.title}</h2><p>{stage.text}</p></div>)}
      </div>

    </div>
  </div>

  <HomeNextStep />
</section>

<style>
  .hero { position: relative; background: var(--paper); padding-top: var(--header-h); }
  .hero__intro { display: grid; grid-template-columns: minmax(0, 2.35fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 7rem); align-items: end; padding-block: clamp(2.5rem, 5vw, 5rem) clamp(2rem, 3.4vw, 3.6rem); }
  .hero__intro .eyebrow { margin-bottom: 1.2rem; }
  .hero__intro h1 { font-size: clamp(2.25rem, 3.9vw, 4.5rem); line-height: 1.06; letter-spacing: -.035em; max-width: 17ch; }
  .hero__intro h1 em { color: var(--red); }
  .hero__word { text-decoration: underline; text-decoration-color: var(--brass); text-decoration-thickness: .07em; text-underline-offset: .1em; }
  .hero__side p { font-size: clamp(1rem, 1.15vw, 1.13rem); line-height: 1.65; color: var(--ink-2); }
  .hero__side strong { color: var(--navy); font-weight: 600; }
  .hero__ctas { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem 1.5rem; margin-top: 1.4rem; }
  .hero__product-link { display: inline-flex; gap: .75rem; align-items: center; min-height: 44px; font-size: .9rem; text-underline-offset: 5px; }
  .hero__product-link:hover { text-decoration: underline; }
  .crossing { padding-bottom: 3.5rem; }
  .crossing__frame { border: 1px solid var(--line); position: relative; background: #f8f5ee; scroll-margin-top: calc(var(--header-h) + 1rem); }
  .crossing__topline { flex-wrap: wrap; position: relative; min-height: 52px; padding: .65rem 1.3rem; display: flex; justify-content: space-between; align-items: center; gap: .5rem 1rem; border-bottom: 1px solid var(--line); }
  .crossing__topline > .mono { display: flex; align-items: center; gap: .65rem; font-size: .6875rem; color: var(--navy); }
  .crossing__dot { width: 6px; height: 6px; background: var(--brass-ink); border-radius: 50%; }
  .crossing__note { font-size: .75rem; color: var(--ink-3); }
  .crossing__canvas { position: relative; height: clamp(360px, 44vw, 670px); overflow: hidden; isolation: isolate; }
  .crossing__canvas :global(svg.bridge) { position: relative; z-index: 1; }
  .crossing__grid { position: absolute; inset: 0; background-image: linear-gradient(rgb(10 31 68 / 3.5%) 1px, transparent 1px), linear-gradient(90deg, rgb(10 31 68 / 3.5%) 1px, transparent 1px); background-size: 32px 32px; mask-image: linear-gradient(transparent, #000 18%, #000 85%, transparent); }
  .crossing__coordinate { position: absolute; top: 1.25rem; font-size: .5625rem; letter-spacing: .12em; color: var(--ink-3); z-index: 2; pointer-events: none; }
  .crossing__coordinate--l { left: 1.3rem; }
  .crossing__coordinate--r { right: 1.3rem; }
  .crossing__toolbar { display: flex; justify-content: space-between; align-items: center; gap: .5rem; padding: .65rem 1rem; background: var(--paper); border-top: 1px solid var(--line); }
  .crossing__views { display: flex; flex-wrap: wrap; gap: .25rem; }
  .crossing__view { border: 1px solid transparent; padding: .55rem .9rem; min-height: 44px; background: transparent; font-size: .8125rem; color: var(--ink-2); cursor: pointer; transition: background .2s, color .2s; }
  .crossing__view:hover { background: rgb(10 31 68 / 5%); color: var(--navy); }
  .crossing__view[aria-pressed="true"] { color: var(--paper); background: var(--navy); border-color: var(--navy); }
  .crossing__motion { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; padding: .5rem .6rem; min-height: 44px; border: 1px solid var(--line); background: transparent; color: var(--ink-2); font-size: .75rem; cursor: pointer; white-space: nowrap; }
  .crossing__motion:hover { background: rgb(10 31 68 / 5%); }
  .crossing__view-description { border-top: 1px solid var(--line); padding: .7rem 1.25rem; font-size: .8125rem; line-height: 1.5; color: var(--ink-2); }
  .crossing__story { display: grid; grid-template-columns: minmax(190px, 1fr) minmax(0, 2.6fr); gap: clamp(1.5rem, 3vw, 3rem); padding-top: 1.8rem; align-items: center; }
  .crossing__steps { display: grid; }
  .crossing__step { display: flex; gap: .7rem; align-items: center; text-align: left; width: 100%; min-height: 44px; border: 0; border-bottom: 1px solid var(--line); color: var(--ink-3); background: none; font-size: .875rem; padding: .5rem 0; cursor: pointer; }
  .crossing__step[aria-pressed="true"] { color: var(--navy); }
  .crossing__step-num { font-size: .625rem; color: var(--brass-ink); }
  .crossing__step-arrow { margin-left: auto; opacity: 0; }
  .crossing__step[aria-pressed="true"] .crossing__step-arrow, .crossing__step:hover .crossing__step-arrow { opacity: 1; }
  .crossing__explanation { min-height: 126px; }
  .crossing__explanation h2 { font-family: var(--f-serif); font-weight: 400; font-size: clamp(1.35rem, 1.8vw, 1.85rem); letter-spacing: -.02em; line-height: 1.2; margin-bottom: .6rem; }
  .crossing__explanation p { color: var(--ink-2); font-size: .9rem; line-height: 1.6; max-width: 57ch; }
  .crossing__playback { display: flex; gap: .8rem; align-items: center; padding-left: 0; }
  .crossing__play { display: flex; align-items: center; gap: .5rem; min-height: 44px; padding: .4rem 0; background: none; border: 0; color: var(--navy); font-size: .875rem; cursor: pointer; white-space: nowrap; }
  .crossing__play:hover { color: var(--brass-ink); }
  .crossing__progress { height: 2px; background: var(--line); position: absolute; bottom: 0; left: 0; right: 0; }
  .crossing__progress span { display: block; height: 100%; background: var(--brass-ink); transform: scaleX(1); transform-origin: left; }
  .crossing__duration { font-size: .5625rem; letter-spacing: .08em; color: var(--ink-3); }
  [hidden] { display: none !important; }
  .hero__scale { background: var(--navy); color: var(--on-navy); padding-block: 2.4rem; }
  .hero__scale-grid { display: grid; grid-template-columns: 1.2fr .85fr .65fr 1.3fr; gap: 2.5rem; align-items: start; }
  .hero__scale-intro > .mono { font-size: .625rem; color: var(--brass-light); }
  .hero__scale-intro p { font-size: .875rem; line-height: 1.5; margin-top: .75rem; }
  .hero__scale-intro a { display: inline-flex; min-height: 44px; align-items: center; gap: .5rem; font-size: .75rem; color: var(--brass-light); text-underline-offset: 4px; }
  .hero__scale-intro a:hover { text-decoration: underline; }
  .hero__stat-value { font-family: var(--f-serif); font-weight: 300; font-size: clamp(1.65rem, 2.65vw, 3rem); line-height: 1.1; letter-spacing: -.03em; }
  .hero__stat-label { font-size: .8125rem; line-height: 1.5; color: var(--on-navy-2); margin-top: .6rem; }
  .hero__stat-source { color: var(--brass-light); font-size: .5rem; line-height: 1.7; margin-top: .55rem; }
  @media (width >= 1800px) { .crossing__canvas { height: 670px; } }
  @media (width <= 1080px) {
    .hero__intro { grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); gap: 2rem; }
    .hero__intro h1 { font-size: clamp(2rem, 4.7vw, 3.5rem); }
    .crossing__story { grid-template-columns: 1fr 2fr; }


    .hero__scale-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
  }
  @media (width <= 700px) {
    .hero__intro { grid-template-columns: 1fr; gap: 1.25rem; padding-top: 2rem; padding-bottom: 1.75rem; }
    .hero__intro h1 { font-size: clamp(2.1rem, 7.8vw, 3.5rem); max-width: 19ch; }
    .hero__intro .eyebrow { font-size: .5625rem; letter-spacing: .12em; margin-bottom: 1rem; }
    .hero__side p { font-size: .9375rem; line-height: 1.5; }

    .hero__ctas { margin-top: 1rem; }
    .hero__ctas .btn { min-height: 48px; }
    .hero__product-link { font-size: .8125rem; }
    .crossing { padding-bottom: 2rem; }
    .crossing__topline { padding: .6rem .75rem; min-height: 44px; gap: .5rem; }
    .crossing__topline > .mono { font-size: .5625rem; letter-spacing: .08em; }
    .crossing__note { display: none; }
    .crossing__canvas { height: clamp(260px, 72vw, 400px); }
    .crossing__coordinate { display: none; }
    .crossing__toolbar { padding: .5rem; flex-wrap: wrap; }
    .crossing__views { flex: 1; flex-wrap: nowrap; width: 100%; }
    .crossing__view { flex: 1; padding: .5rem .45rem; font-size: .6875rem; white-space: nowrap; }
    .crossing__motion { margin-left: auto; min-height: 44px; font-size: .6875rem; }
    .crossing__view-description { padding: .65rem .75rem; font-size: .75rem; }
    .crossing__story { grid-template-columns: 1fr; gap: 1.2rem; padding-top: 1rem; }
    .crossing__steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6rem; }
    .crossing__step { flex-direction: column; gap: .3rem; align-items: flex-start; justify-content: flex-start; font-size: .75rem; padding-bottom: .7rem; }
    .crossing__step[aria-pressed="true"] { border-bottom-color: var(--brass-ink); }
    .crossing__step-arrow { display: none; }
    .crossing__explanation { min-height: 146px; }
    .crossing__explanation h2 { font-size: 1.5rem; }
    .crossing__explanation p { font-size: .875rem; }
    .crossing__playback { padding: 0; gap: .25rem; }
    .crossing__play { font-size: .6875rem; gap: .25rem; }
    .crossing__duration { display: none; }
    .hero__scale-grid { gap: 1.8rem 1.25rem; }
    .hero__scale-intro { grid-column: 1 / -1; }
    .hero__scale-intro p br { display: none; }
    .hero__stat:last-child { grid-column: 1 / -1; border-top: 1px solid rgb(245 240 230 / 15%); padding-top: 1.5rem; }
    .hero__stat-value { font-size: 2rem; }
  }
  @media (height <= 500px) and (width >= 701px) {
    .hero__intro { padding-top: 1.75rem; }
    .hero__intro h1 { font-size: 2.5rem; }
    .crossing__canvas { height: 400px; }
  }
  @media (prefers-reduced-motion: reduce) { .crossing__playback { display: none; } }

  /* Compact first pass: the complete story fits a short visit. */
  .hero__intro { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 2rem; padding-block: 1.6rem 1.4rem; }
  .hero__intro .eyebrow { margin-bottom: .65rem; }
  .hero__intro h1 { font-size: clamp(2.4rem, 4vw, 3.7rem); overflow-wrap: anywhere; line-height: .99; letter-spacing: -.035em; max-width: none; }
  .hero__side { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-start; gap: 1rem 1.4rem; }
  .hero__side p { max-width: 30ch; font-size: .9375rem; line-height: 1.5; }
  .hero__ctas { margin-top: 0; flex: none; }
  .crossing { padding-bottom: 0; }
  .crossing__topline { min-height: 46px; padding: .2rem 1rem; }
  .crossing__canvas { height: clamp(280px, 39vw, 440px); }
  .crossing__coordinate { display: none; }
  .crossing__toolbar { padding: .25rem .5rem; }
  .crossing__view { padding: .4rem .8rem; font-size: .75rem; }
  .crossing__motion { padding: .4rem .6rem; font-size: .6875rem; }
  .crossing__story { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem; padding-block: .9rem; }
  .crossing__steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; }
  .crossing__step { gap: .5rem; font-size: .8125rem; padding: .4rem 0; }
  .crossing__step[aria-pressed="true"] { border-bottom-color: var(--brass-ink); }
  .crossing__step-arrow { display: none; }
  .crossing__explanation { min-height: 68px; display: grid; align-items: center; }
  .crossing__explanation h2 { font-size: 1.3rem; margin-bottom: .2rem; }
  .crossing__explanation p { font-size: .8125rem; line-height: 1.5; }
  .crossing__play { font-size: .75rem; }
  @media (width <= 1100px) { .hero__side { display: grid; gap: .75rem; justify-content: start; } }
  @media (width <= 700px) {
    .hero__intro { grid-template-columns: 1fr; gap: .85rem; padding-block: 1.1rem; align-items: center; }
    .hero__intro h1 { font-size: clamp(2rem, 6.5vw, 2.6rem); }
    .hero__intro .eyebrow { font-size: .5rem; letter-spacing: .08em; margin-bottom: .6rem; }
    .hero__side { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 1rem; }
    .hero__side p { font-size: 1rem; }
    .hero__side .btn { padding: .65rem .8rem; }
    .crossing__topline { padding-inline: .7rem; }
    .crossing__topline > .mono { font-size: .5rem; letter-spacing: .08em; }
    .crossing__play { font-size: .625rem; gap: .25rem; }
    .crossing__canvas { height: clamp(200px, 55vw, 290px); }
    .crossing__toolbar { flex-wrap: wrap; padding: .35rem; gap: .25rem; }
    .crossing__views { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 4.25rem), 1fr)); flex: 1; width: 100%; }
    .crossing__view { padding: .4rem .35rem; font-size: .75rem; }
    .crossing__motion { font-size: .625rem; }
    .crossing__story { grid-template-columns: 1fr; gap: .65rem; padding-block: .6rem .85rem; }
    .crossing__steps { gap: .5rem; }
    .crossing__step { font-size: .75rem; gap: .2rem; justify-content: center; }
    .crossing__explanation { min-height: 70px; }
    .crossing__explanation h2 { font-size: 1.2rem; }
    .crossing__explanation p { font-size: 1rem; }
  }
  @media (width <= 380px) {
    .hero__intro { grid-template-columns: 1fr; gap: .75rem; }
    .hero__intro h1 { font-size: 2.15rem; }
    .hero__intro h1 br { display: none; }
    .hero__side { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .5rem; }
    .hero__side p { font-size: 1rem; }
  }
</style>
