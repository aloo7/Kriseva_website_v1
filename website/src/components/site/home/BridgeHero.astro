  </div>
</section>

<script is:inline>
  // Arm the build before first paint so the finished bridge never flashes.
  // If the module script has not taken over within 4 s, fall back to the
  // static drawing (fail open).
  (function () {
    var h = document.querySelector('[data-bridge]');
    if (!h || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    h.setAttribute('data-live', '');
    setTimeout(function () { if (!h.hasAttribute('data-ready')) h.removeAttribute('data-live'); }, 4000);
  })();
</script>

<!-- Small screens: the shore statistics as a grid below the bridge -->
