            <path d={`M420 468H800M420 486H800${trussL.map((x) => `M${x} 468L${x + 19} 486L${x + 38} 468`).join('')}`} stroke="#0a1f44" stroke-width="2" fill="none" />
          </g>
          <g class="deck deck--r" data-k="deck" data-side="r">
            <path d={`M800 438H1180${posts.filter((x) => x >= 800).map((x) => `M${x} 438V450`).join('')}`} stroke="#0a1f44" stroke-opacity=".55" stroke-width="1.2" />
            <rect x="800" y="450" width="380" height="4" fill="#b07f35" />
            <rect x="800" y="454" width="380" height="14" fill="#0a1f44" />
            <path d={`M800 468H1180M800 486H1180${trussR.map((x) => `M${x} 468L${x + 19} 486L${x + 38} 468`).join('')}`} stroke="#0a1f44" stroke-width="2" fill="none" />
          </g>
