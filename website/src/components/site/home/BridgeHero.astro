---
import HomeNextStep from './HomeNextStep.astro';
import BridgeScene from './bridge/BridgeScene.astro';

const stages = [
  { name: 'The gap', title: 'Too much paper. Too little clarity.', text: 'Requirements, answers and evidence are scattered across hundreds of pages.' },
  { name: 'The bridge', title: 'Two products. One evidence trail.', text: 'TAS helps suppliers prepare. Evaluator helps committees review. Both run on your premises.' },
  { name: 'Your next step', title: 'Evidence crosses. People decide.', text: 'Choose your side of the bridge.' },
];
const views = [
  { id: 'overview', name: 'Overview' },
  { id: 'suppliers', name: 'Suppliers' },
  { id: 'bridge', name: 'The bridge' },
  { id: 'buyers', name: 'Buyers' },
];
---
<section class="hero" data-bridge data-quick-home data-stage="2" data-camera="bridge" aria-labelledby="hero-title">
  <div class="hero__intro wrap">
    <div>
      <p class="eyebrow">Defence and space · India</p>
      <h1 id="hero-title" data-quick-copy>From paperwork<br /> <em>to proof.</em></h1>
    </div>
    <div class="hero__side">
      <p data-quick-copy>Kriseva is the bridge between defence and space suppliers and government procurement.</p>
      <div class="hero__ctas">
        <a class="btn" href="/contact?intent=demo">Book a demo <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </div>

  <div class="crossing wrap">
    <div class="crossing__frame">
      <div class="crossing__topline">
        <p class="mono"><span class="crossing__dot" aria-hidden="true"></span> The crossing</p>
      <div class="crossing__playback" data-bridge-controls hidden>
        <button type="button" class="crossing__play" data-play-story aria-controls="bridge-canvas">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="m9 5 11 7-11 7Z" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          <span data-play-label>Play the story</span>
        </button>
        <div class="crossing__progress" aria-hidden="true"><span data-k="progress"></span></div>
        <span class="mono crossing__duration">12 SECONDS</span>
      </div>
      </div>
      <div class="crossing__canvas" id="bridge-canvas">
        <div class="crossing__atmosphere" data-atmosphere aria-hidden="true"></div>
        <div class="crossing__grid" aria-hidden="true"></div>
        <BridgeScene />
        <span class="crossing__coordinate crossing__coordinate--l mono" aria-hidden="true">01 / SUPPLY</span>
        <span class="crossing__coordinate crossing__coordinate--r mono" aria-hidden="true">02 / PROCUREMENT</span>
      <div class="crossing__labels" aria-hidden="true">
          <span><span class="crossing__label-dot"></span><strong>TAS</strong><span>Suppliers</span></span>
          <span><span class="crossing__label-dot crossing__label-dot--buyer"></span><strong>Evaluator</strong><span>Buyers</span></span>
        </div>
      </div>
      <div class="crossing__toolbar" data-bridge-controls hidden>
        <div class="crossing__views" role="group" aria-label="Explore the illustration">
          {views.map((view) => <button type="button" class="crossing__view" data-view={view.id} aria-pressed={view.id === 'bridge' ? 'true' : 'false'} aria-controls="bridge-canvas">{view.name}</button>)}
        </div>
        <button class="crossing__motion" type="button" data-motion-toggle aria-pressed="false">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M5 3v10M11 3v10" fill="none" stroke="currentColor" stroke-width="2" /></svg>
          <span data-motion-label>Pause motion</span>
        </button>
      </div>
      <p class="crossing__view-description" data-view-description hidden></p>
    </div>

    <div class="crossing__story">
      <div class="crossing__steps" role="group" aria-label="Choose a step in the story" data-bridge-controls hidden>
        {stages.map((stage, i) => (
          <button type="button" class="crossing__step" data-stage-button={i} aria-pressed={i === 2 ? 'true' : 'false'} aria-controls="bridge-story">
            <span class="crossing__step-num mono">0{i + 1}</span><span>{stage.name}</span><span class="crossing__step-arrow" aria-hidden="true">&rarr;</span>
          </button>
        ))}
      </div>
      <div class="crossing__explanation" id="bridge-story" aria-live="polite" aria-atomic="true">
        {stages.map((stage, i) => <div data-story={i} data-quick-copy hidden={i !== 2}><h2>{stage.title}</h2><p>{stage.text}</p></div>)}
      </div>

    </div>
  </div>

  <HomeNextStep />
</section>

<style>
  .hero { position: relative; background: var(--paper); padding-top: var(--header-h); }
  .hero .wrap { padding-inline: var(--home-gutter, var(--gutter)); }
  .hero__intro { display: grid; grid-template-columns: var(--home-columns, minmax(0, 1.2fr) minmax(0, .8fr)); align-items: end; gap: 2rem; padding-block: 2.5rem 2rem; }
  .hero__intro .eyebrow { font-size: .6875rem; letter-spacing: .1em; color: #536681; margin-bottom: .9rem; }
  .hero__intro h1 { font-family: var(--f-sans); font-size: clamp(3rem, 5.5vw, 5.25rem); font-weight: 500; line-height: .98; letter-spacing: -.065em; overflow-wrap: anywhere; }
  .hero__intro h1 em { color: #2c61ac; font-style: normal; }
  .hero__side { display: grid; justify-items: start; gap: 1.1rem; padding-bottom: .1rem; }
  .hero__side p { max-width: 36ch; font-size: 1.0625rem; line-height: 1.5; color: var(--ink-2); }
  .hero__ctas .btn { min-height: 48px; border-radius: 999px; font-family: var(--f-sans); font-size: .875rem; letter-spacing: 0; text-transform: none; padding: .75rem 1.25rem; }
  .crossing__frame { position: relative; overflow: hidden; border: 1px solid #d5deeb; border-radius: 22px; background: #f0f5fb; box-shadow: 0 14px 40px -28px rgb(10 31 68 / 35%); scroll-margin-top: calc(var(--header-h) + .75rem); }
  .crossing__topline { position: relative; display: flex; align-items: center; justify-content: space-between; gap: .5rem; flex-wrap: wrap; min-height: 56px; padding: .35rem 1.25rem; z-index: 3; }
  .crossing__topline > .mono { display: flex; align-items: center; gap: .6rem; font-family: var(--f-sans); font-size: .8125rem; letter-spacing: 0; text-transform: none; font-weight: 500; }
  .crossing__dot { width: 6px; height: 6px; border-radius: 50%; background: #2c61ac; box-shadow: 0 0 0 4px rgb(44 97 172 / 8%); }
  .crossing__playback { display: flex; align-items: center; gap: .65rem; }
  .crossing__play { display: inline-flex; align-items: center; gap: .5rem; min-height: 48px; font-size: .8125rem; padding: .25rem .15rem; color: #204d8a; }
  .crossing__play:hover { color: var(--navy); }
  .crossing__duration { font-size: .625rem; color: #586d8b; letter-spacing: 0; }
  .crossing__progress { height: 2px; background: #d9e4f2; position: absolute; bottom: 0; inset-inline: 1.25rem; }
  .crossing__progress span { display: block; height: 100%; background: #2c61ac; transform: scaleX(1); transform-origin: left; }
  .crossing__canvas { position: relative; height: clamp(20rem, 39vw, 29rem); overflow: hidden; isolation: isolate; }
  .crossing__canvas :global(svg.bridge) { position: relative; z-index: 1; }
  .crossing__atmosphere { position: absolute; inset: 0; background: radial-gradient(ellipse at 40% 20%, #dbeaff, transparent 65%), linear-gradient(135deg, #f3f7fc, #e5edf8); opacity: .65; }
  .crossing__atmosphere :global(canvas) { width: 100%; height: 100%; opacity: .75; }
  .crossing__grid { position: absolute; inset: 0; background-image: radial-gradient(#87a0c3 0.65px, transparent 0.65px); background-size: 24px 24px; opacity: .15; mask-image: linear-gradient(transparent, #000 35%, transparent); }
  .crossing__coordinate { display: none; }
  .crossing__labels { position: absolute; bottom: 1rem; inset-inline: 1rem; z-index: 2; display: flex; flex-wrap: wrap; justify-content: center; gap: .65rem; pointer-events: none; }
  .crossing__labels > span { display: inline-flex; align-items: center; gap: .4rem; padding: .45rem .75rem; background: rgb(255 255 255 / 94%); border: 1px solid #d9e2ee; border-radius: 999px; color: #445c7c; font-size: .8125rem; box-shadow: 0 3px 12px rgb(10 31 68 / 4%); }
  .crossing__labels strong { color: var(--navy); font-weight: 600; }
  .crossing__label-dot { width: 5px; height: 5px; border-radius: 50%; background: #315f9e; }
  .crossing__label-dot--buyer { background: #95722c; }
  .crossing__toolbar { display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding: .5rem .75rem; background: #fff; border-top: 1px solid #dbe3ef; }
  .crossing__views { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 4rem), 1fr)); gap: .25rem; flex: 1; max-width: 32rem; }
  .crossing__view { min-height: 48px; font-size: .875rem; line-height: 1.2; padding: .5rem .65rem; color: #526580; border-radius: 10px; transition: background .2s, color .2s; }
  .crossing__view:hover { background: #f0f4fa; color: var(--navy); }
  .crossing__view[aria-pressed="true"] { background: #e8effa; color: #1c4e90; font-weight: 600; }
  .crossing__motion { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; min-height: 48px; padding: .5rem .7rem; font-size: .8125rem; color: #526580; border-radius: 10px; }
  .crossing__motion:hover { background: #f0f4fa; }
  .crossing__view-description { padding: .75rem 1.25rem; border-top: 1px solid #dbe3ef; background: #fff; font-size: 1rem; line-height: 1.5; color: var(--ink-2); }
  .crossing__story { display: grid; grid-template-columns: var(--home-columns, minmax(0, 1fr) minmax(0, 1.1fr)); align-items: center; gap: 2rem; padding-block: 1.4rem; }
  .crossing__steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .5rem; }
  .crossing__step { display: flex; align-items: center; gap: .45rem; min-height: 48px; padding: .5rem .7rem; font-size: .8125rem; line-height: 1.2; color: #5a6d87; border-radius: 12px; text-align: left; transition: background .2s, color .2s; }
  .crossing__step-num { display: grid; place-items: center; width: 1.5rem; min-width: 1.5rem; height: 1.5rem; background: #e4eaf3; color: #4b6488; font-family: var(--f-sans); font-size: .6875rem; letter-spacing: 0; border-radius: 50%; }
  .crossing__step[aria-pressed="true"] { background: #e7eef9; color: #173e76; }
  .crossing__step[aria-pressed="true"] .crossing__step-num { background: #204e91; color: #fff; }
  .crossing__step:hover { color: #173e76; }
  .crossing__step-arrow { display: none; }
  .crossing__explanation { min-height: 80px; display: grid; align-items: center; }
  .crossing__explanation h2 { font-family: var(--f-sans); font-weight: 500; font-size: 1.4rem; line-height: 1.2; letter-spacing: -.035em; margin-bottom: .35rem; }
  .crossing__explanation p { font-size: 1rem; line-height: 1.5; color: var(--ink-2); max-width: 48ch; }
  [hidden] { display: none !important; }
  :global([data-bridge][data-paused] *) { animation-play-state: paused !important; transition: none !important; }
  @media (width <= 700px) {
    .hero__intro { grid-template-columns: 1fr; gap: 1.2rem; padding-block: 1.8rem 1.5rem; }
    .hero__intro h1 { font-size: clamp(2.8rem, 12.5vw, 4rem); }
    .hero__intro .eyebrow { font-size: .625rem; }
    .hero__side { gap: .9rem; }
    .hero__side p { font-size: 1rem; max-width: 36ch; }
    .hero__ctas .btn { min-height: 48px; }
    .crossing__frame { border-radius: 18px; }
    .crossing__canvas { height: 18.5rem; }
    .crossing__topline { padding-inline: .85rem; min-height: 54px; }
    .crossing__topline > .mono { font-size: .75rem; }
    .crossing__play { font-size: .75rem; }
    .crossing__duration { display: none; }
    .crossing__labels { bottom: .75rem; inset-inline: .5rem; gap: .35rem; }
    .crossing__labels > span { padding: .45rem .6rem; font-size: .875rem; }
    .crossing__label-dot { display: none; }
    .crossing__toolbar { flex-wrap: wrap; gap: .1rem; padding: .35rem; }
    .crossing__views { flex-basis: 100%; width: 100%; max-width: none; min-width: 0; }
    .crossing__view { padding: .5rem .2rem; font-size: .875rem; }
    .crossing__motion { min-height: 48px; font-size: .75rem; margin-left: auto; padding: .4rem .6rem; }
    .crossing__story { grid-template-columns: 1fr; gap: .9rem; padding-block: 1rem 1.2rem; }
    .crossing__steps { gap: .25rem; }
    .crossing__step { padding: .4rem .35rem; gap: .3rem; font-size: .75rem; }
    .crossing__step-num { width: 1.3rem; min-width: 1.3rem; height: 1.3rem; font-size: .625rem; }
    .crossing__explanation { min-height: 78px; }
    .crossing__explanation h2 { font-size: 1.35rem; }
  }
  :global(html[data-phone-layout]) .hero__intro { grid-template-columns: 1fr; gap: 1.2rem; padding-block: 1.8rem 1.5rem; }
  :global(html[data-phone-layout]) .hero__intro h1 { font-size: 3rem; }
  :global(html[data-phone-layout]) .hero__side { justify-items: start; }
  :global(html[data-phone-layout]) .crossing__canvas { height: 18.5rem; }
  :global(html[data-phone-layout]) .crossing__story { grid-template-columns: 1fr; gap: .9rem; }
  :global(html[data-phone-layout]) .crossing__toolbar { flex-wrap: wrap; }
  :global(html[data-phone-layout]) .crossing__views { flex-basis: 100%; width: 100%; max-width: none; min-width: 0; }
  :global(html[data-phone-layout]) .crossing__duration { display: none; }
  @media (height <= 500px) and (width >= 701px) {
    .hero__intro { padding-block: 1.4rem; }
    .hero__intro h1 { font-size: 3rem; }
    .crossing__canvas { height: 19rem; }
  }
  @media (width <= 380px) {
    .hero__intro { padding-block: 1.25rem 1rem; }
    .hero__intro h1 { font-size: 2.45rem; }
    .crossing__canvas { height: 16rem; }
    .crossing__topline { padding-inline: .75rem; }
  }
  @media (prefers-reduced-motion: reduce) { .crossing__playback { display: none; } :global([data-bridge] *) { transition: none !important; } }
</style>
