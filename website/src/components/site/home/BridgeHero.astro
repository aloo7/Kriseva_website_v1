      <div class:list={['hero-stats__item', { 'hero-stats__item--dup': s.id === 'defenceMsmes' || s.id === 'domesticCapital' }]}>
        <p class="hero-stats__v">{'prefix' in s && s.prefix}{s.value}</p>
        <p class="hero-stats__l">{s.label}</p>
        <p class="mono hero-stats__src">{s.source}</p>
      </div>
    ))}
  </div>
</section>

