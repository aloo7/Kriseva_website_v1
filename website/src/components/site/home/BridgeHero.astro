            <rect x="1350" y="462" width="86" height="8" fill="#0a1f44" />
            <path d="M1398 462V316M1414 462V316" stroke="#0a1f44" stroke-width="2.4" />
            <path d="M1398 328L1414 344M1414 328L1398 344M1398 352L1414 368M1414 352L1398 368M1398 376L1414 392M1414 376L1398 392M1398 400L1414 416M1414 400L1398 416M1398 424L1414 440M1414 424L1398 440M1398 448L1414 462M1414 448L1398 462" stroke="#0a1f44" stroke-width="1" />
            <path d="M1394 316H1418" stroke="#0a1f44" stroke-width="3" />
            <path d="M1385 372H1398M1385 408H1398" stroke="#0a1f44" stroke-width="2" />
            <circle class="beacon beacon--2" cx="1406" cy="311" r="2.6" fill="#a8322a" />
            <rect x="1371" y="360" width="15" height="102" fill="#f8f4ec" stroke="#0a1f44" stroke-width="1.6" />
            <path d="M1371 360L1378.5 332L1386 360Z" fill="#f8f4ec" stroke="#0a1f44" stroke-width="1.6" />
            <rect x="1371" y="376" width="15" height="6" fill="#0a1f44" />
            <rect x="1371" y="428" width="15" height="5" fill="#b07f35" />
            <path d="M1364 462V426L1367.5 414L1371 426V462ZM1386 462V426L1389.5 414L1393 426V462Z" fill="#f8f4ec" stroke="#0a1f44" stroke-width="1.4" />
            <!-- radar -->
            <rect x="1466" y="448" width="10" height="22" fill="#0a1f44" />
            <path d="M1458 470H1484" stroke="#0a1f44" stroke-width="3" />
            <g class="radar"><path d="M1452 432Q1471 452 1490 432" fill="none" stroke="#0a1f44" stroke-width="3" /><path d="M1471 444V448" stroke="#0a1f44" stroke-width="2" /></g>
          </g>

          <!-- Cables and hangers -->
          <g class="cables" fill="none" stroke="#0a1f44" stroke-linecap="round">
            <g stroke-width="1.2" stroke-opacity=".75">
              {hangers.map((h) => (
                <path class="hanger" data-k="hanger" data-o={h.o.toFixed(3)} d={`M${h.x} ${h.y.toFixed(1)}V451`} />
              ))}
            </g>
            <path class="cable" data-k="cable" data-s="0.28" data-e="0.44" pathLength="1" d="M600 172Q514 330 428 450" stroke-width="4.5" />
            <path class="cable" data-k="cable" data-s="0.29" data-e="0.48" pathLength="1" d="M600 172Q700 370 800 370" stroke-width="4.5" />
            <path class="cable" data-k="cable" data-s="0.29" data-e="0.48" pathLength="1" d="M1000 172Q900 370 800 370" stroke-width="4.5" />
            <path class="cable" data-k="cable" data-s="0.28" data-e="0.44" pathLength="1" d="M1000 172Q1086 330 1172 450" stroke-width="4.5" />
          </g>

          <!-- Towers (clipped at the water surface so they rise out of the river) -->
          <g clip-path="url(#k-above)">
          <g class="tower" data-k="tower" data-s="0.04" data-e="0.26">
            <rect x="587" y="174" width="26" height="314" fill="#0a1f44" />
            <rect x="593" y="174" width="5" height="314" fill="#1d3a6e" />
            <rect x="579" y="160" width="42" height="14" fill="#0a1f44" />
            <rect x="590" y="151" width="20" height="9" fill="#0a1f44" />
            <rect x="583" y="248" width="34" height="5" fill="#b07f35" />
            <rect x="583" y="332" width="34" height="5" fill="#b07f35" />
          </g>
          <g class="tower" data-k="tower" data-s="0.08" data-e="0.30">
            <rect x="987" y="174" width="26" height="314" fill="#0a1f44" />
            <rect x="993" y="174" width="5" height="314" fill="#1d3a6e" />
            <rect x="979" y="160" width="42" height="14" fill="#0a1f44" />
            <rect x="990" y="151" width="20" height="9" fill="#0a1f44" />
            <rect x="983" y="248" width="34" height="5" fill="#b07f35" />
            <rect x="983" y="332" width="34" height="5" fill="#b07f35" />
          </g>
          </g>

          <!-- Deck: two halves that meet in the middle -->
          <g class="deck deck--l" data-k="deck" data-side="l">
            <path d={`M420 438H800${posts.filter((x) => x < 800).map((x) => `M${x} 438V450`).join('')}`} stroke="#0a1f44" stroke-opacity=".55" stroke-width="1.2" />
            <rect x="420" y="450" width="380" height="4" fill="#b07f35" />
