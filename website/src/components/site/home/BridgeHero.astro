              <stop offset="1" stop-color="#7f90ab" stop-opacity=".25" />
            </linearGradient>
            <clipPath id="k-above"><rect x="0" y="0" width="1600" height="488" /></clipPath>
            <pattern id="k-grid" width="12" height="12" patternUnits="userSpaceOnUse">
              <path d="M12 0H0V12" fill="none" stroke="#0a1f44" stroke-width=".9" />
            </pattern>
          </defs>

          <!-- River (the gap) -->
          <rect x="420" y="486" width="760" height="314" fill="url(#k-water)" />
          <path d="M420 488.5H1180" stroke="#aebcce" stroke-width="1.5" />
          <g class="waves" fill="none" stroke="#9eb0c6" stroke-width="1.6" stroke-linecap="round">
            {waves.map(([x, y]) => <path d={`M${x} ${y}q7 -4 14 0t14 0`} />)}
          </g>

          <!-- Submerged piers -->
          <g class="piers">
            <rect x="588" y="488" width="24" height="292" fill="url(#k-pier)" />
            <rect x="568" y="770" width="64" height="16" fill="#8494ad" fill-opacity=".45" />
            <rect x="988" y="488" width="24" height="292" fill="url(#k-pier)" />
            <rect x="968" y="770" width="64" height="16" fill="#8494ad" fill-opacity=".45" />
          </g>

          <!-- Paper in the river: specimen bid documents, not real tenders -->
          {papers.map((p, i) => (
            <g class="paper" data-k="paper" data-i={i} data-x={p.x} data-y={p.y} data-r={p.r} transform={`translate(${p.x} ${p.y}) rotate(${p.r})`}>
              <rect x="-64" y="-76" width="128" height="152" fill="#fcf9f2" stroke="#cdbf9f" />
              <rect x="-64" y="-76" width="128" height="17" fill="#0a1f44" />
              <text x="-57" y="-64" class="pt pt--hd">GeM · BID DOCUMENT</text>
              <text x="-57" y="-47" class="pt pt--deva">बिड दस्तावेज़ / Bid Details</text>
              <text x="-57" y="-31" class="pt pt--id">SPECIMEN · NOT A REAL BID</text>
              <text x="-57" y="-16" class="pt"><tspan class="pt--k">Org</tspan>  {p.org}</text>
              <text x="-57" y="-4" class="pt"><tspan class="pt--k">Item</tspan>  {p.item}</text>
              <text x="-57" y="8" class="pt"><tspan class="pt--k">Closes</tspan>  {p.due}</text>
              <g stroke="#dccca8" stroke-width="2">
                <path d="M-56 22H52M-56 31H40M-56 40H48M-56 49H30M-56 58H44" />
              </g>
            </g>
