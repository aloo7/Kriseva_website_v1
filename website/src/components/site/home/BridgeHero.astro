              <rect x="1269" y="325" width="30" height="7" fill="#ffffff" />
              <rect x="1269" y="332" width="30" height="7" fill="#138808" />
              <circle cx="1284" cy="328.5" r="2.6" fill="none" stroke="#0a1f44" stroke-width=".9" />
