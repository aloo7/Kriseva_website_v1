            </div>
          </dl>
        </div>
        <div class="shore-stats shore-stats--r" style={pos(1564, 494)}>
          <p class="shore-stats__who">Government buyers</p>
          <p class="shore-stats__what">committees who must defend every award</p>
          <dl>
            <div class="sstat">
              <dt class="sstat__v">{stats.domesticCapital.value}</dt>
              <dd class="sstat__l">{stats.domesticCapital.label}<span class="sstat__src">{stats.domesticCapital.source}</span></dd>
            </div>
            <div class="sstat sstat--2">
              <dt class="sstat__v">{stats.spaceBudget.value}</dt>
              <dd class="sstat__l">{stats.spaceBudget.label}<span class="sstat__src">{stats.spaceBudget.source}</span></dd>
