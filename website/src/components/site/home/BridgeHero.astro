          <path class="gate-line" data-k="gateline" d="M958 425L966 431L958 437" fill="none" stroke="#b07f35" stroke-width="2" />
          {gates.map((g, i) => (
            <g class="gate" data-k="gate" data-gx={g.x} data-i={i}>
              <rect x={g.x - 13} y="417" width="26" height="25" fill="#0a1f44" />
