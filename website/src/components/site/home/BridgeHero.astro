          <rect class="anchor" x="1170" y="444" width="22" height="26" fill="#0a1f44" />

          <!-- Engine plate -->
          <g class="engine" data-k="engine">
            <rect x="636" y="491" width="328" height="34" fill="#0a1f44" stroke="#d2a660" stroke-width="1.6" />
            <rect x="641" y="496" width="318" height="24" fill="none" stroke="#d2a660" stroke-opacity=".45" />
