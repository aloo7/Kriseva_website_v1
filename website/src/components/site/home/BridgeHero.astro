                <rect x="18" y="-9" width="44" height="18" fill="#d2a660" stroke="#0a1f44" stroke-width="1.6" />
                <path d="M29 -9V9M40 -9V9M51 -9V9M18 0H62" stroke="#0a1f44" stroke-width=".9" />
                <path d="M-18 0H-12M12 0H18" stroke="#0a1f44" stroke-width="2" />
                <rect x="-12" y="-11" width="24" height="22" rx="2" fill="#0a1f44" />
                <rect x="-6" y="-5" width="12" height="4" fill="#d2a660" />
                <path d="M0 11V18M-7 24Q0 15 7 24" fill="none" stroke="#0a1f44" stroke-width="1.8" />
              </g>
            </g>
            <g class="drone">
              <g transform="translate(262 336)">
                <path d="M-26 -6H26" stroke="#0a1f44" stroke-width="2.4" />
                <ellipse class="rotor" cx="-26" cy="-9" rx="13" ry="2.4" fill="#0a1f44" />
                <ellipse class="rotor" cx="26" cy="-9" rx="13" ry="2.4" fill="#0a1f44" />
