---
import HomeNextStep from './HomeNextStep.astro';
---
<section class="story-home" data-quick-home aria-labelledby="hero-title">
  <div class="story-home__intro wrap">
    <div>
      <p class="eyebrow">Defence and space · India</p>
      <h1 id="hero-title" data-quick-copy>From paperwork<br /> <em>to proof.</em></h1>
    </div>
    <div class="story-home__side">
      <p data-quick-copy>The bridge between defence and space suppliers and government procurement.</p>
      <a href="/contact?intent=demo" class="btn">Book a demo <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
  <div class="wrap">
    <div class="film" data-film>
      <div class="film__bar">
        <p>Kriseva in <strong>24 seconds</strong></p>
        <button type="button" data-film-play data-film-controls hidden aria-controls="kriseva-film">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m8 5 11 7-11 7Z" fill="none" stroke="currentColor" stroke-width="1.7" /></svg>
          <span data-film-label>Play film</span>
        </button>
      </div>
      <video id="kriseva-film" controls playsinline muted preload="none" poster="/media/kriseva-portrait-poster.jpg" src="/media/kriseva-portrait.mp4" aria-label="Kriseva in 24 seconds: an illustrated procurement story" aria-describedby="film-summary" data-film-video>
        <track kind="captions" srclang="en" label="English" src="/media/kriseva-story.vtt" />
        <p><a href="/media/kriseva-portrait.mp4">Watch or download the film.</a></p>
      </video>
      <div class="film__chapters" role="group" aria-label="Choose a chapter in the film" data-film-controls hidden>
        <button type="button" data-film-time="0" aria-pressed="true" aria-controls="kriseva-film">The gap</button>
        <button type="button" data-film-time="6" aria-pressed="false" aria-controls="kriseva-film">TAS</button>
        <button type="button" data-film-time="10" aria-pressed="false" aria-controls="kriseva-film">Evidence</button>
        <button type="button" data-film-time="15" aria-pressed="false" aria-controls="kriseva-film">Evaluator</button>
      </div>
      <p class="sr-only" role="status" data-film-status></p>
    </div>
    <div class="story-home__after">
      <p id="film-summary" data-quick-copy>Evidence crosses. People decide.</p>
      <div class="story-home__links">
      <a href="/bridge">Explore the bridge <span aria-hidden="true">&rarr;</span></a>
    <details class="story-home__transcript">
      <summary>Read the story</summary>
      <p>Kriseva connects the two sides of defence and space procurement. TAS helps suppliers find tenders and prepare their bids. Answers travel with their supporting evidence. Evaluator helps buyers check that evidence and review bids. Both run on your premises. People make the decisions.</p>
    </details>
      </div>
    </div>
  </div>
  <HomeNextStep />
</section>
<script>
  import { initHomeFilm } from '../../../scripts/home-film';
  const film = document.querySelector<HTMLElement>('[data-film]');
  if (film) initHomeFilm(film);
</script>
<style>
  .story-home { padding-top: var(--header-h); background: var(--paper); }
  .story-home .wrap { padding-inline: var(--home-gutter, var(--gutter)); }
  .story-home__intro { display: grid; grid-template-columns: var(--home-columns, minmax(0, 1.2fr) minmax(0, .8fr)); align-items: end; gap: 2rem; padding-block: 2rem 1.75rem; }
  .story-home__intro .eyebrow { margin-bottom: .8rem; font-size: .6875rem; letter-spacing: .1em; color: #536681; }
  h1 { font-family: var(--f-sans); font-size: clamp(3rem, 5vw, 4.75rem); font-weight: 500; line-height: .98; letter-spacing: -.06em; overflow-wrap: anywhere; }
  h1 em { color: #2c61ac; font-style: normal; }
  .story-home__side { display: grid; justify-items: start; gap: 1rem; }
  .story-home__side p { font-size: 1.0625rem; line-height: 1.5; max-width: 35ch; color: var(--ink-2); }
  .story-home__side .btn { min-height: 48px; border-radius: 999px; font: inherit; font-size: .875rem; letter-spacing: 0; text-transform: none; padding: .75rem 1.25rem; }
  .film { overflow: hidden; border-radius: 20px; border: 1px solid #183456; background: #081b39; color: #f6f8fc; }
  .film__bar { display: flex; justify-content: space-between; align-items: center; gap: .5rem; min-height: 56px; padding: .2rem 1rem; border-bottom: 1px solid #294267; }
  .film__bar p { font-size: .875rem; color: #bbcee7; }
  .film__bar strong { font-weight: 500; color: #f6f8fc; }
  .film__bar button { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 48px; padding: .5rem .65rem; font-size: .875rem; color: #e3bb78; }
  video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: #081b39; object-fit: contain; }
  .film__chapters { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 4rem), 1fr)); gap: .25rem; border-top: 1px solid #294267; padding: .35rem; }
  .film__chapters button { min-height: 48px; padding: .4rem .3rem; border-radius: 10px; color: #bbcee7; font-size: .875rem; }
  .film__chapters button:hover { background: #142f55; }
  .film__chapters button[aria-pressed="true"] { background: #203d65; color: #ffffff; }
  .film :focus-visible { outline-color: #e3bb78; outline-offset: -4px; }
  .story-home__after { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 1.5rem; padding-block: 1rem .25rem; }
  .story-home__after p { font-size: 1rem; line-height: 1.5; color: var(--ink-2); }
  .story-home__links { display: flex; flex-wrap: wrap; align-items: start; justify-content: space-between; gap: 0 1rem; }
  .story-home__after a { display: inline-flex; align-items: center; gap: .6rem; min-height: 48px; font-size: .9375rem; color: #214e89; text-underline-offset: 4px; }
  .story-home__transcript { margin-bottom: .25rem; }
  .story-home__transcript summary { display: flex; align-items: center; min-height: 48px; width: fit-content; cursor: pointer; font-size: .875rem; color: #536681; text-decoration: underline; text-underline-offset: 4px; }
  .story-home__transcript p { max-width: 65ch; font-size: 1rem; line-height: 1.6; color: var(--ink-2); padding-block: .5rem 1rem; }
  [hidden] { display: none !important; }
  @media (width <= 700px) {
    .story-home__intro { grid-template-columns: 1fr; gap: .75rem; padding-block: 1rem .75rem; }
    h1 { font-size: clamp(2.5rem, 11.5vw, 3.75rem); }
    .story-home__side p { font-size: 1rem; }
    .story-home__side { gap: .5rem; }
    .story-home__intro .eyebrow { font-size: .625rem; }
    .film { border-radius: 16px; }
    .film__bar { padding-inline: .7rem; }
    .film__bar p, .film__bar button { font-size: .8125rem; }
    video { aspect-ratio: 4 / 5; }
    .story-home__after { padding-top: .85rem; }
    .story-home__links { width: 100%; }
  }
  :global(html[data-phone-layout]) .story-home__intro { grid-template-columns: 1fr; gap: 1rem; }
  :global(html[data-phone-layout]) h1 { font-size: 3rem; }
  :global(html[data-phone-layout]) video { aspect-ratio: 4 / 5; }
  @media (height <= 500px) and (width >= 701px) {
    .story-home__intro { padding-block: 1rem; }
    h1 { font-size: 2.75rem; }
    video { max-height: calc(100svh - var(--header-h) - 4rem); }
  }
</style>
