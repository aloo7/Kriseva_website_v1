---
// TenderToAward.astro: both sides of the bridge in five moves each, behind a
// two-tab switch (initTabs in site.ts). Without JS both panels show; the
// script hides the unselected one on load.
const sides = [
  {
    id: 'supplier',
    tab: 'Supplier side',
    product: 'TAS',
    title: 'From a scattered market to a winnable bid.',
    steps: [
      { t: 'Scan', d: 'GeM, CPPP, ISRO, defence and state portals, read in one search.', icon: 'radar' },
      { t: 'Shortlist', d: 'Each tender scored against your capability list, with reasons.', icon: 'list' },
      { t: 'Read', d: 'Clauses, annexures and corrigenda read; every requirement pulled out.', icon: 'doc' },
      { t: 'Decide', d: 'Bid, review or skip, with the clause behind each reason.', icon: 'fork' },
      { t: 'Answer', d: 'Compliance checklist, document pack and deadline alerts for the team.', icon: 'send' },
    ],
  },
  {
    id: 'buyer',
    tab: 'Buyer side',
    product: 'Evaluator',
    title: 'One tender through Evaluator, in five moves.',
    steps: [
      { t: 'Select tender', d: 'Criteria set in the tender’s own words.', icon: 'doc' },
      { t: 'Upload bids', d: 'Bid packets in; price annexes stay sealed.', icon: 'stack' },
      { t: 'Review evidence', d: 'Every finding opens the page it came from.', icon: 'lens' },
      { t: 'Compare bidders', d: 'Comparative statement across every bidder.', icon: 'grid' },
      { t: 'Officer decides', d: 'Decision recorded; hashed, audit-ready export.', icon: 'seal' },
    ],
  },
];

const icons: Record<string, string> = {
  radar: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><path d="M12 12l6-6"/>',
  list: '<path d="M8 6h12M8 12h12M8 18h8"/><circle cx="4" cy="6" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="4" cy="18" r="1"/>',
  doc: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 16h6"/>',
  fork: '<path d="M12 21v-7M12 14L6 8M12 14l6-6M4 5h4v4M20 5h-4v4"/>',
  send: '<path d="M3 11l18-8-8 18-2-8z"/>',
  stack: '<path d="M4 8l8-4 8 4-8 4z"/><path d="M4 12l8 4 8-4M4 16l8 4 8-4"/>',
  lens: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/>',
  grid: '<rect x="3" y="4" width="18" height="16"/><path d="M3 10h18M3 15h18M9 4v16M15 4v16"/>',
  seal: '<circle cx="12" cy="10" r="6"/><path d="M8.5 15L7 21l5-2.5L17 21l-1.5-6M9.5 10l1.7 1.7 3.3-3.4"/>',
};
---
<section class="section t2a" aria-labelledby="t2a-title">
  <div class="wrap">
    <header class="section-head section-head--split">
      <p class="eyebrow">04 · Tender to award</p>
      <h2 id="t2a-title" class="h2">Both sides of the bridge, <em>five moves</em> each.</h2>
      <p class="lead">Kriseva does the reading. People keep the judgement. Switch sides to see how a tender travels.</p>
    </header>

    <div class="t2a__tabs" data-tabs style="--tab-i:0">
      <div class="t2a__switch" role="tablist" aria-label="Choose a side">
        <span class="t2a__thumb" aria-hidden="true"></span>
        {sides.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${s.id}`}
            aria-controls={`panel-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {s.tab} <span class="mono">{s.product}</span>
          </button>
        ))}
      </div>

      {sides.map((s) => (
        <div class="t2a__panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} data-panel-side={s.id}>
          <h3 class="h3 t2a__title">{s.title}</h3>
          <ol role="list" class="t2a__rail rv-stagger">
            {s.steps.map((st, j) => (
              <li class:list={['t2a__step', { 't2a__step--final': j === 4 && s.id === 'buyer' }]}>
                <span class="t2a__node" aria-hidden="true"><span class="t2a__n mono">0{j + 1}</span></span>
                <svg class="t2a__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[st.icon]} />
                <span class="t2a__t">{st.t}</span>
                <span class="t2a__d">{st.d}</span>
              </li>
            ))}
          </ol>
          <a class="link-arrow t2a__more" href={s.id === 'buyer' ? '/evaluator' : '/tas'}>See {s.product} in detail <span aria-hidden="true">&rarr;</span></a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .t2a__switch {
    position: relative;
    display: inline-grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 4px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    background: var(--card);
  }

  .t2a__thumb {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: calc(50% - 4px);
    border-radius: 999px;
    background: var(--navy);
    transform: translateX(calc(var(--tab-i) * 100%));
    transition: transform 0.5s var(--ease);
  }

  .t2a__switch [role='tab'] {
    position: relative;
    z-index: 1;
    padding: 0.75rem 1.4rem;
    min-height: 44px;
    font-weight: 500;
    border-radius: 999px;
    transition: color 0.35s;
    white-space: nowrap;
  }

  .t2a__switch [role='tab'] .mono {
    margin-left: 0.4rem;
    font-size: 0.6875rem;
    color: var(--brass-ink);
  }

  .t2a__switch [aria-selected='true'] {
    color: var(--on-navy);
  }

  .t2a__switch [aria-selected='true'] .mono {
    color: var(--brass-light);
  }

  .t2a__title {
    margin-bottom: 2rem;
    font-weight: 300;
  }

  .t2a__rail {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .t2a__rail::before {
    content: '';
    position: absolute;
    top: 21px;
    left: 22px;
    right: 22px;
    height: 1px;
    background: var(--line-strong);
  }

  .t2a__step {
    position: relative;
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }

  .t2a__node {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    position: relative;
    z-index: 1;
    margin-bottom: 0.5rem;
  }

  .t2a__n {
    font-size: 0.6875rem;
    color: var(--ink-2);
  }

  .t2a__step--final .t2a__node {
    border: 2px solid var(--red);
    box-shadow: 0 0 0 4px var(--paper), 0 0 0 5px var(--red);
  }

  .t2a__step--final .t2a__n,
  .t2a__step--final .t2a__t {
    color: var(--red);
  }

  .t2a__icon {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: var(--brass);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .t2a__t {
    font-family: var(--f-serif);
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .t2a__d {
    font-size: var(--t-small);
    color: var(--ink-2);
    line-height: 1.45;
  }

  .t2a__more {
    margin-top: 2.25rem;
  }

  @media (width <= 900px) {
    .t2a__rail {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .t2a__rail::before {
      top: 22px;
      bottom: 22px;
      left: 21px;
      right: auto;
      width: 1px;
      height: auto;
    }

    .t2a__step {
      grid-template-columns: 44px 26px minmax(0, 1fr);
      column-gap: 1rem;
      align-items: center;
    }

    .t2a__node {
      grid-row: span 2;
      margin: 0;
    }

    .t2a__icon {
      grid-row: span 2;
    }

    .t2a__d {
      grid-column: 3;
    }
  }

  @media (width <= 460px) {
    .t2a__switch {
      display: grid;
      width: 100%;
    }

    .t2a__switch [role='tab'] {
      padding-inline: 0.6rem;
      font-size: 0.875rem;
    }

    .t2a__switch [role='tab'] .mono {
      display: none;
    }
  }
</style>
