---
// EvalStatement.astro: a specimen comparative statement. Three fictional
// bidders, five criteria, each cell with its state and page; the decision row
// is left for the officer.
type Cell = [state: 'ok' | 'ask' | 'no', ref: string];
const bidders = ['Bidder A', 'Bidder B', 'Bidder C'];
const rows: { c: string; clause: string; cells: Cell[] }[] = [
  { c: 'ISO 9001:2015 certificate', clause: '4.2', cells: [['ok', 'p. 14'], ['ok', 'p. 6'], ['ok', 'p. 22']] },
  { c: 'Average annual turnover, Rs 5 crore over three years', clause: '4.5', cells: [['ok', 'p. 3'], ['ask', 'p. 3, two years shown'], ['ok', 'p. 9']] },
  { c: 'Two supply orders for similar items', clause: '5.1', cells: [['ok', 'p. 31'], ['ok', 'p. 18'], ['no', 'searched 212 pp.']] },
  { c: 'Make in India, Class I local supplier', clause: '6.3', cells: [['ok', 'p. 2'], ['ok', 'p. 2'], ['ask', 'p. 4, unsigned']] },
  { c: 'EMD paid, or MSE exemption proof', clause: '7.1', cells: [['ok', 'p. 40'], ['ok', 'Udyam, p. 41'], ['ok', 'p. 37']] },
];
const label = { ok: 'Supported', ask: 'Needs clarification', no: 'Not found' } as const;
const icon = { ok: '✓', ask: '?', no: '×' } as const;
---
<section class="section estmt" aria-labelledby="estmt-title">
  <div class="wrap">
    <header class="section-head section-head--split">
      <p class="eyebrow">03 · Comparative statement</p>
      <h2 id="estmt-title" class="h2">Every bidder, every criterion, <em>one table.</em></h2>
      <p class="lead">The statement a committee signs, built from findings that each open their page. The last row stays empty until the officer fills it.</p>
    </header>

    <div class="estmt__sheet rv">
      <div class="estmt__bar">
        <span class="mono">Technical evaluation · comparative statement</span>
        <span class="stamp">Specimen</span>
      </div>
      <div class="estmt__scroll" tabindex="0" role="region" aria-label="Specimen comparative statement, scrollable">
        <table class="estmt__table">
          <caption class="sr-only">Specimen comparative statement: five criteria for three fictional bidders, with each finding's state and page reference.</caption>
          <thead>
            <tr>
              <th scope="col"><span class="mono">Clause</span></th>
              <th scope="col"><span class="mono">Criterion</span></th>
              {bidders.map((b) => <th scope="col"><span class="mono">{b}</span></th>)}
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td class="mono estmt__clause">{r.clause}</td>
                <th scope="row">{r.c}</th>
                {r.cells.map(([st, ref]) => (
                  <td>
                    <span class:list={['ecell', `ecell--${st}`]}>
                      <span aria-hidden="true">{icon[st]}</span>
                      <span class="sr-only">{label[st]}:</span>
                      {ref}
                    </span>
                  </td>
                ))}
              </tr>
            ))}
            <tr class="estmt__decision">
              <td class="mono estmt__clause">Officer</td>
              <th scope="row">Decision and reason</th>
              {bidders.map(() => <td><span class="estmt__blank">To be recorded</span></td>)}
            </tr>
          </tbody>
        </table>
      </div>
      <p class="estmt__foot">Bidders, criteria and pages are fictional. In Evaluator, every cell opens the page it cites.</p>
    </div>
  </div>
</section>

<style>
  .estmt__sheet {
    background: var(--card);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    box-shadow: 0 30px 60px -40px rgb(10 31 68 / 45%);
  }

  .estmt__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--line);
    background: var(--paper-2);
  }

  .estmt__bar .mono {
    font-size: 0.6875rem;
    color: var(--ink-2);
  }

  .estmt__scroll {
    position: relative;
    overflow-x: auto;
  }

  .estmt__scroll:focus-visible {
    outline-offset: -2px;
  }

  .estmt__table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .estmt__table th,
  .estmt__table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: middle;
  }

  .estmt__table thead th {
    background: var(--card);
  }

  .estmt__table thead .mono {
    font-size: 0.625rem;
    color: var(--ink-3);
  }

  .estmt__table tbody th {
    font-weight: 500;
    line-height: 1.35;
  }

  .estmt__clause {
    font-size: 0.75rem;
    color: var(--brass-ink);
    white-space: nowrap;
  }

  .ecell {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.5rem;
    font-family: var(--f-mono);
    font-size: 0.75rem;
    border-radius: 2px;
    white-space: nowrap;
  }

  .ecell--ok { background: #e6efe5; color: #255a39; }
  .ecell--ask { background: #f6ead2; color: var(--brass-ink); }
  .ecell--no { background: #f6dfdb; color: var(--red); }

  .estmt__decision th,
  .estmt__decision td {
    border-bottom: 0;
    background: rgb(168 50 42 / 4%);
  }

  .estmt__blank {
    display: inline-block;
    min-width: 8rem;
    padding: 0.35rem 0;
    border-bottom: 1.5px dashed var(--red);
    color: var(--red);
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .estmt__foot {
    padding: 0.9rem 1.25rem 1.1rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
    border-top: 1px solid var(--line);
  }
</style>
