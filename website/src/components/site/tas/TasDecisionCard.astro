---
// TasDecisionCard.astro: one tender, one decision card. Three fictional
// specimens (bid, review, skip) behind the shared tab behaviour in
// src/scripts/site.ts (data-tabs). Without JS every card shows.
// Every identifier is SPECIMEN-000n; no real tender appears here.
const specs = [
  {
    id: 'SPECIMEN-0001',
    title: 'Rugged display unit, 15 inch',
    call: 'Bid',
    fit: 82,
    facts: [
      ['Closing date', '12 Nov 2026, 15:00'],
      ['EMD', 'Rs 40,000'],
      ['MSE exemption', 'EMD waived for registered MSEs'],
      ['Make in India', 'Class I local supplier'],
    ],
    reasons: [
      { t: 'Matches item 3 on your capability list: rugged displays, 15 inch class.', ref: 'Clause 3.1', q: 'Display unit, 15 inch, sunlight readable.' },
      { t: 'You meet the eligibility: turnover of Rs 5 cr for 3 years.', ref: 'Annexure B', q: 'Average annual turnover of Rs 5 crore over the last three years.' },
      { t: 'Delivery in 45 days is within your usual lead time.', ref: 'Corrigendum 1', q: 'Delivery within 45 days of the supply order.' },
    ],
  },
  {
    id: 'SPECIMEN-0002',
    title: 'Ka-band filter assembly',
    call: 'Review',
    fit: 71,
    facts: [
      ['Closing date', '03 Dec 2026, 14:00'],
      ['EMD', 'Rs 1,20,000'],
      ['MSE exemption', 'Not stated: check Annexure A'],
      ['Make in India', 'Class II local supplier'],
    ],
    reasons: [
      { t: 'RF filters are on your list. Ka-band is not.', ref: 'Clause 2.4', q: 'Waveguide filter assembly, Ka-band, 26.5 to 40 GHz.' },
      { t: 'Two past supply orders are required. Your list shows one.', ref: 'Annexure C', q: 'Two supply orders of similar value in the last five years.' },
      { t: 'Delivery in 120 days is longer than your usual quote.', ref: 'Corrigendum 2', q: 'Delivery within 120 days of the supply order.' },
    ],
  },
  {
    id: 'SPECIMEN-0003',
    title: 'Office furniture, annual rate',
    call: 'Skip',
    fit: 8,
    facts: [
      ['Closing date', '20 Nov 2026, 11:00'],
      ['EMD', 'Rs 15,000'],
      ['MSE exemption', 'EMD waived for registered MSEs'],
      ['Make in India', 'Not specified'],
    ],
    reasons: [
      { t: 'No match on your capability list.', ref: 'Clause 1.1', q: 'Office tables, chairs and storage units, annual rate contract.' },
      { t: 'The category is outside your registered items.', ref: 'Clause 1.3', q: 'Bidders shall be registered under the furniture category.' },
      { t: 'A rate contract, with no technical item to bid.', ref: 'Clause 5.2', q: 'Rates are valid for twelve months from the date of award.' },
    ],
  },
];
---
<section class="section dcard on-paper-2" aria-labelledby="dc-title">
  <div class="wrap">
    <header class="section-head section-head--split">
      <p class="eyebrow">03 · The decision card</p>
      <h2 id="dc-title" class="h2">Every tender ends as a <em>decision card.</em></h2>
      <p class="lead">Bid, review or skip, with the reason and the clause behind it. These are specimens: the tenders are fictional. Switch between them.</p>
    </header>

    <div class="dc" data-tabs style="--tab-i:0">
      <div class="dc__tabs" role="tablist" aria-label="Choose a specimen tender">
        {specs.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`dc-tab-${i}`}
            aria-controls={`dc-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="dc__tab"
          >
            <span class="mono dc__tab-id">{s.id}</span>
            <span class="dc__tab-t">{s.title}</span>
            <span class:list={['chip', `chip--${s.call.toLowerCase()}`]}>{s.call}</span>
          </button>
        ))}
      </div>

      {specs.map((s, i) => (
        <div class="dc__panel" role="tabpanel" id={`dc-panel-${i}`} aria-labelledby={`dc-tab-${i}`}>
          <article class="cd reg" aria-label={`Decision card for ${s.title}`}>
            <header class="cd__top">
              <p class="mono cd__id">{s.id}</p>
              <span class="stamp">Specimen</span>
            </header>
            <h3 class="cd__title">{s.title}</h3>

            <dl class="cd__facts">
              {s.facts.map(([k, v]) => (
                <div>
                  <dt class="mono">{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>

            <div class="cd__score">
              <p class="cd__big" aria-label={`Fit score ${s.fit} out of 100`}>{s.fit}<span>/100</span></p>
              <div class="cd__scoremeta">
                <p class="mono cd__scorek">Fit with your capability list</p>
                <span class="cd__bar" style={`--fit:${s.fit / 100}`}><span></span></span>
              </div>
              <span class:list={['chip', 'cd__call', `chip--${s.call.toLowerCase()}`]}>{s.call}</span>
            </div>

            <ol role="list" class="cd__reasons">
              {s.reasons.map((r, ri) => (
                <li>
                  <span class="cd__no" aria-hidden="true">{ri + 1}</span>
                  <span class="cd__rt">{r.t}</span>
                  <span class="mono cd__ref">{r.ref}</span>
                </li>
              ))}
            </ol>
            <p class="cd__foot">TAS proposes. Your bid team decides and submits.</p>
          </article>

          <div class="src" role="group" aria-label="The tender clauses behind each reason">
            <p class="mono src__k">The tender, as TAS read it</p>
            <div class="src__doc">
              {s.reasons.map((r, ri) => (
                <>
                  <span class="src__line" style={`--w:${[88, 72, 80][ri]}%`}></span>
                  <span class="src__line" style={`--w:${[64, 90, 58][ri]}%`}></span>
                  <p class="src__hl">
                    <span class="src__no" aria-hidden="true">{ri + 1}</span>
                    <span class="src__q">“{r.q}”</span>
                    <span class="mono src__ref">{r.ref}</span>
                  </p>
                </>
              ))}
              <span class="src__line" style="--w:70%"></span>
              <span class="src__line" style="--w:46%"></span>
            </div>
            <p class="src__note">The numbers on the card point to the lines highlighted here.</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .dc__tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    background: var(--paper);
  }

  .dc__tab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'id chip' 't chip';
    gap: 0.1rem 0.75rem;
    align-items: center;
    padding: 0.85rem 1rem;
    min-height: 60px;
    text-align: left;
    border-right: 1px solid var(--line-strong);
    transition: background-color 0.3s, color 0.3s;
  }

  .dc__tab:last-child {
    border-right: 0;
  }

  .dc__tab-id {
    grid-area: id;
    font-size: 0.625rem;
    color: var(--brass-ink);
  }

  .dc__tab-t {
    grid-area: t;
    font-weight: 500;
    font-size: 0.9375rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dc__tab .chip {
    grid-area: chip;
  }

  .dc__tab[aria-selected='true'] {
    background: var(--navy);
    color: var(--on-navy);
  }

  .dc__tab[aria-selected='true'] .dc__tab-id {
    color: var(--brass-light);
  }

  .dc__tab[aria-selected='true'] .chip--bid {
    border-color: #7fc79a;
    color: #9fdcb5;
  }

  .dc__tab[aria-selected='true'] .chip--review {
    border-color: var(--brass-light);
    color: var(--brass-light);
  }

  .dc__tab[aria-selected='true'] .chip--skip {
    border-color: #e58c80;
    color: #f0a59b;
  }

  .dc__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1rem, 2.5vw, 2.25rem);
    align-items: stretch;
  }

  .dc__panel + .dc__panel {
    margin-top: 2rem;
  }

  /* The card */
  .cd {
    display: grid;
    gap: 1.15rem;
    align-content: start;
    padding: clamp(1.25rem, 1rem + 1.6vw, 2.25rem);
    background: var(--card);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    --reg: var(--brass);
  }

  .cd__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cd__id {
    color: var(--ink-3);
  }

  .cd__title {
    font-family: var(--f-serif);
    font-weight: 300;
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.3rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .cd__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line-strong);
  }

  .cd__facts > div {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0.5rem 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }

  .cd__facts dt {
    font-size: 0.625rem;
    color: var(--ink-3);
  }

  .cd__facts dd {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .cd__score {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 0.9rem 1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .cd__big {
    font-family: var(--f-serif);
    font-weight: 300;
    font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .cd__big span {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    letter-spacing: 0;
    color: var(--ink-3);
    margin-left: 0.2rem;
  }

  .cd__scoremeta {
    display: grid;
    gap: 0.5rem;
  }

  .cd__scorek {
    font-size: 0.625rem;
    color: var(--ink-3);
  }

  .cd__bar {
    display: block;
    height: 6px;
    background: var(--paper-3);
  }

  .cd__bar span {
    display: block;
    height: 100%;
    background: var(--navy);
    transform-origin: left;
    transform: scaleX(var(--fit));
  }

  .cd__call {
    font-size: 0.8125rem;
    padding: 0.5rem 0.9rem;
    border-width: 1.5px;
  }

  .cd__reasons {
    display: grid;
    gap: 0.75rem;
  }

  .cd__reasons li {
    display: grid;
    grid-template-columns: 1.7rem minmax(0, 1fr);
    grid-template-areas: 'no t' 'no ref';
    gap: 0.15rem 0.7rem;
    align-items: start;
  }

  .cd__no,
  .src__no {
    grid-area: no;
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--navy);
    color: var(--on-navy);
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .cd__rt {
    grid-area: t;
    font-size: 0.96875rem;
    line-height: 1.4;
  }

  .cd__ref {
    grid-area: ref;
    font-size: 0.625rem;
    color: var(--brass-ink);
  }

  .cd__foot {
    padding-top: 0.9rem;
    border-top: 1px dashed var(--line-strong);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  /* The tender, as TAS read it */
  .src {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-width: 0;
  }

  .src__k {
    color: var(--ink-3);
  }

  .src__doc {
    display: grid;
    gap: 0.6rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    background: var(--paper);
    border: 1px solid var(--line-strong);
    box-shadow: 6px 6px 0 -1px var(--paper-3), 6px 6px 0 0 var(--line-strong);
    flex: 1;
    align-content: space-between;
  }

  .src__line {
    display: block;
    height: 5px;
    width: var(--w);
    background: var(--paper-3);
    border-radius: 1px;
  }

  .src__hl {
    position: relative;
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    grid-template-areas: 'no q' 'no ref';
    gap: 0.1rem 0.6rem;
    padding: 0.55rem 0.6rem;
    background: rgb(210 166 96 / 22%);
    border-left: 3px solid var(--brass);
  }

  .src__q {
    grid-area: q;
    font-family: var(--f-serif);
    font-style: italic;
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .src__ref {
    grid-area: ref;
    font-size: 0.625rem;
    color: var(--brass-ink);
  }

  .src__note {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  @media (width <= 980px) {
    .dc__panel {
      grid-template-columns: minmax(0, 1fr);
    }

    .dc__tabs {
      grid-template-columns: minmax(0, 1fr);
    }

    .dc__tab {
      border-right: 0;
      border-bottom: 1px solid var(--line-strong);
    }

    .dc__tab:last-child {
      border-bottom: 0;
    }
  }

  @media (width <= 520px) {
    .cd__facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .cd__score {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .cd__call {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
</style>
