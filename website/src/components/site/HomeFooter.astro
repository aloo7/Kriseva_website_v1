---
import { company } from '../../data/kriseva';
import Logo from './Logo.astro';
---
<footer class="home-footer">
  <div class="wrap home-footer__inner">
    <a href="/" class="home-footer__brand" aria-label="Kriseva home"><Logo size={21} /></a>
    <nav aria-label="Footer">
      <a href="/proof">Proof</a>
      <a href="/security">Security</a>
      <a href="/company">Company</a>
      <a href="/contact">Contact</a>
    </nav>
    <p>{company.legalName} · {company.city}, India</p>
  </div>
</footer>
<style>
  .home-footer { border-top: 1px solid rgb(10 31 68 / 10%); background: var(--paper); }
  .home-footer__inner { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem 2rem; padding-block: 1rem; }
  .home-footer__brand { display: inline-flex; min-height: 48px; align-items: center; text-decoration: none; }
  nav { display: flex; flex-wrap: wrap; gap: 0 1.25rem; margin-left: auto; }
  nav a { display: inline-flex; align-items: center; min-height: 48px; font-size: .875rem; color: var(--ink-2); text-decoration: none; }
  nav a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 5px; }
  p { color: var(--ink-3); font-size: .875rem; line-height: 1.5; }
  @media (width <= 700px) {
    .home-footer__inner { gap: 0 1rem; padding-block: .75rem 1.25rem; }
    .home-footer__brand { min-height: 40px; }
    nav { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 .5rem; width: 100%; margin-left: 0; }
    nav a { min-width: 0; justify-content: flex-start; overflow-wrap: anywhere; }
    p { width: 100%; margin-top: .25rem; }
  }
</style>
