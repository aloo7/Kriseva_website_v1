---
// Engagements.astro: the two pilot offers, one per side of the bridge.
// Wording matches home/PlansTeaser.astro. No figures, no customers.
const plans = [
  {
    code: 'Plan A',
    kicker: 'For suppliers · TAS',
    title: 'TAS pilot',
    body: 'We set TAS up on your machine, load your capability list, and run it on live tenders with your bid team.',
    spec: [
      ['Runs', 'On your own machine'],
      ['You bring', 'Your portals, your keywords, your capability list'],
      ['You get', 'A daily shortlist with bid, review or skip reasons'],
      ['Worked with', 'Your bid team'],
    ],
    cta: { label: 'Request a TAS pilot', href: '/contact?intent=pilot&side=supplier' },
  },
  {
    code: 'Plan B',
    kicker: 'For buyers · Evaluator',
    title: 'Evaluator sandbox',
    body: 'One closed tender, in your room. We run Evaluator on a tender your committee has already decided, so you can check every finding against your own result.',
    spec: [
      ['Runs', 'Offline, on your premises'],
      ['You bring', 'One closed tender, with a known result to check us against'],
      ['You get', 'Every finding linked to the page it came from'],
      ['Worked with', 'Your committee. Officers decide.'],
    ],
    cta: { label: 'Request a sandbox', href: '/contact?intent=pilot&side=buyer' },
  },
];
---
<section class="section eng" aria-labelledby="eng-title">
  <div class="wrap">
    <header class="section-head section-head--split">
      <p class="eyebrow">01 · Two ways in</p>
      <h2 id="eng-title" class="h2">One pilot for <em>each side</em> of the bridge.</h2>
      <p class="lead">Both begin on your own material, with a scope we write down before anything is installed. A plan comes after, for what the pilot shows you need.</p>
    </header>

    <div class="eng__grid rv-stagger">
      {plans.map((p) => (
        <article class="eng__card reg">
          <header class="eng__head">
            <span class="eng__code mono">{p.code}</span>
            <span class="eng__kicker mono">{p.kicker}</span>
          </header>
          <h3 class="eng__title">{p.title}</h3>
          <p class="eng__body">{p.body}</p>
          <dl class="eng__spec">
            {p.spec.map(([k, v]) => (
              <div class="eng__row">
                <dt class="mono">{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
          <a class="btn" href={p.cta.href}>{p.cta.label} <span class="arrow" aria-hidden="true">&rarr;</span></a>
        </article>
      ))}
    </div>

    <p class="eng__alt">
      Not sure which side you are on? <a class="link-arrow" href="/contact?intent=demo">Book a demo <span aria-hidden="true">&rarr;</span></a>
    </p>
  </div>
</section>

<style>
  .eng__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 1.75rem);
  }

  .eng__card {
    --reg: var(--brass);

    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    padding: clamp(1.4rem, 1rem + 1.6vw, 2.4rem);
    background: var(--card);
    border: 1px solid var(--ink);
    border-radius: var(--radius);
  }

  .eng__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px dashed var(--line-strong);
  }

  .eng__code {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--ink);
    color: var(--ink);
    font-size: 0.6875rem;
  }

  .eng__kicker {
    color: var(--brass-ink);
    font-size: 0.6875rem;
  }

  .eng__title {
    font-family: var(--f-serif);
    font-weight: 300;
    font-size: clamp(1.9rem, 1.4rem + 1.4vw, 2.6rem);
    line-height: 1.08;
    letter-spacing: -0.012em;
  }

  .eng__body {
    color: var(--ink-2);
    max-width: 34em;
  }

  .eng__spec {
    display: grid;
    margin-bottom: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .eng__row {
    display: grid;
    grid-template-columns: minmax(0, 8.5rem) minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--t-small);
  }

  .eng__row dt {
    color: var(--brass-ink);
    font-size: 0.6875rem;
    padding-top: 0.2rem;
  }

  .eng__row dd {
    min-width: 0;
  }

  .eng__card .btn {
    margin-top: auto;
    align-self: flex-start;
    max-width: 100%;
    white-space: normal;
  }

  .eng__alt {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    color: var(--ink-2);
  }

  @media (width <= 900px) {
    .eng__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (width <= 480px) {
    .eng__row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
