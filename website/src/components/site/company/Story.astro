---
// Story.astro: the company in three short beats, each with a small drawing.
// 1 The gap (paper on both sides of the river). 2 Two pillars, one standard.
// 3 The long game (solid spans are where we build today, dashed are our aim).
const beats = [
  {
    n: '01',
    id: 'gap',
    k: 'The gap',
    t: 'Paper on both sides of the river.',
    d: 'A supplier reads a tender to decide whether to bid, then writes a response. A buyer reads every response to decide who qualifies. It is the same paper, read twice, by people who never see each other’s workings.',
    fig: 'Fig. 1 · The gap',
  },
  {
    n: '02',
    id: 'pillars',
    k: 'The two pillars',
    t: 'One product for each shore, held to one standard.',
    d: 'TAS helps suppliers find, read and answer the tenders they can win. Evaluator helps government committees check every bid, with the source page behind every finding. Both follow one evidence discipline, and both run on the customer’s own machines.',
    fig: 'Fig. 2 · Two pillars',
    links: [
      { href: '/tas', label: 'TAS for suppliers' },
      { href: '/evaluator', label: 'Evaluator for buyers' },
    ],
  },
  {
    n: '03',
    id: 'long-game',
    k: 'The long game',
    t: 'The evidence layer for Indian procurement.',
    d: 'Our aim is to make evidence the default in how India buys: every claim in a bid, and every finding about it, traceable to a page that anyone entitled to check can open. We start with defence and space because the files cannot leave the building and a wrong award is costly. We intend to grow from there.',
    fig: 'Fig. 3 · The long game. Solid: where we build today. Dashed: our aim.',
  },
];
---
<section class="section story" id="story" aria-labelledby="story-title">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">01 · Why we exist</p>
      <h2 id="story-title" class="h2">Three beats, <em>one bridge.</em></h2>
    </header>

    <ol role="list" class="story__list">
      {beats.map((b, i) => (
        <li class:list={['beat', { 'beat--flip': i % 2 === 1 }]}>
          <div class="beat__txt rv">
            <p class="beat__n"><span class="mono">{b.n}</span><span class="mono beat__k">{b.k}</span></p>
            <h3 class="h3 beat__t">{b.t}</h3>
            <p class="beat__d">{b.d}</p>
            {b.links && (
              <p class="beat__links">
                {b.links.map((l) => <a class="link-arrow" href={l.href}>{l.label} <span aria-hidden="true">&rarr;</span></a>)}
              </p>
            )}
          </div>

          <figure class="beat__fig reg rv" data-inview>
            {b.id === 'gap' && (
              <svg viewBox="0 0 360 230" class="fg" aria-hidden="true" focusable="false">
                <!-- shores -->
                <rect x="0" y="150" width="100" height="80" class="fg__shore" />
                <rect x="260" y="150" width="100" height="80" class="fg__shore" />
                <!-- river -->
                <g class="fg__wave">
                  <path d="M100 172q10 -6 20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0" />
                  <path d="M100 190q10 -6 20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0" />
                  <path d="M100 208q10 -6 20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0" />
                </g>
                <!-- paper floating in the river -->
                <g class="fg__sheet" transform="translate(118 158) rotate(-14)"><rect width="22" height="28" /><path d="M5 8h12M5 13h12M5 18h8" /></g>
                <g class="fg__sheet" transform="translate(152 176) rotate(10)"><rect width="22" height="28" /><path d="M5 8h12M5 13h12M5 18h8" /></g>
                <g class="fg__sheet" transform="translate(190 160) rotate(-6)"><rect width="22" height="28" /><path d="M5 8h12M5 13h12M5 18h8" /></g>
                <g class="fg__sheet" transform="translate(224 180) rotate(16)"><rect width="22" height="28" /><path d="M5 8h12M5 13h12M5 18h8" /></g>
                <!-- supplier stack -->
                <rect x="20" y="124" width="56" height="26" class="fg__sheet-r" />
                <rect x="24" y="112" width="56" height="26" class="fg__sheet-r" />
                <rect x="28" y="100" width="56" height="26" class="fg__sheet-r" />
                <path d="M36 108h38M36 114h38M36 120h24" class="fg__txt" />
                <!-- buyer stack -->
                <rect x="276" y="124" width="56" height="26" class="fg__sheet-r" />
                <rect x="280" y="112" width="56" height="26" class="fg__sheet-r" />
                <rect x="284" y="100" width="56" height="26" class="fg__sheet-r" />
                <path d="M292 108h6M302 108h30M292 114h6M302 114h30M292 120h6M302 120h20" class="fg__txt" />
                <!-- dimension line -->
                <path d="M100 150V82M260 150V82M104 90H256" class="fg__dim" />
                <path d="M104 90l7 -3v6zM256 90l-7 -3v6z" class="fg__dimah" />
                <rect x="150" y="80" width="60" height="20" class="fg__tab" />
                <text x="180" y="94" text-anchor="middle" class="fg__lbl fg__lbl--red">THE GAP</text>
                <text x="50" y="222" text-anchor="middle" class="fg__lbl">SUPPLIERS</text>
                <text x="310" y="222" text-anchor="middle" class="fg__lbl">BUYERS</text>
              </svg>
            )}

            {b.id === 'pillars' && (
              <svg viewBox="0 0 360 230" class="fg" aria-hidden="true" focusable="false">
                <rect x="0" y="150" width="100" height="80" class="fg__shore" />
                <rect x="260" y="150" width="100" height="80" class="fg__shore" />
                <g class="fg__wave">
                  <path d="M100 172q10 -6 20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0" />
                  <path d="M100 190q10 -6 20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0" />
                  <path d="M100 208q10 -6 20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0" />
                </g>
                <!-- cables -->
                <path d="M142 66L102 148M142 66L122 148M142 66L172 148M220 66L188 148M220 66L238 148M220 66L258 148" class="fg__cable" />
                <!-- pillars -->
                <polygon points="130,214 136,66 148,66 154,214" class="fg__pillar" />
                <path d="M133 100H151M132 130H152M131 160H153M131 190H153M133 100L151 130M151 100L133 130" class="fg__brace" />
                <polygon points="208,214 214,66 226,66 232,214" class="fg__pillar" />
                <path d="M211 100H229M210 130H230M209 160H231M209 190H231M211 100L229 130M229 100L211 130" class="fg__brace" />
                <rect x="132" y="60" width="20" height="6" class="fg__cap" />
                <rect x="210" y="60" width="20" height="6" class="fg__cap" />
                <!-- deck: the evidence engine -->
                <rect x="100" y="146" width="160" height="8" class="fg__deck" />
                <text x="142" y="46" text-anchor="middle" class="fg__lbl">TAS</text>
                <text x="220" y="46" text-anchor="middle" class="fg__lbl">EVALUATOR</text>
                <rect x="120" y="164" width="120" height="18" class="fg__tab" />
                <text x="180" y="177" text-anchor="middle" class="fg__lbl fg__lbl--brass">EVIDENCE ENGINE</text>
                <text x="50" y="222" text-anchor="middle" class="fg__lbl">SUPPLIERS</text>
                <text x="310" y="222" text-anchor="middle" class="fg__lbl">BUYERS</text>
              </svg>
            )}

            {b.id === 'long-game' && (
              <svg viewBox="0 0 360 230" class="fg" aria-hidden="true" focusable="false">
                <g class="fg__wave">
                  <path d="M0 202q10 -6 20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0" />
                  <path d="M0 216q10 -6 20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0" />
                </g>
                <!-- cables -->
                <path d="M90 72L34 146M90 72L62 146M90 72L118 146M90 72L146 146M180 72L124 146M180 72L152 146M180 72L208 146M180 72L236 146" class="fg__cable" />
                <path d="M288 72L232 146M288 72L260 146M288 72L316 146M288 72L344 146" class="fg__cable fg__dashed" />
                <!-- towers: two built, one aimed for -->
                <polygon points="78,224 84,72 96,72 102,224" class="fg__pillar" />
                <polygon points="168,224 174,72 186,72 192,224" class="fg__pillar" />
                <polygon points="276,224 282,72 294,72 300,224" class="fg__pillar fg__dashed" />
                <rect x="80" y="66" width="20" height="6" class="fg__cap" />
                <rect x="170" y="66" width="20" height="6" class="fg__cap" />
                <rect x="278" y="66" width="20" height="6" class="fg__cap fg__ghost" />
                <!-- deck: the evidence layer, solid to today, dashed beyond -->
                <path d="M0 150H180" class="fg__deckline" />
                <path d="M180 150H342" class="fg__deckline fg__dashed" />
                <path d="M340 142l14 8 -14 8z" class="fg__arrowh" />
                <rect x="4" y="124" width="124" height="18" class="fg__tab" />
                <text x="10" y="137" class="fg__lbl fg__lbl--brass">THE EVIDENCE LAYER</text>
                <!-- spans -->
                <text x="45" y="178" text-anchor="middle" class="fg__lbl">DEFENCE</text>
                <text x="135" y="178" text-anchor="middle" class="fg__lbl">SPACE</text>
                <text x="234" y="178" text-anchor="middle" class="fg__lbl fg__lbl--mute">LABS, PSUs</text>
                <text x="326" y="178" text-anchor="middle" class="fg__lbl fg__lbl--mute">MORE</text>
              </svg>
            )}
            <figcaption class="beat__cap mono">{b.fig}</figcaption>
          </figure>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .story__list {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem);
  }

  .beat {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(1.75rem, 5vw, 5rem);
    align-items: center;
  }

  .beat--flip .beat__txt {
    order: 2;
  }

  .beat__txt {
    display: grid;
    gap: 1rem;
    align-content: start;
    min-width: 0;
  }

  .beat__n {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--brass-ink);
  }

  .beat__n .mono:nth-child(1) {
    font-family: var(--f-serif);
    font-weight: 300;
    font-size: 2.4rem;
    letter-spacing: 0;
    color: var(--red);
    line-height: 1;
  }

  .beat__d {
    max-width: 34rem;
    color: var(--ink-2);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .beat__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 0.25rem;
  }

  .beat__fig {
    min-width: 0;
    padding: clamp(0.9rem, 2vw, 1.5rem);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .beat__cap {
    margin-top: 0.75rem;
    font-size: 0.625rem;
    color: var(--ink-3);
    line-height: 1.5;
    letter-spacing: 0.1em;
  }

  /* ----- drawings ----- */
  .fg {
    width: 100%;
    height: auto;
  }

  .fg__shore {
    fill: var(--paper-2);
    stroke: var(--navy);
    stroke-width: 1.4;
  }

  .fg__wave {
    fill: none;
    stroke: var(--steel);
    stroke-width: 1.2;
    opacity: 0.8;
  }

  .fg__sheet {
    fill: var(--card);
    stroke: var(--navy);
    stroke-width: 1.1;
  }

  .fg__sheet path {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1;
  }

  .fg__sheet-r {
    fill: var(--card);
    stroke: var(--navy);
    stroke-width: 1.2;
  }

  .fg__txt {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .fg__dim {
    fill: none;
    stroke: var(--red);
    stroke-width: 1.2;
  }

  .fg__dimah,
  .fg__arrowh {
    fill: var(--red);
  }

  .fg__arrowh {
    fill: var(--brass-ink);
  }

  .fg__tab {
    fill: var(--card);
  }

  .fg__lbl {
    font-family: var(--f-mono);
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.1em;
    fill: var(--ink-2);
  }

  .fg__lbl--red {
    fill: var(--red);
  }

  .fg__lbl--brass {
    fill: var(--brass-ink);
  }

  .fg__lbl--mute {
    fill: var(--ink-3);
  }

  .fg__cable {
    fill: none;
    stroke: var(--navy);
    stroke-width: 1;
    opacity: 0.7;
  }

  .fg__pillar {
    fill: var(--card);
    stroke: var(--navy);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .fg__brace {
    fill: none;
    stroke: var(--navy);
    stroke-width: 0.9;
    opacity: 0.55;
  }

  .fg__cap {
    fill: var(--brass);
  }

  .fg__deck {
    fill: var(--brass);
    stroke: var(--brass-ink);
    stroke-width: 1;
  }

  .fg__ground {
    stroke: var(--navy);
    stroke-width: 1.4;
  }

  .fg__pier {
    fill: none;
    stroke: var(--navy);
    stroke-width: 1.6;
  }

  .fg__deckline {
    fill: none;
    stroke: var(--brass);
    stroke-width: 7;
  }

  .fg__layer {
    fill: none;
    stroke: var(--brass-ink);
    stroke-width: 2;
  }

  .fg__tick {
    stroke: var(--ink-3);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }

  .fg__dashed {
    stroke-dasharray: 8 6;
    opacity: 0.75;
  }

  .fg__pillar.fg__dashed {
    stroke-dasharray: 5 4;
    fill: var(--paper);
  }

  .fg__ghost {
    opacity: 0.45;
  }

  @media (width <= 860px) {
    .beat {
      grid-template-columns: minmax(0, 1fr);
    }

    .beat--flip .beat__txt {
      order: 0;
    }
  }
</style>
