---
// Team.astro: the people. Ayush has a photograph; everyone else gets a
// monogram tile rather than an invented face. Titles are exactly as in the
// claims register: Ayush Tiwary, Founder and CEO; Anubhav Lal Dass,
// Co-founder and COO; core team Amit Kumar and Thushar Niranjan with no
// titles, and never described as co-founders.
const people = [
  {
    name: 'Ayush Tiwary',
    role: 'Founder and CEO',
    note: 'PG Diploma in AI-ML and Agentic AI Engineering, IIT Gandhinagar (2026).',
    photo: true,
    mono: 'AT',
  },
  { name: 'Anubhav Lal Dass', role: 'Co-founder and COO (joining full time on funding)', mono: 'AD' },
  { name: 'Amit Kumar', role: 'Core team', mono: 'AK' },
  { name: 'Thushar Niranjan', role: 'Core team', mono: 'TN' },
];
---
<section class="section team on-paper-2" id="team" aria-labelledby="team-title">
  <div class="wrap">
    <header class="section-head section-head--split">
      <p class="eyebrow">02 · The people</p>
      <h2 id="team-title" class="h2">A small team, <em>on the record.</em></h2>
      <p class="lead">Four people, named. Where there is a photograph we use it; where there is not, there is a monogram, never a stand-in face.</p>
    </header>

    <ul role="list" class="team__grid rv-stagger" data-inview>
      {people.map((p, i) => (
        <li class:list={['person', { 'person--lead': i === 0 }]}>
          <div class:list={['person__tile', 'reg', { 'person__tile--photo': p.photo }]}>
            {p.photo ? (
              <img
                src="/assets/photos/founder-ayush.png"
                width="600"
                height="557"
                loading="lazy"
                decoding="async"
                alt="Ayush Tiwary, founder and CEO of Kriseva, in a dark blazer and white shirt, smiling at the camera."
              />
            ) : (
              <span class="person__mono" aria-hidden="true">{p.mono}</span>
            )}
          </div>
          <div class="person__txt">
            <p class="mono person__k">{p.role}</p>
            <h3 class="person__n">{p.name}</h3>
            {p.note && <p class="person__d">{p.note}</p>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .team__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.85rem, 2vw, 1.5rem);
  }

  .person {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 1.25rem;
    min-width: 0;
    padding: 0.85rem 0.85rem 1.4rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .person__tile {
    position: relative;
    aspect-ratio: 1 / 1;
    background-color: var(--navy);
    background-image: repeating-linear-gradient(135deg, rgb(255 255 255 / 4%) 0 1px, transparent 1px 11px);
    --reg: rgb(210 166 96 / 70%);
  }

  .person__tile--photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .person__mono {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--f-serif);
    font-weight: 300;
    font-size: clamp(2.6rem, 2rem + 2vw, 3.8rem);
    letter-spacing: 0.02em;
    color: var(--brass-light);
    outline: 1px solid var(--brass);
    outline-offset: -10px;
  }

  .person__txt {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding-inline: 0.4rem;
    min-width: 0;
  }

  .person__k {
    color: var(--brass-ink);
  }

  .person__n {
    font-family: var(--f-serif);
    font-weight: 400;
    font-size: clamp(1.3rem, 1.15rem + 0.5vw, 1.55rem);
    line-height: 1.15;
  }

  .person__d {
    margin-top: 0.3rem;
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--ink-2);
  }

  @media (width <= 980px) {
    .team__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width <= 560px) {
    .team__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .person {
      grid-template-columns: 112px minmax(0, 1fr);
      grid-template-rows: none;
      align-items: center;
      padding: 0.75rem;
    }

    .person--lead {
      align-items: start;
    }

    .person__mono {
      font-size: 2.2rem;
      outline-offset: -6px;
    }
  }
</style>
