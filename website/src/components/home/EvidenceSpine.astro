---
// EvidenceSpine.astro
//
// Homepage signature visual, corporate site v2
// (CORPORATE_SITE_V2_ARCHITECTURE.md §6). STATIC ONLY: inline SVG plus CSS,
// zero JavaScript, reads fully under prefers-reduced-motion. The scrubbed
// scroll choreography is explicitly Phase 4 / W12 and is not built here
// (D-008: reduced motion is a designed static art direction, not a
// degraded mode; the static composition must be strong enough to ship
// alone).
//
// One abstract field value ("FIELD 12") travels six stations. All station
// data below (checksums, path values, reviewer line, verdict) is
// illustrative furniture around the real claim, never a real record: the
// substantive statement at every station is `station.description`, read
// verbatim from the registered capabilityV2.* claim via spineStations
// (src/data/company.ts). Brass is reserved for exactly two moments per the
// architecture: the SOURCE seal and the HUMAN REVIEW signature. Every other
// station uses ink only, or the muted flag tone at CONFLICT.

import { spineStations } from '../../data/company';
import { getClaim } from '../../data/publicClaims';
import type { SpineStationId } from '../../data/company';

function claim(id: string): string {
  const c = getClaim(id);
  if (!c) {
    throw new Error(`EvidenceSpine: expected registered claim "${id}" in publicClaims.ts`);
  }
  return c.wording;
}

// Six-state vocabulary shown as small print at the DECISION station. State
// names match the evaluator.six-state claim caveat (publicClaims.ts); the
// claim's own sentence documents the auto-route behaviour for the two
// uncertain states and is cited in the aria description below.
void claim('evaluator.six-state');
const sixStates = ['Verified', 'Qualified', 'Insufficient', 'Missing', 'Requires demonstration', 'Failed'];

type SpineItem =
  | { kind: 'connector' }
  | { kind: 'station'; index: number; id: SpineStationId; label: string; description: string };

const spineItems: SpineItem[] = spineStations.flatMap((station, i) => {
  const item: SpineItem = {
    kind: 'station',
    index: i + 1,
    id: station.id,
    label: station.label,
    description: station.description,
  };
  return i === 0 ? [item] : [{ kind: 'connector' as const }, item];
});

// Prose walkthrough for the SVG's text-alternative (architecture §14 a11y):
// walks the six stations in order for assistive tech / non-visual readers.
const proseWalkthrough = spineStations
  .map((s, i) => `${i + 1}. ${s.label}. ${s.description}`)
  .join(' ');

const stationLabels = spineStations.map((s) => s.label);
const sectorRows = [
  { sector: 'Defense procurement', input: 'Tender bundle', output: 'Bid decision' },
  { sector: 'Regulated finance', input: 'Source records', output: 'Filed return' },
];
---

<section class="evidence-spine" aria-labelledby="spine-heading">
  <div class="container">
    <div class="evidence-spine__head">
      <p class="mono-eyebrow">
        <span class="dot-brass" aria-hidden="true"></span>
        The evidence spine
      </p>
      <h2 id="spine-heading" class="evidence-spine__headline">
        One field value. Six checkpoints. One named human at the end.
      </h2>
      <p class="evidence-spine__dek">
        A single abstract field crosses the same six stations in every system we build. The values
        below are illustrative, not a real record.
      </p>
    </div>

    <svg class="sr-only" width="0" height="0" aria-hidden="true">
      <title id="spine-svg-title">The KRISEVA evidence spine</title>
    </svg>

    <ol
      class="spine"
      role="list"
      aria-label="The evidence spine: six stations a field value passes through"
      aria-describedby="spine-desc"
    >
      {spineItems.map((item) =>
        item.kind === 'connector' ? (
          <li class="spine__connector" aria-hidden="true">
            <span class="spine__connector-arrow">&rarr;</span>
          </li>
        ) : (
          <li class="spine__station" data-station={item.id}>
            <div class="spine__plate">
              <div class="spine__plate-head">
                <span class="spine__index">{String(item.index).padStart(2, '0')}</span>
                <span class="spine__label">{item.label}</span>
              </div>

              <div class="spine__icon" aria-hidden="true">
                {item.id === 'source' && (
                  <svg viewBox="0 0 64 64" focusable="false">
                    <rect x="12" y="6" width="30" height="40" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6" />
                    <line x1="18" y1="16" x2="36" y2="16" stroke="currentColor" stroke-width="1.2" />
                    <line x1="18" y1="22" x2="36" y2="22" stroke="currentColor" stroke-width="1.2" />
                    <line x1="18" y1="28" x2="30" y2="28" stroke="currentColor" stroke-width="1.2" />
                    <circle cx="42" cy="42" r="10" fill="none" stroke="var(--accent-primary)" stroke-width="1.6" />
                    <path d="M37.5 42 L40.5 45.5 L47 38" fill="none" stroke="var(--accent-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {item.id === 'evidence' && (
                  <svg viewBox="0 0 64 64" focusable="false">
                    <rect x="4" y="18" width="18" height="28" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                    <line x1="8" y1="26" x2="18" y2="26" stroke="currentColor" stroke-width="1" />
                    <line x1="8" y1="32" x2="18" y2="32" stroke="currentColor" stroke-width="1" />
                    <path d="M22 24 C34 24 40 16 56 16" fill="none" stroke="currentColor" stroke-width="1.3" />
                    <path d="M22 32 C34 32 40 32 56 32" fill="none" stroke="currentColor" stroke-width="1.3" />
                    <path d="M22 40 C34 40 40 48 56 48" fill="none" stroke="currentColor" stroke-width="1.3" />
                    <circle cx="57" cy="16" r="2.2" fill="currentColor" />
                    <circle cx="57" cy="32" r="2.2" fill="currentColor" />
                    <circle cx="57" cy="48" r="2.2" fill="currentColor" />
                  </svg>
                )}
                {item.id === 'conflict' && (
                  <svg viewBox="0 0 64 64" focusable="false">
                    <rect x="8" y="14" width="34" height="5" rx="1" fill="currentColor" />
                    <rect x="8" y="27" width="34" height="5" rx="1" fill="currentColor" />
                    <rect x="8" y="40" width="20" height="5" rx="1" fill="var(--spine-flag)" />
                    <circle cx="52" cy="42.5" r="6.5" fill="none" stroke="var(--spine-flag)" stroke-width="1.5" />
                    <line x1="49.4" y1="40" x2="54.6" y2="45.2" stroke="var(--spine-flag)" stroke-width="1.4" stroke-linecap="round" />
                    <line x1="54.6" y1="40" x2="49.4" y2="45.2" stroke="var(--spine-flag)" stroke-width="1.4" stroke-linecap="round" />
                  </svg>
                )}
                {item.id === 'human-review' && (
                  <svg viewBox="0 0 64 64" focusable="false">
                    <rect x="8" y="8" width="48" height="32" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6" />
                    <line x1="14" y1="18" x2="42" y2="18" stroke="currentColor" stroke-width="1.1" />
                    <line x1="14" y1="25" x2="36" y2="25" stroke="currentColor" stroke-width="1.1" />
                    <path
                      d="M12 52 C16 46 20 56 24 50 C28 44 32 54 36 48 C39 44 42 50 46 46"
                      fill="none"
                      stroke="var(--accent-primary)"
                      stroke-width="1.7"
                      stroke-linecap="round"
                    />
                  </svg>
                )}
                {item.id === 'decision' && (
                  <svg viewBox="0 0 64 64" focusable="false">
                    <rect x="8" y="20" width="48" height="24" rx="12" fill="none" stroke="currentColor" stroke-width="1.6" />
                    <circle cx="32" cy="32" r="4.5" fill="currentColor" />
                  </svg>
                )}
                {item.id === 'retained-record' && (
                  <svg viewBox="0 0 64 64" focusable="false">
                    <rect x="10" y="8" width="44" height="8" rx="1" fill="none" stroke="currentColor" stroke-width="1.4" />
                    <rect x="10" y="28" width="44" height="8" rx="1" fill="none" stroke="currentColor" stroke-width="1.4" />
                    <rect x="10" y="48" width="44" height="8" rx="1" fill="none" stroke="currentColor" stroke-width="1.4" />
                    <line x1="32" y1="16" x2="32" y2="28" stroke="currentColor" stroke-width="1.4" />
                    <line x1="32" y1="36" x2="32" y2="48" stroke="currentColor" stroke-width="1.4" />
                  </svg>
                )}
              </div>

              <p class="spine__description">{item.description}</p>

              <div class="spine__furniture">
                {item.id === 'source' && (
                  <>
                    <p class="spine__field">FIELD 12 &middot; SEALED</p>
                    <p class="spine__mono-note">CHECKSUM 4C9F&middot;A031</p>
                  </>
                )}
                {item.id === 'evidence' && (
                  <ul class="spine__paths">
                    <li><span>PATH A</span><span>0.82</span></li>
                    <li><span>PATH B</span><span>0.82</span></li>
                    <li><span>PATH C</span><span>0.61</span></li>
                  </ul>
                )}
                {item.id === 'conflict' && (
                  <>
                    <span class="spine__chip spine__chip--flag">FIELD 12 &middot; CONFLICTING</span>
                    <p class="spine__mono-note">Path C diverges from A and B.</p>
                  </>
                )}
                {item.id === 'human-review' && (
                  <>
                    <p class="spine__mono-note">REVIEWER &middot; Assigned</p>
                    <p class="spine__mono-note">REASON &middot; Path C exceeds tolerance</p>
                  </>
                )}
                {item.id === 'decision' && (
                  <>
                    <span class="spine__chip">FIELD 12 &middot; QUALIFIED</span>
                    <p class="spine__mono-note spine__mono-note--wrap">
                      Six-state vocabulary &middot; {sixStates.join(' · ')}
                    </p>
                  </>
                )}
                {item.id === 'retained-record' && (
                  <p class="spine__mono-note">MANIFEST ENTRY &middot; FIELD 12</p>
                )}
              </div>
            </div>
          </li>
        )
      )}
    </ol>

    <p id="spine-desc" class="sr-only">
      Six-station evidence spine, walked in order. {proseWalkthrough}
    </p>

    <div class="spine-instantiation">
      <p class="mono-eyebrow spine-instantiation__kicker">One architecture, two sectors</p>
      {sectorRows.map((row) => (
        <div class="spine-instantiation__row">
          <span class="spine-instantiation__sector">{row.sector}</span>
          <span class="spine-instantiation__bound">{row.input}</span>
          <ol class="spine-instantiation__mid" aria-hidden="true">
            {stationLabels.map((label) => (
              <li>{label}</li>
            ))}
          </ol>
          <span class="spine-instantiation__bound spine-instantiation__bound--out">{row.output}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .evidence-spine {
    /* Muted warm-ink flag tone for the CONFLICT station only; reuses the
       existing decision-skip / state-warn hue at full opacity rather than a
       fresh red, so the one alert moment on the page stays in the site's
       established restrained palette. Never brass (architecture §6). */
    --spine-flag: #8a352c;
    padding: clamp(80px, 9vw, 132px) 0;
    background: var(--surface-paper);
    color: var(--ink-primary);
    border-top: var(--rule-paper);
  }

  .evidence-spine__head { max-width: 62ch; }
  .evidence-spine__headline {
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--surface-deep);
    font-size: clamp(1.9rem, 1.5rem + 1.8vw, 3rem);
    line-height: 1.16;
    letter-spacing: -0.012em;
    max-width: 20ch;
    text-wrap: balance;
  }
  .evidence-spine__dek {
    margin-top: 16px;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-secondary);
    max-width: 56ch;
  }

  /* ---------- the spine ---------- */
  .spine {
    margin-top: clamp(44px, 6vw, 68px);
    display: flex;
    flex-direction: column;
    overflow-x: visible;
  }
  @media (min-width: 1024px) {
    .spine { flex-direction: row; align-items: stretch; }
  }

  .spine__connector {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-quiet);
    padding: 6px 0;
  }
  .spine__connector-arrow {
    display: inline-block;
    font-size: 1.1rem;
    transform: rotate(90deg);
  }
  @media (min-width: 1024px) {
    .spine__connector { flex: 0 0 30px; padding: 0; }
    .spine__connector-arrow { transform: none; }
  }

  .spine__station { min-width: 0; }
  @media (min-width: 1024px) {
    .spine__station { flex: 1 1 0; }
  }

  .spine__plate {
    height: 100%;
    background: var(--surface-paper-rise);
    border: 1px solid rgba(16, 35, 59, 0.16);
    border-radius: var(--radius-panel);
    padding: 18px 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .spine__plate-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .spine__index {
    font-family: var(--font-mono);
    font-size: var(--text-discipline);
    letter-spacing: 0.1em;
    color: var(--ink-quiet);
  }
  .spine__label {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--surface-deep);
  }

  .spine__icon { color: var(--ink-primary); opacity: 0.92; }
  .spine__icon svg { width: 46px; height: 46px; display: block; }

  .spine__description {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-secondary);
    flex: 1 0 auto;
  }

  .spine__furniture {
    border-top: 1px dashed rgba(16, 35, 59, 0.16);
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .spine__field {
    font-family: var(--font-mono);
    font-size: var(--text-discipline);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-primary);
  }
  .spine__mono-note {
    font-family: var(--font-mono);
    font-size: var(--text-discipline);
    letter-spacing: 0.04em;
    color: var(--ink-quiet);
    line-height: 1.55;
  }
  .spine__mono-note--wrap { text-transform: none; letter-spacing: 0.02em; }

  .spine__paths { display: flex; flex-direction: column; gap: 4px; }
  .spine__paths li {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: var(--text-discipline);
    letter-spacing: 0.06em;
    color: var(--ink-quiet);
  }
  .spine__paths li span:last-child {
    font-variant-numeric: tabular-nums;
    color: var(--ink-primary);
  }

  .spine__chip {
    display: inline-flex;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: var(--text-discipline);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-primary);
    border: 1px solid rgba(16, 35, 59, 0.28);
    border-radius: var(--radius-badge);
    padding: 4px 9px;
  }
  .spine__chip--flag {
    color: var(--spine-flag);
    border-color: var(--spine-flag);
    background: rgba(138, 53, 44, 0.06);
  }

  /* ---------- sector instantiation strip ---------- */
  .spine-instantiation { margin-top: clamp(52px, 6vw, 84px); }
  .spine-instantiation__kicker { color: var(--accent-soft); }
  .spine-instantiation__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 4px;
    padding: 16px 0;
    border-top: var(--rule-paper);
  }
  .spine-instantiation__row:last-child { border-bottom: var(--rule-paper); }
  .spine-instantiation__sector {
    flex: 0 0 auto;
    width: 100%;
    font-family: var(--font-serif);
    font-size: 1.06rem;
    color: var(--surface-deep);
    margin-bottom: 4px;
  }
  .spine-instantiation__bound {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-primary);
    border: 1px solid rgba(16, 35, 59, 0.28);
    border-radius: var(--radius-badge);
    padding: 6px 11px;
  }
  .spine-instantiation__bound--out { color: var(--accent-soft); border-color: var(--accent-line); }
  .spine-instantiation__mid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    flex: 1 1 auto;
    min-width: 220px;
  }
  .spine-instantiation__mid li {
    font-family: var(--font-mono);
    font-size: var(--text-discipline);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-quiet);
    white-space: nowrap;
  }
  .spine-instantiation__mid li:not(:last-child)::after {
    content: "\2192";
    display: inline-block;
    margin: 0 6px;
    color: var(--ink-quiet);
    opacity: 0.6;
  }

  @media (max-width: 640px) {
    .spine-instantiation__mid { min-width: 0; }
  }
</style>
