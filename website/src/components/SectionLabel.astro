---
export interface Props {
  as?: 'span' | 'p';
  tone?: 'brass' | 'muted';
  class?: string;
}
const { as = 'span', tone = 'brass', class: className = '' } = Astro.props;
const Tag = as;
---
<Tag class:list={['section-label', `section-label--${tone}`, className]}>
  <slot />
</Tag>

<style is:global>
  .section-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .section-label--brass { color: var(--brass); }
  .section-label--muted { color: var(--slate-600); }
  /* Contrast fix (Phase 5): --brass-soft (same hex as --accent-soft)
     measures ~2.87-3.11:1 on --surface-paper/--surface-paper-rise -
     below the 4.5:1 floor. This is the default eyebrow on nearly every
     route page (defense/finance/attest/capabilities all use
     <SectionLabel> with no tone override), so the fix here covers every
     paper-section instance sitewide. AA-safe brass cut, same family as
     the N2 MaturityChip/EvidenceCard correction. */
  .section--paper .section-label--brass { color: var(--accent-text-safe, #91601c); }
</style>
