---
// V6Footer.astro - shared footer for v6 inner pages.
// Three standing lines (entity, no-endorsement, synthetic-data) plus a
// quiet route row so no page is an orphan. Wording mirrors the homepage
// footer and boundary.notClaimed in publicClaims.ts.
//
// X5: the audit strip. The site keeps its own ledger: build date, the
// commit it was built from, and the claims-register revision its copy
// traces to. Generated at build time, never at runtime.
import { execSync } from 'node:child_process';
const git = (cmd: string) => {
  try { return execSync(cmd).toString().trim(); } catch { return 'untracked'; }
};
const buildSha = git('git rev-parse --short HEAD');
const claimsSha = git('git log -1 --format=%h -- src/data/publicClaims.ts');
const buildDate = new Date().toISOString().slice(0, 10);
---
<footer class="v6">
  <div class="foot">
    <span>KRISEVA AI Private Limited</span>
    <span>No military or government endorsement claimed or implied.<br />Product visuals are synthetic / seeded demo data, not a real tender.</span>
    <span>Deterministic · Auditable · Evidence-linked · Sovereign-by-design<br />www.kriseva.in</span>
  </div>
  <div class="foot strip-x5">
    <span>This site keeps its own ledger · build {buildDate} · commit {buildSha}</span>
    <span>copy traces to publicClaims.ts @ {claimsSha}</span>
    <span><a href="/dossier.pdf">Dossier · PDF · no email gate</a></span>
  </div>
  <nav class="foot-nav" aria-label="Footer">
    <a href="/">Home</a>
    <a href="/tas">TAS</a>
    <a href="/evaluator">Evaluator</a>
    <a href="/workflow">Workflow</a>
    <a href="/security">The Boundary</a>
    <a href="/validation">Validation</a>
    <a href="/founder">Founder</a>
    <a href="/contact">Contact</a>
  </nav>
</footer>
<style>
  .strip-x5{border-top:1px solid rgba(231,225,208,.15);padding-top:16px}
  .strip-x5 span{overflow-wrap:anywhere}
  .strip-x5 a{color:inherit;text-decoration:none;border-bottom:1px solid rgba(231,225,208,.35)}
</style>
