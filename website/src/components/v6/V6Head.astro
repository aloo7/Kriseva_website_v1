---
// V6Head.astro - shared <head> for v6 inner pages.
// Meta, fonts, canonical, OG, and JSON-LD (Organization on every page,
// plus optional page-level schema objects passed via `schema`).
//
// The homepage stays self-contained; keep this in lockstep with its head.

import { getOrganizationSchema } from '../../data/organizationSchema';

interface Props {
  title: string;
  description: string;
  /** Route path beginning with '/', e.g. '/evaluator' */
  path: string;
  /** Extra JSON-LD objects (e.g. SoftwareApplication on product pages). */
  schema?: Record<string, unknown>[];
}

const { title, description, path, schema = [] } = Astro.props;

// Canonical host. The apex kriseva.in DNS is dead (NXDOMAIN, audit
// 2026-06-12); www is the only host that resolves.
// TODO(founder): when apex DNS is fixed and a canonical host is chosen,
// flip this single constant (and the homepage head + sitemap + robots).
const SITE = 'https://www.kriseva.in';

const canonical = SITE + (path === '/' ? '/' : path);
// X8: per-page OG images, generated at build by scripts/render-og-pages.mjs
// into public/og/<slug>.png on brand tokens. Home keeps /og.png.
const slug = path === '/' ? '' : path.replace(/^\//, '').replace(/\//g, '-');
const ogImage = SITE + (slug ? `/og/${slug}.png` : '/og.png');

const organization = getOrganizationSchema();

const blocks = [organization, ...schema];
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#DED6C9" />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="KRISEVA AI" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<link rel="icon" type="image/svg+xml" href="/assets/v6/favicon.svg" />
{blocks.map((b) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(b)} />
))}
<!-- Three faces, self-hosted: Instrument Serif / IBM Plex Sans / IBM Plex Mono.
     No third-party font host; zero runtime egress (Phase 4 contract).
     @font-face is inlined (no render-blocking stylesheet request) and the
     above-the-fold cuts are preloaded so first paint lands in the webfont. -->
<link rel="preload" as="font" type="font/woff2" href="/fonts/instrument-serif-latin-400-normal.woff2" crossorigin />
<link rel="preload" as="font" type="font/woff2" href="/fonts/instrument-serif-latin-400-italic.woff2" crossorigin />
<link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-sans-latin-400-normal.woff2" crossorigin />
<link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-mono-latin-400-normal.woff2" crossorigin />
<link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-mono-latin-500-normal.woff2" crossorigin />
<style is:inline>
@font-face{font-family:'Instrument Serif';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/instrument-serif-latin-400-normal.woff2') format('woff2')}
@font-face{font-family:'Instrument Serif';font-style:italic;font-weight:400;font-display:swap;src:url('/fonts/instrument-serif-latin-400-italic.woff2') format('woff2')}
@font-face{font-family:'IBM Plex Sans';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/ibm-plex-sans-latin-400-normal.woff2') format('woff2')}
@font-face{font-family:'IBM Plex Sans';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/ibm-plex-sans-latin-500-normal.woff2') format('woff2')}
@font-face{font-family:'IBM Plex Sans';font-style:normal;font-weight:600;font-display:swap;src:url('/fonts/ibm-plex-sans-latin-600-normal.woff2') format('woff2')}
@font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/ibm-plex-mono-latin-400-normal.woff2') format('woff2')}
@font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/ibm-plex-mono-latin-500-normal.woff2') format('woff2')}
@font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:600;font-display:swap;src:url('/fonts/ibm-plex-mono-latin-600-normal.woff2') format('woff2')}
</style>
<script is:inline>document.documentElement.classList.remove('no-js');document.documentElement.classList.add('js');</script>
