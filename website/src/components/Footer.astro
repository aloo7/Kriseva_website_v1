---
import { footerGroups } from '../data/navigation';
import { site } from '../data/site';
import { routes } from '../data/routes';
import { getClaim } from '../data/publicClaims';

const year = new Date().getFullYear();
// boundary.notClaimed is verified-and-safe, wording locked, paraphrase
// forbidden (docs/PUBLIC_CLAIMS_REGISTER.md #32). Rendered byte-identically
// from the claim id per Gate 1 correction M1: the previous inline text
// dropped "military" and prefixed an uncredited "Claims reflect verified
// product capabilities" fragment that matches no registered claim.
const notClaimed = getClaim('boundary.notClaimed')!.wording;
---
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__cols">
      <div class="footer__brand">
        <img
          src="/assets/brand/kriseva-lockup-horizontal-light.svg"
          alt={site.name}
          height="24"
          width="148"
          loading="lazy"
        />
        <p class="footer__tag">{site.shortPositioning}</p>
        <p class="footer__legal">{site.legalName}</p>
      </div>

      <div class="footer__nav-groups">
        {footerGroups.map((group) => (
          <div class="footer__group">
            <p class="footer__heading">{group.heading}</p>
            <ul class="footer__list">
              {group.items.map(({ href, label }) => (
                <li><a href={href}>{label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="footer__contact">
        <p class="footer__heading">Contact</p>
        <ul class="footer__list">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={routes.contact}>Contact Founder</a></li>
          <li><a href={routes.contactWithIntent('demo')}>Book Demo</a></li>
          <li><a href={routes.contactWithIntent('pilot')}>Join Pilot</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__rule" />

    <div class="footer__bottom">
      <p>© {year} {site.legalName}</p>
      <p class="footer__discipline">
        {notClaimed}
      </p>
    </div>
  </div>
</footer>

<style>
  /* Gate 3 blocker fix: fallback-chain values matching Header.astro's own
     note above (MaturityChip.astro precedent) - this component now renders
     inside V6Layout too, whose tokens-v6.css defines none of these role
     names. Literal fallbacks are copied from tokens.css's resolved values
     so the footer renders identically either way. */
  .container {
    max-width: var(--max-w, 1200px);
    margin: 0 auto;
    padding: 0 var(--gutter, 32px);
  }
  @media (max-width: 1024px) {
    .container { padding: 0 var(--gutter, 28px); }
  }
  @media (max-width: 768px) {
    .container { padding: 0 var(--gutter, 18px); }
  }

  .footer {
    background: var(--surface-deep, #04112a);
    color: var(--text-secondary, #e5dcc9);
    border-top: var(--rule-edge, 1px solid rgba(193, 138, 62, 0.34));
    position: relative;
  }
  /* Faint brass top stripe · picks up the dossier-tab idiom from the
     identity card without making it loud. */
  .footer::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--accent-primary, #c18a3e) 24%,
      var(--accent-primary, #c18a3e) 76%,
      transparent 100%
    );
    opacity: 0.32;
  }
  .footer__inner { padding: 64px 0 32px; }
  .footer__cols {
    display: grid;
    grid-template-columns: 1.4fr 3fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .footer__nav-groups {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  @media (max-width: 900px) {
    .footer__cols { grid-template-columns: 1fr 2fr 1fr; gap: 36px; }
    .footer__nav-groups { grid-template-columns: repeat(2, 1fr); gap: 24px 32px; }
  }
  @media (max-width: 768px) {
    .footer__cols { grid-template-columns: 1fr 1fr; gap: 36px; }
    .footer__nav-groups { grid-column: 1 / -1; grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 480px) {
    .footer__cols { grid-template-columns: 1fr; }
    .footer__nav-groups { grid-template-columns: repeat(2, 1fr); }
  }
  .footer__tag {
    font-family: var(--font-mono, "IBM Plex Mono", SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace);
    font-size: 0.72rem;
    color: var(--text-quiet-on-navy, #97a3b4); /* AA on the navy ground */
    line-height: 1.6;
    margin: 14px 0 8px;
  }
  .footer__legal {
    font-size: 0.78rem;
    color: var(--text-quiet-on-navy, #97a3b4); /* AA on the navy ground */
  }
  .footer__heading {
    font-family: var(--font-mono, "IBM Plex Mono", SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: var(--accent-primary, #c18a3e);
    text-transform: uppercase;
    margin-bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  /* The decision dot · brand-mark callback applied to footer headings. */
  .footer__heading::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent-primary, #c18a3e);
    flex-shrink: 0;
  }
  .footer__list { display: flex; flex-direction: column; gap: 10px; }
  .footer__list a {
    font-size: 0.86rem;
    color: var(--text-secondary, #e5dcc9);
    transition: color var(--micro, 140ms ease-out), padding-left var(--micro, 140ms ease-out);
  }
  .footer__list a:hover {
    color: var(--accent-primary, #c18a3e);
    padding-left: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__list a:hover { padding-left: 0; }
  }

  .footer__rule {
    border-top: 1px solid rgba(193, 138, 62, 0.12);
    margin: 32px 0 20px;
  }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.74rem;
    color: var(--text-quiet-on-navy, #97a3b4); /* AA on the navy ground */
  }
  .footer__discipline {
    font-family: var(--font-mono, "IBM Plex Mono", SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
  }
</style>
