---
// /security - "The Boundary". Local-first posture, Zone I / Zone II
// interactive (ported from the v6 homepage), boundary capture plate.
// Careful wording only: the approved line is "Local-first. Zero silent
// egress." No absolute-security claims (register security.do-not-claim).

import V6Layout from '../layouts/V6Layout.astro';
import SectionHead from '../components/v6/SectionHead.astro';
import Plate from '../components/v6/Plate.astro';
import { getClaim } from '../data/publicClaims';

const localFirst = getClaim('security.local-first')!.wording;
const localRoutes = getClaim('security.local-routes')!.wording;
const boundaryReview = getClaim('security.boundary')!.wording;

const title = 'The Boundary · Local-first. Zero silent egress.';
const description = localFirst + ' The deployment boundary is documented, not assumed.';
---
<V6Layout title={title} description={description} path="/security">

  <!-- ============ HERO ============ -->
  <section class="ihero" aria-label="The Boundary">
    <div class="wrap">
      <p class="eyebrow">The Boundary · sovereign by design</p>
      <h1 class="display">Local-first.<br /><em class="em-brass">Zero silent egress.</em></h1>
      <p class="dek">{localFirst}</p>
      <div class="ihero-meta" aria-label="Posture">
        <span>Boundaries <b>documented</b>, not assumed</span>
        <span>No absolute-security claims</span>
        <span>Dashed means crossable, by design</span>
      </div>
    </div>
  </section>

  <!-- ============ ZONE I / ZONE II ============ -->
  <section class="sec-pad" id="zones" style="padding-top:clamp(30px,4vw,56px)">
    <div class="wrap">
      <SectionHead eyebrow="The map · select an asset" folio="§01 / 04"
        dek="Select any asset to see whether it stays inside the deployment, or crosses an explicit, documented, operator-triggered boundary. Dashed means crossable. Tender contents never leave.">
        Two zones. <em class="em-brass">One line.</em>
      </SectionHead>
      <div class="bgrid rv">
        <div>
          <div class="zone regmark">
            <div class="zh">Zone I · inside the customer network</div>
            <div class="assets" id="assetsIn"></div>
          </div>
          <div class="zone zone-egress">
            <div class="zh">Across the line · explicit, documented egress</div>
            <div class="assets" id="assetsOut"></div>
          </div>
        </div>
        <div class="bdetail" id="bdetail" aria-live="polite">
          <span class="tag inside">Inside the boundary</span>
          <p>Select an asset to see exactly where it lives, and whether anything about it crosses the line.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BOUNDARY PLATE ============ -->
  <section class="sec-pad sec-navy" id="plate">
    <div class="wrap">
      <SectionHead eyebrow="Field evidence · the product says it itself" folio="§02 / 04"
        dek="The Boundary is a page inside the product, not a paragraph on a website. Zone II refusals are listed where the operator works.">
        Refused at the <em class="em-brass">architecture.</em>
      </SectionHead>
      <div style="max-width:780px;margin-inline:auto">
        <Plate kicker="TAS" head="06 · The Boundary · Zone II" meta="disclosure"
          src="/assets/v6/console_boundary_zones.jpg" width={1352} height={480}
          alt="KRISEVA TAS Boundary page, Zone II: refused at the architecture. The product's own refusal list: cloud LLM APIs, hosted vector databases, SaaS analytics and telemetry, foreign-hosted inference, telemetry beacons, and document contents leaving the network"
          capLeft="Zone II: refused at the architecture, listed in the product" class="rv" />
      </div>
      <p class="disclose wrap" style="text-align:center">Synthetic / seeded demo data, not a real tender.</p>
    </div>
  </section>

  <!-- ============ THE CAREFUL WORDING ============ -->
  <section class="sec-pad" id="wording">
    <div class="wrap">
      <SectionHead eyebrow="The careful wording · on the record" folio="§03 / 04"
        dek="Security wording on this site comes from a maintained claims register. The careful lines ship exactly as approved; the absolutes are refused.">
        No absolutes. <em class="em-brass">On purpose.</em>
      </SectionHead>
      <div class="record rv">
        <div class="rec"><span class="date">Posture</span><span class="what">{localFirst}</span><span class="tag">safe-with-care</span></div>
        <div class="rec"><span class="date">Models</span><span class="what">{localRoutes}</span><span class="tag">safe-with-care</span></div>
        <div class="rec"><span class="date">Review</span><span class="what">{boundaryReview}</span><span class="tag">per deployment</span></div>
      </div>
      <div class="refusals rv regmark">
        <span class="eyebrow">What this page will not say</span>
        <p>Absolute-security framing of any kind. The claims register maintains a literal banned-phrase list and the build fails if one ships. A security page that overclaims is a security risk of its own.</p>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="sec-pad sec-sunk" id="cta">
    <div class="wrap">
      <SectionHead eyebrow="Next step" folio="§04 / 04"
        dek="Deployment boundaries are reviewed per environment, with your security team in the room.">
        Review the boundary <em class="em-brass">with us.</em>
      </SectionHead>
      <div class="acts rv" style="display:flex;flex-wrap:wrap;gap:14px">
        <a class="btn btn-fill" href="/contact">Speak with the founder <span class="arr">→</span></a>
        <a class="btn btn-line" href="/evaluator">The Evaluator posture</a>
      </div>
    </div>
  </section>

</V6Layout>

<style is:global>
/* /security page-specific - zones (ported from the v6 homepage) */
.bgrid{display:grid;grid-template-columns:minmax(0,7fr) minmax(280px,5fr);gap:clamp(24px,4vw,64px);align-items:start}
.zone{border:1px solid var(--ink);border-radius:2px;padding:clamp(16px,2.4vw,28px);background:var(--paper-raised)}
.zone .zh{font-family:var(--mono);font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;
  color:var(--ink-sec);margin-bottom:16px;display:flex;align-items:center;gap:10px}
.zone .zh::before{content:"";width:8px;height:8px;background:var(--ink);border-radius:1px}
.zone-egress{border-style:dashed;border-color:var(--ink-sec);background:transparent;margin-top:18px}
.zone-egress .zh::before{background:none;border:1px dashed var(--ink-sec)}
.assets{display:flex;flex-wrap:wrap;gap:10px}
.asset{font-family:var(--mono);font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;
  padding:10px 14px;border:1px solid var(--rule);border-radius:2px;background:var(--paper);
  transition:border-color .2s,background .2s;text-align:left}
.asset:hover{border-color:var(--ink)}
.asset[aria-pressed="true"]{background:var(--ink);color:var(--paper-raised);border-color:var(--ink)}
.zone-egress .asset{border-style:dashed;background:transparent}
.bdetail{padding:20px;border:1px solid var(--rule);border-radius:2px;background:var(--paper-raised);
  min-height:170px;position:sticky;top:96px}
.bdetail .tag{display:inline-block;font-family:var(--mono);font-size:.56rem;letter-spacing:.16em;
  text-transform:uppercase;font-weight:600;padding:4px 10px;border-radius:2px;margin-bottom:12px}
.bdetail .tag.inside{background:rgba(58,122,91,.14);color:var(--vt-verified);border:1px solid rgba(58,122,91,.4)}
.bdetail .tag.out{background:transparent;color:var(--ink-sec);border:1px dashed var(--ink-sec)}
.bdetail p{font-size:.92rem;line-height:1.6;color:var(--ink-sec)}
.bdetail b{color:var(--ink);font-weight:600}
@media (max-width:1080px){.bgrid{grid-template-columns:1fr}.bdetail{position:static}}

.refusals{margin-top:34px;border:1px dashed var(--ink-sec);border-radius:2px;padding:clamp(18px,2.6vw,28px);
  background:transparent}
.refusals p{margin-top:10px;font-size:.96rem;line-height:1.7;color:var(--ink-sec);max-width:68ch}
</style>

<script is:inline>
// The Boundary: Zone I / Zone II selector. Ported from the v6 homepage;
// asset wording is the founder-signed corpus.
(function () {
  var inside = [
    { n: 'Tender bundles', d: 'Stored in the local database and filesystem inside the deployment. Contents never leave.' },
    { n: 'Document parsing', d: 'PDF / DOCX / XLSX parsing and OCR run locally; no document is sent to a third party.' },
    { n: 'LLM inference', d: 'On-premise, local model routes. No cloud LLM, no foreign-hosted inference.' },
    { n: 'Audit log', d: 'The hash-chained event log lives in the local database, mutation-blocked at the database.' },
    { n: 'Company profile', d: 'The capability profile is local to the customer. It is the moat, not a shared asset.' }
  ];
  var outside = [
    { n: 'Portal access', d: 'Operator-triggered access to GeM and DefProc: disclosed, logged, and crossable by explicit action only. Dashed by design.' },
    { n: 'Deployment connectors', d: 'Any calendar, email or SSO connector is deployment-specific and reviewed at the boundary, per environment.' }
  ];
  var boxIn = document.getElementById('assetsIn'), boxOut = document.getElementById('assetsOut'),
      det = document.getElementById('bdetail');
  if (!boxIn) return;
  function add(box, a, egress) {
    var b = document.createElement('button');
    b.className = 'asset'; b.textContent = a.n; b.setAttribute('aria-pressed', 'false');
    b.addEventListener('click', function () {
      document.querySelectorAll('.asset').forEach(function (n) { n.setAttribute('aria-pressed', 'false'); });
      b.setAttribute('aria-pressed', 'true');
      det.innerHTML = '<span class="tag ' + (egress ? 'out' : 'inside') + '">' +
        (egress ? 'Explicit egress · documented and crossable' : 'Inside the boundary · never crosses') +
        '</span><p><b>' + a.n + '</b> · ' + a.d + '</p>';
    });
    box.appendChild(b);
  }
  inside.forEach(function (a) { add(boxIn, a, false); });
  outside.forEach(function (a) { add(boxOut, a, true); });
})();
</script>
