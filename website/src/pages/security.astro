---
// /security: Sovereign by design. Where everything runs, four properties a
// buyer can test in their own room, a plain data-handling list, and what we do
// not claim. No certification is claimed on this site.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import TestCard from '../components/site/security/TestCard.astro';
import ArchitectureDiagram from '../components/site/security/ArchitectureDiagram.astro';
import Properties from '../components/site/security/Properties.astro';
import DataHandling from '../components/site/security/DataHandling.astro';
import Boundary from '../components/site/security/Boundary.astro';
import { breadcrumbSchema } from '../data/kriseva';

const crumbs = [{ name: 'Sovereign by design', path: '/security' }];
---
<SiteLayout
  title="Sovereign by design | Kriseva: built to run where the files cannot leave"
  description="Kriseva runs on your premises with local models. A Wi-Fi-off cold start on 6 October 2026 left zero application requests. A tamper-evident, hash-chained record, and officers who decide. No certification is claimed; the install is open to your own audit."
  path="/security"
  headerTone="navy"
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    tone="navy"
    eyebrow="Resources · Sovereign by design"
    title="Built to run where the files cannot leave."
    accent="cannot leave."
    lead="Defence and space procurement files belong in the building. So Kriseva runs inside it: on your machines, with local models, writing a record you can check without us."
    crumbs={crumbs}
  >
    <Fragment slot="actions">
      <!-- PageHero's navy tone does not set the on-navy button palette; this wrapper does, without painting a box. -->
      <div class="on-navy sec-actions">
        <a class="btn btn--brass" href="#architecture">See the drawing <span class="arrow" aria-hidden="true">&rarr;</span></a>
        <a class="btn btn--ghost" href="#properties">Test it in your room</a>
      </div>
    </Fragment>
    <Fragment slot="visual"><TestCard /></Fragment>
  </PageHero>

  <ArchitectureDiagram />
  <Properties />
  <DataHandling />
  <Boundary />
</SiteLayout>

<style>
  .sec-actions {
    display: contents;
  }
</style>
