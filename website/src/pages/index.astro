---
// A short first pass: understand the gap, see the crossing, choose a side.
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeStory from '../components/site/home/HomeStory.astro';
import { SITE } from '../data/kriseva';
import '../styles/home-theme.css';

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Kriseva',
  url: SITE + '/',
  inLanguage: 'en-IN',
  publisher: { '@id': SITE + '/#organization' },
};
---
<SiteLayout
  title="Kriseva | AI for defence and space procurement in India"
  description="The bridge between defence and space suppliers and government procurement. TAS helps suppliers prepare. Evaluator helps committees review. Evidence crosses. People decide."
  path="/"
  overlayHeader
  compactFooter
  schema={[website]}
>
  <HomeStory />
</SiteLayout>
