/* ============================================================
   MODULE - audit chain: verify / tamper / reset
   ============================================================ */
(function () {
  var blocks = [
    { id:'0148', ev:'verdict_signed', ts:'14:22:07 IST', h:'9f3a…c1d2', p:'4e58…a907', b:'Criterion 31 · Verified · member B' },
    { id:'0149', ev:'clarification',  ts:'14:26:41 IST', h:'b70e…44af', p:'9f3a…c1d2', b:'Criterion 47 · clarification requested' },
    { id:'0150', ev:'recommendation', ts:'15:03:12 IST', h:'c2d8…91b6', p:'b70e…44af', b:'Tender recommendation sealed' }
  ];
  var chain = document.getElementById('chain'), status = document.getElementById('chainStatus');
  if (!chain) return;
  function render() {
    chain.innerHTML = '';
    blocks.forEach(function (bl, i) {
      if (i > 0) { var l = document.createElement('div'); l.className = 'clink'; chain.appendChild(l); }
      var d = document.createElement('div');
      d.className = 'cblock' + (bl.state || '');
      d.innerHTML =
        '<div class="bh"><span>Block ' + bl.id + ' · ' + bl.ev + '</span><span>' + bl.ts + '</span></div>' +
        '<div class="hash">' + bl.h + ' ← ' + bl.p + '</div>' +
        '<div class="bbody">' + bl.b + '</div>' +
        '<div class="flag ok">✓ hash matches previous block</div>' +
        '<div class="flag bad">✕ hash mismatch - tamper detected</div>';
      chain.appendChild(d);
    });
  }
  render();
  document.getElementById('verifyBtn').addEventListener('click', function () {
    var broken = false;
    blocks.forEach(function (bl, i) {
      setTimeout(function () {
        if (bl.tampered || broken) { broken = true; bl.state = ' broken'; } else { bl.state = ' valid'; }
        render();
        if (i === blocks.length - 1) {
          status.textContent = broken
            ? 'CHAIN BROKEN: an edited block no longer matches the next. Tamper is visible.'
            : 'CHAIN VERIFIED: every block hashes to the next. Untampered.';
          status.style.color = broken ? '#E8A99C' : '#9CD3B4';
        }
      }, REDUCE ? 0 : i * 460);
    });
  });
  document.getElementById('tamperBtn').addEventListener('click', function () {
    blocks[1].tampered = true;
    blocks[1].b = 'Criterion 47 · verdict ALTERED post-hoc';
    blocks[1].h = 'b70e…0000';
    blocks.forEach(function (b) { b.state = ''; });
    render();
    status.textContent = 'Block 0149 edited. Now run “Verify chain”.';
    status.style.color = '#C89A4C';
  });
  document.getElementById('resetBtn').addEventListener('click', function () {
    blocks[1].tampered = false;
    blocks[1].b = 'Criterion 47 · clarification requested';
    blocks[1].h = 'b70e…44af';
    blocks.forEach(function (b) { b.state = ''; });
    render();
    status.textContent = 'Chain unverified. Run a verification pass.';
    status.style.color = '';
  });
})();

/* ============================================================
   MODULE - bidability radar
   ============================================================ */
(function () {
  var dims = [
    { n:'Technical fit',          v:0.90, w:'Spec map clears 9 of 10 mandatory lines; one needs a datasheet revision.', ref:'SPEC §2–§4' },
    { n:'Financial eligibility',  v:0.78, w:'3-yr average turnover clears the floor; net-worth margin is thin.', ref:'FIN-2 · p.11' },
    { n:'Certification',          v:0.85, w:'ISO and Udyam current; one OEM authorisation expires inside the bid window.', ref:'ANNEX-C · p.41' },
    { n:'Past performance',       v:0.60, w:'Two comparable supplies on record; a third would strengthen the case.', ref:'BID-DOC · p.06' },
    { n:'Delivery capacity',      v:0.72, w:'Within stated lead time at 80% utilisation; little slack for slippage.', ref:'SPEC §6.1' },
    { n:'Disqualification risk',  v:0.40, w:'EMD instrument not yet located in the bundle.', ref:'FIN-1 · p.02', risk:'Single biggest rejection risk; resolve before bidding.' }
  ];
  var svg = document.getElementById('radar'); if (!svg) return;
  var cx = 170, cy = 170, R = 120, N = dims.length;
  function pt(i, r) { var a = -Math.PI / 2 + i * 2 * Math.PI / N; return [cx + r * Math.cos(a), cy + r * Math.sin(a)]; }
  var g = '';
  [0.25, 0.5, 0.75, 1].forEach(function (k) {
    var p = '';
    for (var i = 0; i < N; i++) { var xy = pt(i, R * k); p += (i ? 'L' : 'M') + xy[0].toFixed(1) + ' ' + xy[1].toFixed(1) + ' '; }
    g += '<path d="' + p + 'Z" fill="none" stroke="rgba(23,19,13,.16)"/>';
  });
  for (var i = 0; i < N; i++) {
    var e = pt(i, R);
    g += '<line x1="' + cx + '" y1="' + cy + '" x2="' + e[0].toFixed(1) + '" y2="' + e[1].toFixed(1) + '" stroke="rgba(23,19,13,.16)"/>';
  }
  var poly = '';
  for (i = 0; i < N; i++) { var xy = pt(i, R * dims[i].v); poly += (i ? 'L' : 'M') + xy[0].toFixed(1) + ' ' + xy[1].toFixed(1) + ' '; }
  g += '<path d="' + poly + 'Z" fill="rgba(10,31,68,.12)" stroke="#0A1F44" stroke-width="1.5"/>';
  for (i = 0; i < N; i++) {
    xy = pt(i, R * dims[i].v);
    g += '<circle data-i="' + i + '" cx="' + xy[0].toFixed(1) + '" cy="' + xy[1].toFixed(1) + '" r="4.5" fill="#0A1F44"/>';
    var lx = pt(i, R + 22);
    g += '<text x="' + lx[0].toFixed(1) + '" y="' + lx[1].toFixed(1) + '" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="9.5" letter-spacing="1" fill="#4E4838">' + String(i + 1).padStart(2, '0') + '</text>';
  }
  svg.innerHTML = g;
  var dl = document.getElementById('dims'), why = document.getElementById('dimWhy');
  dims.forEach(function (d, i) {
    var r = document.createElement('button');
    r.className = 'dimrow' + (d.risk ? ' risk' : '');
    r.dataset.i = i; r.setAttribute('role', 'tab'); r.setAttribute('aria-selected', 'false');
    r.innerHTML = '<span class="nm">' + String(i + 1).padStart(2, '0') + ' - ' + d.n + '</span><span class="sc tabular">' + Math.round(d.v * 100) + ' / 100</span>';
    dl.appendChild(r);
  });
  function focusDim(i) {
    dl.querySelectorAll('.dimrow').forEach(function (n) { n.setAttribute('aria-selected', String(+n.dataset.i === i)); });
    var d = dims[i];
    why.innerHTML = '<b>' + d.n + ' · ' + Math.round(d.v * 100) + '/100</b> - ' + d.w +
      ' <span class="src-note">[' + d.ref + ']</span>' +
      (d.risk ? '<span class="riskline">⚠ ' + d.risk + '</span>' : '');
  }
  dl.addEventListener('click', function (e) { var r = e.target.closest('.dimrow'); if (r) focusDim(+r.dataset.i); });
  dl.addEventListener('mouseover', function (e) { var r = e.target.closest('.dimrow'); if (r) focusDim(+r.dataset.i); });
  svg.addEventListener('mouseover', function (e) { if (e.target.dataset && e.target.dataset.i != null) focusDim(+e.target.dataset.i); });
  focusDim(5);
})();

