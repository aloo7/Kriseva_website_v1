---
// v7 story build. The page stays self-contained; this frontmatter only bakes
// build-time facts. claimRegistry feeds the X1 provenance chips (wording,
// category and evidence straight from publicClaims.ts); the build stamp
// feeds the X5 footer audit strip. No runtime dependency on either.
import { execSync } from 'node:child_process';
import { getClaim } from '../data/publicClaims';
import VerdictSimulator from '../components/v6/VerdictSimulator.astro';

const CHIP_IDS = [
  'positioning.thesis',
  'tas.one-liner',
  'evaluator.three-path',
  'evaluator.six-state',
  'evaluator.audit-chain',
  'evaluator.sovereign',
  'security.local-first',
  'record.pan-iit',
  'validation.synthetic-data',
];
const claimRegistry = Object.fromEntries(
  CHIP_IDS.flatMap((id) => {
    const c = getClaim(id);
    return c ? [[id, { w: c.wording, cat: c.category, ev: c.evidence[0] }]] : [];
  })
);
const git = (cmd: string) => {
  try { return execSync(cmd).toString().trim(); } catch { return 'untracked'; }
};
const buildSha = git('git rev-parse --short HEAD');
const claimsSha = git('git log -1 --format=%h -- src/data/publicClaims.ts');
const buildDate = new Date().toISOString().slice(0, 10);
