/* ============================================================
   KRISEVA v6 - "Evidential Cartography - the dossier, alive"
   Palette, type and voice per KRISEVA_TAS_DESIGN_LANGUAGE.md
   ============================================================ */
:root{
  --paper:#DED6C9; --paper-raised:#F3EDE0; --paper-sunk:#D4CBB6;
  --ink:#0F0E0B; --ink-deep:#17130D; --ink-sec:#4E4838; --ink-quiet:#8C8268;
  --rule:#C7BDA3;
  --navy:#0A1F44;
  --brass:#A87229; --brass-lt:#C89A4C;
  /* AA siblings (Convention #11): brass fails 4.5:1 as small text / fill on paper */
  --brass-deep:#8A5C16; --brass-text:#91601C;
  /* verdict palette - exact, used ONLY on verdicts */
  --v-verified:#3A7A5B; --v-qualified:#9A7322; --v-insufficient:#5F6A79;
  --v-missing:#9C4F43; --v-demo:#41618C; --v-failed:#83332D;
  /* AA text variants on paper (squares keep exact hues; text darkens to pass) */
  --vt-verified:#2E6149; --vt-qualified:#6E520F; --vt-insufficient:#454F5D;
  --vt-missing:#7E3A2F; --vt-demo:#324C6E; --vt-failed:#6E2B26;
  --on-navy:#E9E2D2; --on-navy-dim:rgba(233,226,210,.72);
  --serif:'Instrument Serif',Georgia,serif;
  --sans:'IBM Plex Sans',-apple-system,'Segoe UI',sans-serif;
  --mono:'IBM Plex Mono','SFMono-Regular',Consolas,monospace;
  --wrap:1380px; --pad:clamp(20px,4vw,56px);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;overflow-anchor:none}
html.js.lenis-on{scroll-behavior:auto}
body{
  background:var(--paper); color:var(--ink);
  font-family:var(--sans); font-size:16px; line-height:1.6;
  -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
  overflow-x:hidden;
}
/* paper grain - fractal noise at 5%, the archive feel */
body::after{
  content:""; position:fixed; inset:0; z-index:9990; pointer-events:none;
  background-image:url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="240" height="240"><filter id="n"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"/></filter><rect width="240" height="240" filter="url(%23n)" opacity="0.5"/></svg>');
  opacity:.05; mix-blend-mode:multiply;
}
::selection{background:var(--navy);color:var(--on-navy)}
img,svg,canvas{display:block;max-width:100%}
a{color:inherit}
button{font:inherit;color:inherit;background:none;border:none;cursor:pointer}
.wrap{max-width:var(--wrap);margin-inline:auto;padding-inline:var(--pad)}
.mono{font-family:var(--mono)}
.tabular{font-variant-numeric:tabular-nums}
/* skip link */
.skip{position:fixed;top:-48px;left:16px;z-index:10001;background:var(--ink);color:var(--paper-raised);
  font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;
  padding:10px 16px;transition:top .2s}
.skip:focus{top:12px}
/* focus */
:focus-visible{outline:2px solid var(--navy);outline-offset:3px;border-radius:1px}
.sec-navy :focus-visible{outline-color:var(--brass-lt)}
/* ---------- type ---------- */
.display{font-family:var(--serif);font-weight:400;letter-spacing:-0.02em;line-height:1.04;text-wrap:balance}
h1.display{font-size:clamp(2.5rem,5.4vw,5.6rem);line-height:1.05}
@media (min-width:761px){.hero-content h1 .ln{white-space:nowrap}}
h2.display{font-size:clamp(2.1rem,4.4vw,4.2rem)}
h3{font-family:var(--sans);font-weight:600;font-size:1.06rem}
.it{font-style:italic}
.em-brass{font-style:italic;color:var(--brass-text)}
.sec-navy .em-brass{color:var(--brass-lt)}
.eyebrow{font-family:var(--mono);font-weight:500;font-size:.66rem;letter-spacing:.22em;
  text-transform:uppercase;color:var(--ink-sec)}
.folio{font-family:var(--mono);font-weight:400;font-size:.62rem;letter-spacing:.22em;color:var(--ink-sec)}
.dek{font-size:clamp(1.02rem,1.4vw,1.22rem);line-height:1.6;color:var(--ink-sec);max-width:58ch;text-wrap:pretty}
.src-note{font-family:var(--mono);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-sec)}
/* masked line reveal (enabled only when anim libs are live) */
.ln{display:block;overflow:hidden}
.ln-in{display:block}
.js-anim .ln-in{transform:translateY(112%)}
.js-anim .rv{opacity:0;transform:translateY(26px)}
/* ---------- header ---------- */
header{position:fixed;inset-inline:0;top:0;z-index:1000;transition:background .35s,box-shadow .35s}
.nav{display:flex;align-items:center;justify-content:space-between;gap:24px;
  max-width:var(--wrap);margin-inline:auto;padding:22px var(--pad);transition:padding .35s}
header.stuck{background:rgba(243,237,224,.94);box-shadow:0 1px 0 var(--rule)}
header.stuck .nav{padding-block:12px}
.brand{display:flex;align-items:baseline;gap:7px;font-family:var(--sans);font-weight:600;
  letter-spacing:.34em;font-size:.95rem;text-decoration:none}
.brand .tika{width:7px;height:7px;border-radius:50%;background:var(--brass);transform:translateY(-1px)}
.nlinks{display:flex;gap:clamp(14px,2.6vw,36px)}
.nlinks a{font-family:var(--mono);font-size:.64rem;letter-spacing:.18em;text-transform:uppercase;
  color:var(--ink-sec);text-decoration:none;padding:6px 2px;position:relative}
.nlinks a::after{content:"";position:absolute;left:0;bottom:2px;height:1px;width:0;background:var(--ink);transition:width .3s}
.nlinks a:hover::after{width:100%}
/* ---------- buttons ---------- */
.btn{display:inline-flex;align-items:center;gap:10px;font-family:var(--mono);font-size:.68rem;
  letter-spacing:.16em;text-transform:uppercase;text-decoration:none;padding:15px 26px;
  border:1px solid var(--ink);border-radius:2px;transition:background .25s,color .25s;will-change:transform}
.btn .arr{transition:transform .25s}
.btn:hover .arr{transform:translateX(4px)}
.btn-fill{background:var(--brass-deep);border-color:var(--brass-deep);color:#FFF8EC}
.btn-fill:hover{background:var(--ink);border-color:var(--ink)}
.btn-line:hover{background:var(--ink);color:var(--paper-raised)}
.btn-sm{padding:10px 16px;font-size:.62rem}
.sec-navy .btn-line{border-color:rgba(233,226,210,.5);color:var(--on-navy)}
.sec-navy .btn-line:hover{background:var(--on-navy);color:var(--navy)}
/* ---------- registration marks ---------- */
.regmark{position:relative}
.regmark::before,.regmark::after{content:"";position:absolute;width:14px;height:14px;pointer-events:none;opacity:.5}
.regmark::before{top:-1px;left:-1px;border-top:1px solid var(--ink);border-left:1px solid var(--ink)}
.regmark::after{bottom:-1px;right:-1px;border-bottom:1px solid var(--ink);border-right:1px solid var(--ink)}
.sec-navy .regmark::before{border-color:rgba(233,226,210,.6)}
.sec-navy .regmark::after{border-color:rgba(233,226,210,.6)}
/* ---------- sections ---------- */
section{position:relative}
.sec-pad{padding-block:clamp(76px,9vw,140px)}
.sechead{margin-bottom:clamp(36px,5vw,72px)}
.sechead .row{display:flex;align-items:baseline;justify-content:space-between;gap:16px;
  border-top:1px solid var(--rule);padding-top:14px;margin-bottom:26px}
.sechead h2{max-width:18ch}
.sechead .dek{margin-top:18px}
.sec-navy{background:var(--navy);color:var(--on-navy)}
.sec-navy .eyebrow{color:var(--brass-lt)}
.sec-navy .folio{color:rgba(233,226,210,.62)}
.sec-navy .dek{color:var(--on-navy-dim)}
.sec-navy .sechead .row{border-top-color:rgba(233,226,210,.22)}
.sec-sunk{background:var(--paper-sunk)}
/* ============================================================
   HERO
   ============================================================ */
.hero{height:100vh;height:100svh;min-height:640px;overflow:hidden}
.hero-stage{position:relative;height:100%;width:100%}
#webgl{position:absolute;inset:0;width:100%;height:100%;z-index:1}
.hero-static{position:absolute;inset:0;z-index:1;display:none;align-items:center;justify-content:flex-end;
  padding-right:clamp(8px,4vw,72px)}
html.hero-fallback .hero-static{display:flex}
html.hero-fallback #webgl{display:none}
.hero-static svg{width:min(54vw,760px);height:auto;opacity:.96}
.hero-labels{position:absolute;inset:0;z-index:2;pointer-events:none;overflow:hidden;display:none}
.hero-labels.live{display:block}
.node-label{position:absolute;top:0;left:0;will-change:transform;white-space:nowrap;
  font-family:var(--mono);font-size:.6rem;letter-spacing:.12em;color:var(--ink-sec)}
.node-label .clause{display:block;padding:3px 7px;background:rgba(243,237,224,.85);
  border:1px solid var(--rule);border-radius:2px}
.node-label .chip{display:none;margin-top:4px;padding:3px 7px;background:var(--paper-raised);
  border:1px solid;border-radius:2px;font-weight:600;letter-spacing:.14em;text-transform:uppercase}
.node-label.resolved .chip{display:inline-block}
.hero-content{position:relative;z-index:3;height:100%;display:flex;flex-direction:column;
  justify-content:center;padding-top:64px}
.hero-content .eyebrow{margin-bottom:clamp(18px,2.6vw,30px)}
.hero-content h1{max-width:none}
.hero-content .dek{margin-top:clamp(20px,2.6vw,30px)}
.hero-acts{display:flex;flex-wrap:wrap;gap:14px;margin-top:clamp(26px,3.4vw,44px)}
.cred{margin-top:clamp(30px,4.6vw,62px);border-top:1px solid var(--rule);padding-top:16px;
  display:flex;flex-wrap:wrap;gap:10px 34px;max-width:920px}
.cred span{font-family:var(--mono);font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-sec)}
.cred b{color:var(--ink);font-weight:600}
.scroll-cue{position:absolute;z-index:3;bottom:26px;left:50%;transform:translateX(-50%);
  display:flex;align-items:center;gap:12px;font-family:var(--mono);font-size:.58rem;
  letter-spacing:.22em;text-transform:uppercase;color:var(--ink-sec)}
.scroll-cue .line{width:54px;height:1px;background:var(--ink-sec);transform-origin:left;animation:cue 2.4s ease-in-out infinite}
@keyframes cue{0%,100%{transform:scaleX(.35)}50%{transform:scaleX(1)}}
/* ============================================================
   MARQUEE BAND - two opposing streams
   ============================================================ */
.mqband{border-block:1px solid var(--rule);background:var(--paper-raised);overflow:hidden}
.mq{display:flex;width:max-content;gap:0;padding-block:13px}
.mq+.mq{border-top:1px solid var(--rule)}
.mq .set{display:flex;align-items:center;gap:3.2rem;padding-right:3.2rem}
.mq span{font-family:var(--mono);font-size:.64rem;letter-spacing:.2em;text-transform:uppercase;
  color:var(--ink-sec);display:inline-flex;align-items:center;gap:10px;white-space:nowrap}
.mq .sq{width:8px;height:8px;display:inline-block;border-radius:1px}
.mq-l{animation:mqL 46s linear infinite}
.mq-r{animation:mqR 38s linear infinite}
@keyframes mqL{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes mqR{from{transform:translateX(-50%)}to{transform:translateX(0)}}
/* ============================================================
   VOLUMES (two products)
   ============================================================ */
.vols{display:grid;grid-template-columns:repeat(12,1fr);gap:clamp(20px,3vw,44px)}
.vol{border-top:2px solid var(--ink);padding-top:22px}
.vol-tas{grid-column:1/8}
.vol-eval{grid-column:8/13;margin-top:clamp(48px,7vw,120px)}
.vol .vhead{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:14px}
.vol .vno{font-family:var(--mono);font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:var(--ink-sec)}
.vol h3{font-family:var(--serif);font-weight:400;font-size:clamp(1.7rem,2.6vw,2.6rem);letter-spacing:-0.01em;line-height:1.1}
.vol .vsub{margin-top:10px;color:var(--ink-sec);max-width:52ch;text-wrap:pretty}
.caps{margin-top:26px;border-top:1px solid var(--rule)}
.caps li{list-style:none;display:grid;grid-template-columns:1fr auto;gap:8px 18px;align-items:baseline;
  padding:13px 2px;border-bottom:1px solid var(--rule);font-size:.94rem;line-height:1.5}
.caps .ref{font-family:var(--mono);font-size:.58rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-sec);white-space:nowrap}
.caps b{font-weight:600}
/* pipeline rail inside TAS volume */
.pipe{margin-top:30px}
.pipe .ptitle{font-family:var(--mono);font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;
  color:var(--ink-sec);margin-bottom:14px;display:flex;justify-content:space-between;align-items:center}
.prail{position:relative;height:2px;background:var(--rule);margin:30px 6px 16px}
.prail .pfill{position:absolute;inset:0;width:0%;background:var(--ink);transition:width .2s linear}
.psteps{display:grid;grid-template-columns:repeat(6,1fr);gap:6px}
.pstep{text-align:left;padding:10px 8px 12px;border:1px solid transparent;border-radius:2px;transition:border-color .25s,background .25s}
.pstep .pn{font-family:var(--mono);font-size:.56rem;letter-spacing:.18em;color:var(--ink-quiet)}
.pstep .pt{display:block;margin-top:5px;font-weight:600;font-size:.82rem}
.pstep[aria-selected="true"]{border-color:var(--ink);background:var(--paper-raised)}
.pdetail{margin-top:16px;min-height:84px;padding:16px 18px;background:var(--paper-raised);
  border:1px solid var(--rule);border-radius:2px;font-size:.92rem;line-height:1.55;color:var(--ink-sec)}
.pdetail b{color:var(--ink);font-weight:600}
/* ============================================================
   THESIS pull-quote
   ============================================================ */
.thesis{padding-block:clamp(88px,10vw,170px)}
.thesis .tgrid{display:grid;grid-template-columns:minmax(0,1fr) clamp(150px,18vw,240px);gap:clamp(28px,4vw,64px)}
.tquote{font-family:var(--serif);font-weight:400;font-size:clamp(1.8rem,4vw,3.9rem);
  line-height:1.16;letter-spacing:-0.015em;text-wrap:balance;max-width:21ch}
.tmargin{border-left:1px solid var(--rule);padding-left:clamp(16px,2vw,28px);display:flex;flex-direction:column;gap:26px;align-self:center}
.tnote .tn-k{font-family:var(--mono);font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;color:var(--brass-text);display:block;margin-bottom:6px}
.tnote p{font-size:.82rem;line-height:1.55;color:var(--ink-sec)}
/* ============================================================
   MATRIX
   ============================================================ */
.mxwrap{display:grid;grid-template-columns:minmax(0,7fr) minmax(280px,5fr);gap:clamp(20px,3vw,44px);align-items:start}
.mxwrap>*{min-width:0}
.mxpanel{background:var(--paper-raised);border:1px solid var(--rule);border-radius:2px}
.mxh{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:6px 12px;padding:12px 16px;border-bottom:1px solid var(--rule)}
.mxh span{font-family:var(--mono);font-size:.6rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-sec)}
.mxh .live{display:inline-flex;align-items:center;gap:7px;color:var(--vt-verified)}
.mxh .live i{width:7px;height:7px;border-radius:50%;background:var(--v-verified);animation:pulse 2.2s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
.mxscroll{overflow-x:auto}
table.mx{width:100%;border-collapse:collapse}
.mx th{font-family:var(--mono);font-weight:500;font-size:.58rem;letter-spacing:.14em;text-transform:uppercase;
  color:var(--ink-sec);text-align:left;padding:12px 14px;border-bottom:1px solid var(--rule);background:var(--paper-sunk)}
.mx td{border-bottom:1px solid var(--rule);vertical-align:middle}
.mx td.crit{padding:13px 14px;font-size:.86rem;line-height:1.4;min-width:200px}
.mx td.crit .s{font-family:var(--mono);font-size:.56rem;letter-spacing:.1em;color:var(--ink-sec);margin-top:4px;text-transform:uppercase}
.mcell{width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:16px 10px;
  transition:background .2s;position:relative}
.mcell:hover{background:rgba(15,14,11,.05)}
.mcell[aria-pressed="true"]{background:rgba(15,14,11,.07);box-shadow:inset 0 0 0 1px var(--ink)}
.sq{width:13px;height:13px;border-radius:1px;display:inline-block}
.sq.v{background:var(--v-verified)}.sq.q{background:var(--v-qualified)}.sq.i{background:var(--v-insufficient)}
.sq.m{background:var(--v-missing)}.sq.d{background:var(--v-demo)}.sq.f{background:var(--v-failed)}
.legend{display:flex;flex-wrap:wrap;gap:8px 18px;padding:12px 16px;border-top:1px solid var(--rule)}
.legend span{font-family:var(--mono);font-size:.56rem;letter-spacing:.12em;text-transform:uppercase;
  color:var(--ink-sec);display:inline-flex;align-items:center;gap:7px}
.mxdetail{background:var(--ink-deep);color:#E7E1D0;border-radius:2px;padding:22px;min-height:240px;position:sticky;top:96px}
.mxdetail .dt{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:14px}
.verdict-pill{font-family:var(--mono);font-size:.6rem;letter-spacing:.16em;text-transform:uppercase;
  font-weight:600;padding:4px 10px;border:1px solid;border-radius:2px}
.mxdetail .srcref{font-family:var(--mono);font-size:.6rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(231,225,208,.62)}
.mxdetail .body{font-size:.92rem;line-height:1.6;color:rgba(231,225,208,.85)}
.mxdetail .body b{color:#F3EDE0;font-weight:600}
.mxdetail .route{margin-top:14px;font-family:var(--mono);font-size:.62rem;letter-spacing:.1em;color:var(--brass-lt)}
.disclose{margin-top:18px;font-family:var(--mono);font-size:.56rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-sec)}
.sec-navy .disclose{color:rgba(233,226,210,.55)}
/* ============================================================
   AUDIT CHAIN (navy)
   ============================================================ */
.chaingrid{display:grid;grid-template-columns:minmax(0,7fr) minmax(260px,4fr);gap:clamp(24px,4vw,64px);align-items:start}
.chain{display:flex;flex-direction:column;gap:0}
.cblock{border:1px solid rgba(233,226,210,.28);background:rgba(233,226,210,.045);border-radius:2px;
  padding:16px 18px;transition:border-color .3s,background .3s;position:relative}
.clink{width:1px;height:26px;background:rgba(233,226,210,.3);margin-left:34px;position:relative}
.clink::after{content:"⌄";position:absolute;left:-6px;bottom:-4px;color:rgba(233,226,210,.45);font-size:.7rem}
.cblock .bh{display:flex;justify-content:space-between;gap:12px;font-family:var(--mono);font-size:.6rem;
  letter-spacing:.14em;text-transform:uppercase;color:rgba(233,226,210,.65);margin-bottom:8px}
.cblock .hash{font-family:var(--mono);font-size:.72rem;letter-spacing:.06em;color:var(--brass-lt);margin-bottom:8px}
.cblock .bbody{font-size:.9rem;color:var(--on-navy-dim)}
.cblock .flag{display:none;margin-top:10px;font-family:var(--mono);font-size:.62rem;letter-spacing:.1em}
.cblock.valid{border-color:rgba(122,200,160,.55)}
.cblock.valid .flag.ok{display:block;color:#9CD3B4}
.cblock.broken{border-color:rgba(220,120,105,.6);background:rgba(131,51,45,.16)}
.cblock.broken .flag.bad{display:block;color:#E8A99C}
.chain-status{margin-top:18px;font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;
  color:var(--on-navy-dim);min-height:2.6em}
.chain-controls{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
.chainaside p{color:var(--on-navy-dim);max-width:44ch;text-wrap:pretty}
.chainaside .trust{margin-top:22px;font-family:var(--mono);font-size:.66rem;letter-spacing:.12em;
  color:var(--brass-lt);line-height:2}
/* ============================================================
   BIDABILITY radar
   ============================================================ */
.bidgrid{display:grid;grid-template-columns:minmax(280px,5fr) minmax(0,6fr);gap:clamp(24px,4vw,64px);align-items:center}
.radarbox{background:var(--paper-raised);border:1px solid var(--rule);border-radius:2px;padding:clamp(14px,2vw,30px)}
.radar-svg{width:100%;height:auto}
.dimlist{border-top:1px solid var(--rule)}
.dimrow{width:100%;display:flex;justify-content:space-between;align-items:baseline;gap:14px;
  padding:13px 4px;border-bottom:1px solid var(--rule);text-align:left;transition:background .2s}
.dimrow:hover{background:rgba(15,14,11,.04)}
.dimrow[aria-selected="true"]{background:var(--paper-raised);box-shadow:inset 2px 0 0 var(--ink)}
.dimrow .nm{font-weight:500;font-size:.94rem}
.dimrow .sc{font-family:var(--mono);font-size:.92rem;font-variant-numeric:tabular-nums;color:var(--ink-sec)}
.dimrow.risk .nm{color:var(--vt-failed)}
.dimwhy{margin-top:18px;padding:16px 18px;background:var(--paper-raised);border:1px solid var(--rule);
  border-radius:2px;font-size:.92rem;line-height:1.55;color:var(--ink-sec);min-height:84px}
.dimwhy b{color:var(--ink);font-weight:600}
.dimwhy .riskline{display:block;margin-top:8px;font-family:var(--mono);font-size:.62rem;
  letter-spacing:.1em;text-transform:uppercase;color:var(--vt-failed)}
/* ============================================================
   BOUNDARY
   ============================================================ */
.bgrid{display:grid;grid-template-columns:minmax(0,7fr) minmax(280px,5fr);gap:clamp(24px,4vw,64px);align-items:start}
.zone{border:1px solid var(--ink);border-radius:2px;padding:clamp(16px,2.4vw,28px);background:var(--paper-raised)}
.zone .zh{font-family:var(--mono);font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;
  color:var(--ink-sec);margin-bottom:16px;display:flex;align-items:center;gap:10px}
.zone .zh::before{content:"";width:8px;height:8px;background:var(--ink);border-radius:1px}
.zone-egress{border-style:dashed;border-color:var(--ink-sec);background:transparent;margin-top:18px}
.zone-egress .zh::before{background:none;border:1px dashed var(--ink-sec)}
.assets{display:flex;flex-wrap:wrap;gap:10px}
.asset{font-family:var(--mono);font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;
  padding:10px 14px;border:1px solid var(--rule);border-radius:2px;background:var(--paper);
  transition:border-color .2s,background .2s;text-align:left}
.asset:hover{border-color:var(--ink)}
.asset[aria-pressed="true"]{background:var(--ink);color:var(--paper-raised);border-color:var(--ink)}
.zone-egress .asset{border-style:dashed;background:transparent}
.bdetail{padding:20px;border:1px solid var(--rule);border-radius:2px;background:var(--paper-raised);
  min-height:170px;position:sticky;top:96px}
.bdetail .tag{display:inline-block;font-family:var(--mono);font-size:.56rem;letter-spacing:.16em;
  text-transform:uppercase;font-weight:600;padding:4px 10px;border-radius:2px;margin-bottom:12px}
.bdetail .tag.inside{background:rgba(58,122,91,.14);color:var(--vt-verified);border:1px solid rgba(58,122,91,.4)}
.bdetail .tag.out{background:transparent;color:var(--ink-sec);border:1px dashed var(--ink-sec)}
.bdetail p{font-size:.92rem;line-height:1.6;color:var(--ink-sec)}
.bdetail b{color:var(--ink);font-weight:600}
/* ============================================================
   STATS
   ============================================================ */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--rule);
  border-radius:2px;background:var(--paper-raised)}
.stat{padding:clamp(20px,3vw,40px);border-right:1px solid var(--rule)}
.stat:last-child{border-right:none}
.stat .big{font-family:var(--serif);font-weight:400;font-size:clamp(3rem,5.6vw,5.4rem);
  line-height:1;font-variant-numeric:tabular-nums;letter-spacing:-0.02em}
.stat .lab{margin-top:10px;font-weight:500;font-size:.9rem}
.stat .ssrc{margin-top:8px;font-family:var(--mono);font-size:.54rem;letter-spacing:.12em;
  text-transform:uppercase;color:var(--ink-sec);line-height:1.8}
/* ============================================================
   FIELD RECORD
   ============================================================ */
.record{border-top:1px solid var(--ink)}
.rec{display:grid;grid-template-columns:130px minmax(0,1fr) auto;gap:10px 26px;align-items:baseline;
  padding:18px 2px;border-bottom:1px solid var(--rule)}
.rec .date{font-family:var(--mono);font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-sec)}
.rec .what{font-size:1rem;line-height:1.5}
.rec .what b{font-weight:600}
.rec .tag{font-family:var(--mono);font-size:.56rem;letter-spacing:.16em;text-transform:uppercase;
  padding:4px 10px;border:1px solid var(--rule);border-radius:2px;color:var(--ink-sec);white-space:nowrap}
/* ============================================================
   CONTACT
   ============================================================ */
.contact{background:var(--ink-deep);color:#E7E1D0}
.contact .eyebrow{color:var(--brass-lt)}
.contact h2{color:#F3EDE0}
.contact .dek{color:rgba(231,225,208,.72)}
.cgrid{display:grid;grid-template-columns:minmax(0,7fr) minmax(260px,4fr);gap:clamp(28px,4vw,72px);align-items:center}
.founder-card{border:1px solid rgba(231,225,208,.25);border-radius:2px;padding:26px;position:relative}
.founder-card .seal{position:absolute;top:22px;right:22px;width:10px;height:10px;border-radius:50%;background:var(--brass)}
.founder-card b{display:block;font-family:var(--serif);font-weight:400;font-size:1.6rem;letter-spacing:-.01em;margin-bottom:6px}
.founder-card .meta{font-size:.9rem;line-height:1.9;color:rgba(231,225,208,.75)}
.founder-card a{color:var(--brass-lt);text-decoration:none;border-bottom:1px solid rgba(200,154,76,.4)}
.founder-card a:hover{border-bottom-color:var(--brass-lt)}
.contact .btn-line{border-color:rgba(231,225,208,.45);color:#E7E1D0}
.contact .btn-line:hover{background:#E7E1D0;color:var(--ink-deep)}
/* ---------- footer ---------- */
footer{background:var(--ink-deep);color:rgba(231,225,208,.6);border-top:1px solid rgba(231,225,208,.15)}
.foot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:14px 36px;
  max-width:var(--wrap);margin-inline:auto;padding:30px var(--pad) 38px;
  font-family:var(--mono);font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;line-height:2}
/* ---------- custom cursor ---------- */
.cursor-dot,.cursor-ring{position:fixed;top:0;left:0;z-index:9999;pointer-events:none;border-radius:50%;
  transform:translate(-50%,-50%);mix-blend-mode:difference}
.cursor-dot{width:6px;height:6px;background:#fff}
.cursor-ring{width:38px;height:38px;border:1px solid rgba(255,255,255,.85);transition:width .25s,height .25s}
.cursor-ring.grow{width:62px;height:62px}
.cursor-label{position:fixed;top:0;left:0;z-index:9999;pointer-events:none;font-family:var(--mono);
  font-size:.54rem;letter-spacing:.18em;text-transform:uppercase;background:var(--ink);color:var(--paper-raised);
  padding:3px 9px;border-radius:2px;opacity:0;transform:translate(14px,14px);transition:opacity .2s}
.cursor-label.show{opacity:1}
body.has-cursor,body.has-cursor a,body.has-cursor button{cursor:none}
.cursor-dot,.cursor-ring,.cursor-label{display:none}
body.has-cursor .cursor-dot,body.has-cursor .cursor-ring,body.has-cursor .cursor-label{display:block}
/* ---------- responsive ---------- */
@media (max-width:1080px){
  .vols{grid-template-columns:1fr}
  .vol-tas,.vol-eval{grid-column:1/-1;margin-top:0}
  .vol-eval{margin-top:34px}
  .mxwrap,.chaingrid,.bidgrid,.bgrid,.cgrid{grid-template-columns:1fr}
  .mxdetail,.bdetail{position:static}
  .stats{grid-template-columns:1fr 1fr}
  .stat:nth-child(2n){border-right:none}
  .stat:nth-child(-n+2){border-bottom:1px solid var(--rule)}
  .thesis .tgrid{grid-template-columns:1fr}
  .tmargin{border-left:none;border-top:1px solid var(--rule);padding-left:0;padding-top:22px;
    flex-direction:row;flex-wrap:wrap;gap:22px}
  .tnote{flex:1 1 200px}
}
@media (max-width:760px){
  .nlinks{display:none}
  /* CWV: above-the-fold hero content paints immediately on mobile; the
     masked-line choreography stays desktop-only (LCP, redteam D1) */
  .js-anim .hero-content .ln-in{transform:none}
  .js-anim .hero-content .rv{opacity:1;transform:none}
  .hero{height:auto;min-height:100svh;padding-bottom:46px}
  .hero-content{padding-top:110px;justify-content:flex-start}
  .hero-static{position:relative;inset:auto;justify-content:center;padding:28px 0 0;margin-top:8px}
  .hero-static svg{width:min(92vw,560px)}
  .scroll-cue{display:none}
  .psteps{grid-template-columns:repeat(3,1fr)}
  .rec{grid-template-columns:1fr;gap:6px}
  .rec .tag{justify-self:start}
  .stats{grid-template-columns:1fr}
  .stat{border-right:none;border-bottom:1px solid var(--rule)}
  .stat:last-child{border-bottom:none}
}
/* ---------- reduced motion ---------- */
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.001s!important;animation-iteration-count:1!important;transition-duration:.001s!important}
  html{scroll-behavior:auto}
  .mq-l,.mq-r{animation:none;transform:none}
  .js-anim .ln-in{transform:none}
  .js-anim .rv{opacity:1;transform:none}
}

/* ============================================================
   FIELD EVIDENCE - real product plates, filmstrip, founder photo
   ============================================================ */
.plate{position:relative;background:var(--paper-raised);border:1px solid var(--ink);border-radius:2px;
  box-shadow:0 24px 50px -28px rgba(15,14,11,.45);transition:transform .35s ease,box-shadow .35s ease}
.plate:hover{transform:translateY(-4px);box-shadow:0 34px 64px -30px rgba(15,14,11,.55)}
.plate .ph,.plate .pcap{display:flex;justify-content:space-between;gap:14px;align-items:center;
  font-family:var(--mono);font-size:.56rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-sec);
  padding:9px 14px;flex-wrap:wrap}
.plate .ph{border-bottom:1px solid var(--rule)}
.plate .pcap{border-top:1px solid var(--rule)}
.plate .ph b{color:var(--ink);font-weight:600}
.plate .pimg{position:relative;overflow:hidden;background:var(--paper-sunk)}
.plate .pimg img{width:100%;display:block}
.sec-navy .plate{border-color:rgba(233,226,210,.35);background:rgba(233,226,210,.04);box-shadow:0 24px 50px -28px rgba(0,0,0,.6)}
.sec-navy .plate .ph,.sec-navy .plate .pcap{color:rgba(233,226,210,.65)}
.sec-navy .plate .ph{border-bottom-color:rgba(233,226,210,.2)}
.sec-navy .plate .pcap{border-top-color:rgba(233,226,210,.2)}
/* the console - full-bleed media band */
.bleed{width:100vw;position:relative;left:50%;transform:translateX(-50%)}
.console-sec{padding-block:clamp(46px,6vw,100px) 0}
.console-plate{border-block:1px solid var(--ink);background:var(--paper-raised)}
.console-plate .ph,.console-plate .pcap{max-width:var(--wrap);margin-inline:auto;padding:10px var(--pad)}
.console-plate .pimg img{width:100%;height:auto;display:block}
.ann{position:absolute;z-index:3;font-family:var(--mono);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;
  color:#F3EDE0;background:rgba(23,19,13,.85);padding:8px 14px;border-left:2px solid var(--brass);border-radius:2px}
.ann b{color:var(--brass-lt);font-weight:600}
.ann1{right:6%;top:16%}
.ann2{right:6%;top:30%}
/* bundle plate + traced bbox */
.bundle-plate{margin-top:clamp(26px,4vw,48px)}
.bundle-plate .pimg svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.bbox-label{position:absolute;top:17%;left:40%;font-family:var(--mono);font-size:.56rem;letter-spacing:.14em;
  text-transform:uppercase;color:#FFF8EC;background:var(--brass);padding:3px 9px;border-radius:2px;opacity:0}
.bbox-label.on{opacity:1;transition:opacity .4s}
/* filmstrip */
.strip-sec{overflow:hidden}
.strip-stage{padding-block:clamp(40px,4.5vw,68px)}
.stripwrap{margin-top:clamp(24px,3.4vw,42px)}
.strip{display:flex;gap:clamp(18px,2.4vw,34px);width:max-content;
  padding-inline:max(calc((100vw - var(--wrap))/2 + var(--pad)),20px)}
.strip .plate{flex:0 0 auto}
.strip .pl-land{width:clamp(420px,44vw,620px)}
.strip .pl-sq{width:clamp(340px,33vw,450px)}
.strip .pl-port{width:clamp(270px,25vw,345px)}
.striprail{height:2px;background:var(--rule);margin-top:20px;position:relative;max-width:420px}
.striprail i{position:absolute;inset:0;width:0%;background:var(--ink);display:block}
.strip-sec .disclose{margin-top:26px}
.strip-hint{font-family:var(--mono);font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-sec);margin-top:14px}
/* founder photo */
.fphoto{margin:-26px -26px 20px;overflow:hidden;border-bottom:1px solid rgba(231,225,208,.25);aspect-ratio:4/5}
.fphoto img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.92)}
@media (max-width:1080px){
  .strip .pl-land,.strip .pl-sq{width:min(72vw,540px)}.strip .pl-port{width:min(52vw,340px)}
}
@media (max-width:760px){
  .strip{overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;width:auto;padding-inline:16px}
  .strip .plate{scroll-snap-align:center}.strip .pl-land{width:84vw}.strip .pl-sq{width:74vw}.strip .pl-port{width:62vw}
}
@media (prefers-reduced-motion: reduce){
  .plate,.plate:hover{transform:none}
  .bbox-label{opacity:1}
}
</style>
</head>
<body>
