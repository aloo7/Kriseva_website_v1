  crit.forEach(function (cr, ri) {
    html += '<tr><td class="crit">' + cr.c + '<div class="s">' + cr.s + '</div></td>';
    bidders.forEach(function (b, ci) {
      var st = data[ri][ci];
      html += '<td><button class="mcell" data-r="' + ri + '" data-c="' + ci + '" data-st="' + st +
        '" aria-pressed="false" aria-label="' + cr.c + ', ' + b + ': ' + V[st] +
        '"><span class="sq ' + st + '" aria-hidden="true"></span></button></td>';
    });
    html += '</tr>';
  });
  mx.innerHTML = html + '</tbody>';
  mx.addEventListener('click', function (e) {
    var cell = e.target.closest('.mcell'); if (!cell) return;
    mx.querySelectorAll('.mcell').forEach(function (n) { n.setAttribute('aria-pressed', 'false'); });
    cell.setAttribute('aria-pressed', 'true');
    var ri = +cell.dataset.r, ci = +cell.dataset.c, st = cell.dataset.st;
    mxd.innerHTML =
      '<div class="dt"><span class="verdict-pill" style="border-color:' + VC[st] + ';color:' + VN[st] + '">' + V[st] +
      '</span><span class="srcref">' + crit[ri].s + ' · ' + bidders[ci] + '</span></div>' +
      '<div class="body"><b>' + crit[ri].c + '</b> - ' + reason[st] + '</div>' +
      '<div class="route">' + ((st === 'i' || st === 'm') ? '→ auto-routes to human review (HITL)' : '→ recorded with source · the committee signs') + '</div>';
  });

  /* verdict distribution ledger: counts derived from the same matrix data */
  var dist = document.getElementById('mxDist');
  if (dist) {
    var counts = {};
    data.forEach(function (row) { row.forEach(function (st) { counts[st] = (counts[st] || 0) + 1; }); });
    var order = ['v', 'q', 'd', 'i', 'm', 'f'];
    var maxC = Math.max.apply(null, order.map(function (k) { return counts[k] || 0; }));
    var total = data.length * data[0].length;
    var html = '<div class="mxd-t">Distribution · ' + total + ' verdicts in this synthetic session</div>';
    order.forEach(function (k) {
      var c = counts[k] || 0;
      html += '<div class="mxd-row"><span class="sq ' + k + '" aria-hidden="true"></span>' +
        '<span class="nm">' + V[k] + '</span>' +
        '<span class="bar" aria-hidden="true"><i data-w="' + (c / maxC * 100) + '" style="background:' + VC[k] + '"></i></span>' +
        '<span class="ct" style="color:' + VT[k] + '">' + c + '</span></div>';
    });
    dist.innerHTML = html;
    var bars = dist.querySelectorAll('.bar i');
    function fill() { bars.forEach(function (b) { b.style.width = b.dataset.w + '%'; }); }
    if (REDUCE || !('IntersectionObserver' in window)) fill();
    else new IntersectionObserver(function (es, io) {
      es.forEach(function (e) { if (e.isIntersecting) { fill(); io.disconnect(); } });
    }, { threshold: 0.4 }).observe(dist);
  }
})();

