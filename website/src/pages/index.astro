var DESKTOP= window.matchMedia('(min-width: 761px)').matches;
var hasGSAP = typeof window.gsap !== 'undefined';
var hasST   = hasGSAP && typeof window.ScrollTrigger !== 'undefined';
var hasLenis= typeof window.Lenis !== 'undefined';
var hasThree= typeof window.THREE !== 'undefined';
var ANIM = hasGSAP && !REDUCE;

if (hasGSAP && hasST) gsap.registerPlugin(ScrollTrigger);
if (ANIM) document.documentElement.classList.add('js-anim');

/* ---------- verdict vocabulary (shared) ---------- */
var V  = { v:'Verified', q:'Verified · qualified', i:'Insufficient', m:'Missing', d:'Requires demonstration', f:'Failed' };
var VC = { v:'#3A7A5B', q:'#9A7322', i:'#5F6A79', m:'#9C4F43', d:'#41618C', f:'#83332D' };          /* exact swatches */
var VT = { v:'#2E6149', q:'#6E520F', i:'#454F5D', m:'#7E3A2F', d:'#324C6E', f:'#6E2B26' };          /* AA text on paper */
var VN = { v:'#8FC5A8', q:'#D9B45E', i:'#A8B3C2', m:'#D99284', d:'#9DB7DC', f:'#D98C82' };          /* AA text on near-black */

/* ---------- Lenis smooth scroll ---------- */
var lenis = null;
if (hasLenis && !REDUCE) {
  lenis = new Lenis({ lerp: 0.1, smoothWheel: true });
  window.__lenis = lenis;
  document.documentElement.classList.add('lenis-on');
  if (hasST) lenis.on('scroll', ScrollTrigger.update);
  if (hasGSAP) {
    gsap.ticker.add(function (t) { lenis.raf(t * 1000); });
    gsap.ticker.lagSmoothing(0);
  } else {
    (function raf(t){ lenis.raf(t); requestAnimationFrame(raf); })(0);
  }
}
/* anchor navigation through Lenis */
document.querySelectorAll('a[href^="#"]').forEach(function (a) {
  a.addEventListener('click', function (e) {
    var id = a.getAttribute('href');
    if (id.length < 2) return;
    var el = document.querySelector(id);
    if (!el) return;
    e.preventDefault();
    if (lenis) lenis.scrollTo(el, { offset: -60 });
    else el.scrollIntoView({ behavior: REDUCE ? 'auto' : 'smooth' });
  });
});

/* ---------- header condense ---------- */
var hdr = document.getElementById('hdr');
function onScrollHdr(){ hdr.classList.toggle('stuck', window.scrollY > 40); }
onScrollHdr();
window.addEventListener('scroll', onScrollHdr, { passive: true });

/* ---------- masked reveals ---------- */
if (ANIM && hasST) {
  /* hero text is exempt on mobile: it is visible at first paint (CSS) and
     GSAP must not restyle it, or the repaint re-anchors LCP to JS load */
  if (DESKTOP) {
    document.querySelectorAll('h1 .ln-in').forEach(function (el, i) {
      gsap.to(el, { y: 0, duration: 1.1, ease: 'power4.out', delay: 0.25 + i * 0.13 });
    });
  }
  document.querySelectorAll('h2 .ln-in, .contact .ln-in').forEach(function (el) {
    gsap.to(el, { y: 0, duration: 1, ease: 'power4.out',
      scrollTrigger: { trigger: el.closest('h2') || el, start: 'top 86%' } });
  });
  gsap.utils.toArray('.rv').filter(function (el) {
    return DESKTOP || !el.closest('.hero-content');
  }).forEach(function (el) {
    gsap.to(el, { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out',
      scrollTrigger: { trigger: el, start: 'top 88%' } });
