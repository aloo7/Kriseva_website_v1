<div class="cursor-ring" aria-hidden="true"></div>
<div class="cursor-dot" aria-hidden="true"></div>
<div class="cursor-label" aria-hidden="true"></div>

<header id="hdr">
  <div class="nav">
    <a class="brand" href="#top" aria-label="KRISEVA home"><img class="bmark" src="/assets/brand/kriseva-mark.svg" alt="" width="24" height="24">KRISEVA</a>
