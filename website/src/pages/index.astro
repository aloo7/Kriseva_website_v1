/* ---------- marquees: duplicate sets, pause off-screen ---------- */
[ 'mq1', 'mq2' ].forEach(function (id) {
  var mq = document.getElementById(id);
  if (!mq) return;
  var set = mq.querySelector('.set');
  mq.appendChild(set.cloneNode(true));
  if (REDUCE) { mq.style.animation = 'none'; return; }
  try {
    new IntersectionObserver(function (es) {
      es.forEach(function (e) { mq.style.animationPlayState = e.isIntersecting ? 'running' : 'paused'; });
    }).observe(mq.parentElement);
  } catch (e) {}
});

/* ---------- count-ups (tabular figures) ---------- */
document.querySelectorAll('[data-count]').forEach(function (el) {
  var target = parseInt(el.dataset.count, 10);
  var suffix = el.dataset.suffix || '';
  if (REDUCE || !('IntersectionObserver' in window) || target === 0) { el.textContent = target + suffix; return; }
  el.textContent = '0' + suffix;
  new IntersectionObserver(function (es, io) {
    es.forEach(function (e) {
      if (!e.isIntersecting) return;
      io.unobserve(el);
      var t0 = performance.now(), dur = 1300;
      (function tick(now) {
        var p = Math.min(1, (now - t0) / dur);
        var eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * eased) + suffix;
        if (p < 1) requestAnimationFrame(tick);
      })(t0);
    });
  }, { threshold: 0.6 }).observe(el);
});

/* ---------- magnetic CTAs ---------- */
if (FINE && ANIM) {
  document.querySelectorAll('.magnetic').forEach(function (el) {
    var qx = gsap.quickTo(el, 'x', { duration: 0.35, ease: 'power3.out' });
    var qy = gsap.quickTo(el, 'y', { duration: 0.35, ease: 'power3.out' });
    el.addEventListener('mousemove', function (e) {
      var r = el.getBoundingClientRect();
      qx((e.clientX - r.left - r.width / 2) * 0.28);
      qy((e.clientY - r.top - r.height / 2) * 0.34);
    });
    el.addEventListener('mouseleave', function () { qx(0); qy(0); });
  });
}

/* ---------- custom cursor: dot + ring + contextual label ---------- */
if (FINE && !REDUCE) {
  document.body.classList.add('has-cursor');
  var dot = document.querySelector('.cursor-dot'),
      ring = document.querySelector('.cursor-ring'),
      lab = document.querySelector('.cursor-label');
  var mx = -200, my = -200, rx = -200, ry = -200;
  document.addEventListener('mousemove', function (e) {
    mx = e.clientX; my = e.clientY;
    dot.style.transform = 'translate(' + (mx - 3) + 'px,' + (my - 3) + 'px)';
    lab.style.transform = 'translate(' + (mx + 18) + 'px,' + (my + 14) + 'px)';
  }, { passive: true });
  (function lerpRing() {
    rx += (mx - rx) * 0.16; ry += (my - ry) * 0.16;
    ring.style.transform = 'translate(' + (rx - 19) + 'px,' + (ry - 19) + 'px)';
    requestAnimationFrame(lerpRing);
  })();
  document.addEventListener('mouseover', function (e) {
    var t = e.target.closest('[data-cursor], a, button');
    if (t) {
      ring.classList.add('grow');
      var txt = t.closest('[data-cursor]');
      if (txt && txt.dataset.cursor) { lab.textContent = txt.dataset.cursor; lab.classList.add('show'); }
      else lab.classList.remove('show');
    } else { ring.classList.remove('grow'); lab.classList.remove('show'); }
  }, { passive: true });
}

