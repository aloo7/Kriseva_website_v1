/* ============================================================
   SIGNATURE - WebGL hero: bundle → brass strands → verdict ledger
   Desktop + fine pointer + motion allowed + WebGL only.
   Everyone else gets the static plate (SVG above).
   ============================================================ */
(function () {
  var stage = document.getElementById('heroStage'),
      canvas = document.getElementById('webgl'),
      labelBox = document.getElementById('heroLabels'),
      cue = document.getElementById('scrollCue');
  /* three.js is injected only for desktop + fine pointer + motion allowed
     (loader in <head>); boot waits for it, so phones never parse it */
  var deviceGL = hasGSAP && hasST && !REDUCE && DESKTOP && FINE;

  var P = 0, heroPin = null;
  function fallback() {
    document.documentElement.classList.add('hero-fallback');
    if (heroPin) { heroPin.kill(true); heroPin = null; ScrollTrigger.refresh(); }
  }
  if (!deviceGL) { fallback(); return; }
  /* The pin is created HERE, synchronously, not inside boot(): pins must
     come into existence in document order, before any trigger below them
     measures the page, or every downstream trigger is short by the
     pin-spacer (the v6 "sloppy scroll" defect). boot() only consumes P.
     150% pin distance: long enough for the strand choreography, short
     enough that the page never feels parked. */
  heroPin = ScrollTrigger.create({
    trigger: '.hero', start: 'top top', end: '+=150%', pin: true, scrub: true,
    onUpdate: function (self) { P = self.progress; }
  });
  if (typeof window.THREE !== 'undefined') { boot(); }
  else {
    var ldr = document.getElementById('threeLoader');
    if (!ldr) { fallback(); return; }
    ldr.addEventListener('load', boot);
    ldr.addEventListener('error', fallback);
  }
  function boot() {
  if (typeof window.THREE === 'undefined') { fallback(); return; }

  var renderer;
  try {
    renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
  } catch (e) { fallback(); return; }
  labelBox.classList.add('live');   /* labels overlay only exists on the GL path */

  var W = stage.clientWidth, H = stage.clientHeight;
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.75));
  renderer.setSize(W, H, false);

  var scene = new THREE.Scene();
  scene.fog = new THREE.Fog(0xDED6C9, 9, 17);
  var camera = new THREE.PerspectiveCamera(35, W / H, 0.1, 50);
  var CAM = { x: 1.7, y: 0.35, z: 10.2 };
  camera.position.set(CAM.x, CAM.y, CAM.z);

  var INK = 0x17130D, PAPER_R = 0xF3EDE0, BRASS = 0xA87229;

  /* ---- the tender bundle: stacked ink-outlined document planes ---- */
  var bundle = new THREE.Group();
  var docGeo = new THREE.PlaneGeometry(2.0, 2.7);
  var edgeGeo = new THREE.EdgesGeometry(docGeo);
  var JIT = [[0,-0.02,0.05],[0.05,0.03,-0.04],[-0.06,0.01,0.03],[0.03,-0.04,-0.02],[-0.02,0.05,0.06],[0.06,0.02,-0.05],[-0.04,-0.03,0.02]];
  for (var i = 0; i < 7; i++) {
    var leaf = new THREE.Group();
    var face = new THREE.Mesh(docGeo, new THREE.MeshBasicMaterial({ color: PAPER_R, transparent: true, opacity: 0.94, side: THREE.DoubleSide }));
    var edge = new THREE.LineSegments(edgeGeo, new THREE.LineBasicMaterial({ color: INK, transparent: true, opacity: 0.8 }));
    leaf.add(face); leaf.add(edge);
    var sc = 1 - i * 0.012;
    leaf.scale.set(sc, sc, 1);
    leaf.position.set(JIT[i][0], JIT[i][1], i * 0.075);
    leaf.rotation.z = (i - 3) * 0.03 + JIT[i][2];
    bundle.add(leaf);
  }
  var seal = new THREE.Mesh(new THREE.CircleGeometry(0.085, 32), new THREE.MeshBasicMaterial({ color: BRASS }));
  seal.position.set(0.62, 1.0, 0.55);
  bundle.add(seal);
  var shadow = new THREE.Mesh(new THREE.CircleGeometry(1.5, 40), new THREE.MeshBasicMaterial({ color: 0x17130D, transparent: true, opacity: 0.1 }));
  shadow.rotation.x = -Math.PI / 2; shadow.scale.set(1.5, 0.55, 1);
  shadow.position.set(0.55, -1.62, 0.2);
  scene.add(shadow);
  /* ruled "text" rows on the front leaf */
  (function () {
    var pts = [];
    for (var r = 0; r < 8; r++) {
      var y = 1.05 - r * 0.27, wRow = (r % 3 === 2) ? 0.9 : 1.4;
      pts.push(new THREE.Vector3(-0.8, y, 0.50), new THREE.Vector3(-0.8 + wRow, y, 0.50));
    }
    var lg = new THREE.BufferGeometry().setFromPoints(pts);
    bundle.add(new THREE.LineSegments(lg, new THREE.LineBasicMaterial({ color: 0x4E4838, transparent: true, opacity: 0.5 })));
  })();
  bundle.position.set(0.55, -0.1, 0);
  bundle.rotation.y = 0.35;
  scene.add(bundle);

  /* ---- clause nodes ---- */
  var NODES = [
    { ref:'SPEC §3.2 · p.18', st:'v', pos:[ 2.4,  1.75, -0.6] },
    { ref:'ANNEX-C · p.41',   st:'q', pos:[ 3.6,  1.05,  0.5] },
    { ref:'BID-DOC · p.06',   st:'d', pos:[ 4.6,  1.55, -1.2] },
    { ref:'FIN-2 · p.11',     st:'i', pos:[ 3.9, -0.30,  0.3] },
    { ref:'FIN-1 · p.02',     st:'m', pos:[ 4.9, -1.05, -0.4] },
    { ref:'ATC §7.1 · p.59',  st:'f', pos:[ 3.0, -1.60, -0.9] }
  ];
  var LC = new THREE.Vector3(3.85, 0.1, 0);             /* ledger anchor */
  var nodesGroup = new THREE.Group();
  nodesGroup.position.copy(LC);
  scene.add(nodesGroup);

  var ringGeo = new THREE.RingGeometry(0.055, 0.082, 28);
  NODES.forEach(function (n, i) {
    var world = new THREE.Vector3(n.pos[0], n.pos[1], n.pos[2]);
    n.scatter = world.clone().sub(LC);                   /* local to group */
    n.ledger  = new THREE.Vector3(0, 1.35 - i * 0.54, 0);
    n.mesh = new THREE.Mesh(ringGeo, new THREE.MeshBasicMaterial({ color: INK, transparent: true, opacity: 0.85, side: THREE.DoubleSide }));
    n.mesh.position.copy(n.scatter);
    nodesGroup.add(n.mesh);
    /* HTML label */
    var el = document.createElement('div');
    el.className = 'node-label';
    el.innerHTML = '<span class="clause">' + n.ref + '</span>' +
      '<span class="chip" style="border-color:' + VC[n.st] + ';color:' + VT[n.st] + '">' + V[n.st] + '</span>';
    labelBox.appendChild(el);
    n.label = el;
  });

  /* ---- brass strands: CatmullRom tubes, drawn by index range ---- */
  var ORIGIN = new THREE.Vector3(1.45, 0.0, 0.25);
  var strands = [];
  NODES.forEach(function (n, i) {
    var end = new THREE.Vector3(n.pos[0], n.pos[1], n.pos[2]);
    var mid1 = new THREE.Vector3(2.1, ORIGIN.y + (end.y - ORIGIN.y) * 0.45 + 0.55, 0.4);
    var mid2 = new THREE.Vector3(end.x - 0.8, end.y + 0.3, end.z * 0.5);
    var curve = new THREE.CatmullRomCurve3([ORIGIN.clone(), mid1, mid2, end]);
    var geo = new THREE.TubeGeometry(curve, 72, 0.02, 8, false);
    var mat = new THREE.MeshBasicMaterial({ color: BRASS, transparent: true, opacity: 0.95 });
    var mesh = new THREE.Mesh(geo, mat);
    geo.setDrawRange(0, 0);
    scene.add(mesh);
    strands.push({ mesh: mesh, total: geo.index.count, window: [0.06 + i * 0.10, 0.16] });
  });

  /* ---- scroll + idle state (P is owned by the pin created above) ---- */
  var mouseX = 0, mouseY = 0, idle = 0, lastT = 0, visible = true, resolvedCount = -1;
  function smooth(t) { return t <= 0 ? 0 : t >= 1 ? 1 : t * t * (3 - 2 * t); }

  stage.addEventListener('mousemove', function (e) {
    var r = stage.getBoundingClientRect();
    mouseX = (e.clientX - r.left) / r.width * 2 - 1;
    mouseY = (e.clientY - r.top) / r.height * 2 - 1;
  }, { passive: true });

  try {
    new IntersectionObserver(function (es) {
      es.forEach(function (e) { visible = e.isIntersecting; });
    }).observe(stage);
  } catch (e) {}

  function onResize() {
    W = stage.clientWidth; H = stage.clientHeight;
    camera.aspect = W / H; camera.updateProjectionMatrix();
    renderer.setSize(W, H, false);
  }
  window.addEventListener('resize', onResize);

  var v3 = new THREE.Vector3();
  function frame(now) {
    requestAnimationFrame(frame);
    if (!visible) return;
    if (now - lastT < 16) return;                        /* ~60fps cap */
    var dt = Math.min(0.05, (now - lastT) / 1000) || 0.016;
    lastT = now;

    var aT = smooth((P - 0.74) / 0.24);                  /* ledger assembly 0..1 */

    /* strands draw + fade */
    var done = 0;
    strands.forEach(function (s, i) {
      var t = smooth((P - s.window[0]) / s.window[1]);
      if (i === 0) t = Math.max(t, 0.22);
      if (t >= 1) done++;
      var count = Math.floor(s.total * t / 3) * 3;
      s.mesh.geometry.setDrawRange(0, count);
      s.mesh.material.opacity = 0.95 * (1 - aT);
      s.mesh.visible = aT < 0.98;
    });
    if (done !== resolvedCount) {
      resolvedCount = done;
      NODES.forEach(function (n, i) {
        var t = smooth((P - strands[i].window[0]) / strands[i].window[1]);
        n.label.classList.toggle('resolved', t >= 1);
      });
    }

    /* nodes: scatter → ledger; group slowly rotates once assembled */
    idle += dt * 0.3;
    nodesGroup.rotation.y = idle * aT;
    NODES.forEach(function (n) {
      n.mesh.position.lerpVectors(n.scatter, n.ledger, aT);
      n.mesh.lookAt(camera.position);
    });

    /* bundle breath + camera */
    bundle.position.y = Math.sin(now * 0.0006) * 0.06;
    bundle.rotation.y = 0.35 + Math.sin(now * 0.0004) * 0.03;
    camera.position.x += (CAM.x + P * 0.6 + mouseX * 0.22 - camera.position.x) * 0.06;
    camera.position.y += (CAM.y - mouseY * 0.16 - camera.position.y) * 0.06;
    camera.position.z += (CAM.z - P * 1.3 - camera.position.z) * 0.06;
    camera.lookAt(1.7, 0.15, 0);

    renderer.render(scene, camera);

    /* project labels to screen space */
    NODES.forEach(function (n) {
      n.mesh.getWorldPosition(v3).project(camera);
      var x = (v3.x * 0.5 + 0.5) * W, y = (-v3.y * 0.5 + 0.5) * H;
      n.label.style.transform = 'translate(' + (x + 12).toFixed(1) + 'px,' + (y - 10).toFixed(1) + 'px)';
      n.label.style.opacity = (v3.z < 1 && P > 0.02) ? 1 : 0;
    });

    /* scroll cue */
    if (cue) cue.style.opacity = P > 0.04 ? 0 : 1;
  }
  requestAnimationFrame(frame);
  }   /* end boot() */
})();

/* ============================================================
   HERO FALLBACK CHOREOGRAPHY - phones and no-GL devices get the
   same thesis moment as the WebGL hero: the static plate draws
   itself on scroll. Brass strands trace from the bundle, then the
   six verdict chips resolve, scrubbed and reversible.
   ============================================================ */
(function () {
  if (!(ANIM && hasST)) return;
  if (DESKTOP && !document.documentElement.classList.contains('hero-fallback')) return;
  var svg = document.querySelector('.hero-static svg');
  if (!svg) return;
  var strands = svg.querySelectorAll('g[stroke="#A87229"] path');
  var chips = svg.querySelectorAll('g[font-size="11"] > g');
  if (!strands.length) return;
  strands.forEach(function (p) {
    var L = p.getTotalLength();
    p.style.strokeDasharray = L;
    p.style.strokeDashoffset = L;
  });
  chips.forEach(function (c) { c.style.opacity = 0; });
  var tl = gsap.timeline({
    scrollTrigger: { trigger: '.hero-static', start: 'top 88%', end: 'top 18%', scrub: true }
  });
  strands.forEach(function (p, i) { tl.to(p, { strokeDashoffset: 0, ease: 'none', duration: 1 }, i * 0.3); });
  chips.forEach(function (c, i) { tl.to(c, { opacity: 1, ease: 'none', duration: 0.35 }, 0.5 + i * 0.3); });
})();

/* ============================================================
   ACT 1 - the nation's clock: one acquisition travels the rule
   while an elapsed-years counter actually climbs (A2). Qualitative
   on purpose: the number ticks up as the dot passes each station,
   then ages into "Years later" at the end instead of a literal
   placeholder. The page still claims no specific duration (see the
   source note under the rail).
   (Created here, after the hero pin and before the strip pin,
   so pin creation order matches document order.)
   ============================================================ */
(function () {
  var stations = document.querySelectorAll('#cycleStations .cst');
  if (!stations.length) return;
  var fill = document.getElementById('cycleFill'),
      dot  = document.getElementById('cycleDot'),
      box  = document.getElementById('yearBox'),
      yr   = document.getElementById('yearN');
  function setP(p) {
    var cl = Math.max(0, Math.min(1, p));
    var pct = cl * 100;
    if (fill) fill.style.width = pct + '%';
    if (dot) dot.style.left = pct + '%';
    var idx = Math.min(6, Math.floor(p * 7));
    stations.forEach(function (s, i) { s.classList.toggle('lit', i <= idx); });
    /* one tick per station passed: a real integer that climbs 1..7 */
    if (yr) yr.textContent = String(Math.min(7, Math.floor(cl * 7) + 1));
    /* near the last station the counter ages into the qualitative end-state */
    if (box) box.classList.toggle('aged', cl >= 0.985);
  }
  if (ANIM && hasST && DESKTOP) {
    setP(0);
    ScrollTrigger.create({
      trigger: '#clockStage', start: 'top top', end: '+=110%', pin: true, scrub: true,
      onUpdate: function (self) { setP(self.progress); }
    });
  } else if (ANIM && hasST) {
    /* mobile: same journey, no pin. The vertical ledger lights station
       by station and the year advances as the section passes through
       the viewport; fully reversible. */
    setP(0);
    ScrollTrigger.create({
      trigger: '#clock', start: 'top 70%', end: 'bottom 92%', scrub: true,
      onUpdate: function (self) { setP(self.progress); }
    });
  } else {
    setP(1);   /* static fallback: the whole journey, already travelled */
  }
})();

/* ============================================================
   ACT 2 - room A: the bundle explodes into its parts;
   room B: the committee's checks tick in, by hand.
   ============================================================ */
(function () {
  var leaves = document.querySelectorAll('#bundleX .bx-leaf');
  var grid = document.getElementById('checkGrid');
  if (grid) {
    var cells = '';
    for (var r = 0; r < 4; r++) {
      for (var c = 0; c < 8; c++) {
        var x = 220 + c * 40, y = 60 + r * 40;
        cells += '<g class="ck"><rect x="' + x + '" y="' + y + '" width="24" height="24" fill="none" stroke="rgba(233,226,210,.4)"/>' +
          '<path class="ckt" d="M' + (x + 5) + ' ' + (y + 13) + ' l5 5 l9 -11" stroke="#C89A4C" stroke-width="2" fill="none" opacity="0"/></g>';
      }
    }
    grid.innerHTML = cells;
  }
  var ticks = document.querySelectorAll('#checkGrid .ckt');
  function setRooms(p) {
    leaves.forEach(function (g) {
      var fx = +g.dataset.fx, fy = +g.dataset.fy, fr = +g.dataset.fr;
      g.setAttribute('transform', 'translate(' + (fx * p) + ',' + (fy * p) + ') rotate(' + (fr * p) + ' 282 150)');
    });
    var n = Math.floor(p * ticks.length);
    ticks.forEach(function (t, i) { t.setAttribute('opacity', i < n ? '1' : '0'); });
  }
  if (ANIM && hasST) {
    /* desktop and mobile alike: the bundle fans out and the committee's
       checks tick in as the rooms cross the viewport, both directions */
    setRooms(0);
    ScrollTrigger.create({
      trigger: '#rooms', start: 'top 78%', end: 'center 42%', scrub: true,
      onUpdate: function (self) { setRooms(self.progress); }
    });
  } else {
    setRooms(1);   /* static fallback: fanned bundle, all checks ticked */
  }
})();

/* ============================================================
   FIELD EVIDENCE - plate reveals, console pan, bbox trace, filmstrip
   ============================================================ */
if (ANIM && hasST) {
  /* steady plates: fade-rise only, never zoom or crop; scrubbed both ways */
  gsap.utils.toArray('.plate:not(.rv)').forEach(function (p) {
    gsap.fromTo(p, { opacity: 0, y: 16 }, { opacity: 1, y: 0, ease: 'none',
      scrollTrigger: { trigger: p, start: 'top 97%', end: 'top 82%', scrub: true } });
  });
  /* console annotations slide in, staggered by window, reversible */
  gsap.utils.toArray('.ann').forEach(function (a, i) {
    gsap.fromTo(a, { opacity: 0, x: 26 }, { opacity: 1, x: 0, ease: 'none',
      scrollTrigger: { trigger: '.console-plate', start: 'top ' + (66 - i * 8) + '%', end: 'top ' + (52 - i * 8) + '%', scrub: true } });
  });
  /* bundle: brass bbox draws itself, then the label lands */
  var bbox = document.getElementById('bboxRect');
  if (bbox) gsap.to(bbox, { strokeDashoffset: 0, ease: 'none',
    scrollTrigger: { trigger: '.bundle-plate', start: 'top 75%', end: 'center 45%', scrub: true,
      onUpdate: function (self) {
        var l = document.getElementById('bboxLabel');
        if (l) l.classList.toggle('on', self.progress > 0.9);
      } } });
  /* filmstrip: pinned horizontal scrub on desktop; on mobile the reel is
     a native swipe and the rail + counter track the swipe position */
  var strip = document.getElementById('strip');
  if (strip && !DESKTOP) {
    strip.addEventListener('scroll', function () {
      var max = strip.scrollWidth - strip.clientWidth;
      var p = max > 0 ? strip.scrollLeft / max : 0;
      var f = document.getElementById('stripFill');
      if (f) f.style.width = (p * 100) + '%';
      var c = document.getElementById('stripCount');
      if (c) c.textContent = '0' + Math.min(5, 1 + Math.floor(p * 4.999)) + ' / 05';
    }, { passive: true });
  }
  if (strip && DESKTOP) {
    var dist = function () { return Math.max(0, strip.scrollWidth - document.documentElement.clientWidth); };
    gsap.to(strip, { x: function () { return -dist(); }, ease: 'none',
      scrollTrigger: { trigger: '#fieldstrip', start: 'top top', end: function () { return '+=' + (dist() + 80); },
        pin: true, scrub: true, invalidateOnRefresh: true,
        onUpdate: function (self) {
          var f = document.getElementById('stripFill');
          if (f) f.style.width = (self.progress * 100) + '%';
          var c = document.getElementById('stripCount');
          if (c) c.textContent = '0' + Math.min(5, 1 + Math.floor(self.progress * 4.999)) + ' / 05';
        } } });
  }
} else {
  document.getElementById('bboxLabel') && document.getElementById('bboxLabel').classList.add('on');
  var bb = document.getElementById('bboxRect'); if (bb) bb.style.strokeDashoffset = 0;
}

/* ============================================================
   X3 - the working loop: sources attach only when the plate
   nears the viewport; reduced motion keeps the still brief.
   ============================================================ */
(function () {
  var v = document.getElementById('consoleLoop');
  if (!v) return;
  if (REDUCE || !('IntersectionObserver' in window)) { v.remove(); return; }
  var plate = document.querySelector('.console-plate');
  var armed = false;
  function arm() {
    if (armed) return; armed = true;
    v.querySelectorAll('source').forEach(function (s) { s.src = s.dataset.src; });
    v.load();
    v.addEventListener('canplay', function once() {
      v.removeEventListener('canplay', once);
      plate.classList.add('video-live');
      v.play().catch(function () { plate.classList.remove('video-live'); });
    });
  }
  new IntersectionObserver(function (es, io) {
    es.forEach(function (e) {
      if (e.isIntersecting) { arm(); v.play && v.play().catch(function () {}); }
      else if (armed) { v.pause(); }
    });
  }, { rootMargin: '240px' }).observe(plate);
})();

/* ============================================================
   X4 - live third-party origin counter. The browser is the
   witness: PerformanceObserver counts every origin this page
   touched. If it is not zero, we say so, by name.
   ============================================================ */
(function () {
  var elC = document.getElementById('x4Count'), elO = document.getElementById('x4Origins');
  if (!elC || !elO) return;
  var origins = new Set();
  function note(list) {
    list.forEach(function (e) {
      try {
        var u = new URL(e.name);
        if (u.origin !== location.origin && u.protocol.indexOf('http') === 0) origins.add(u.host);
      } catch (err) {}
    });
    render();
  }
  function render() {
    elC.textContent = String(origins.size);
    elO.textContent = '';
    if (!origins.size) {
      var b = document.createElement('b');
      b.textContent = 'zero third-party origins observed';
      elO.appendChild(b);
      elO.appendChild(document.createTextNode(' · every byte served from ' + location.host));
    } else {
      var s = document.createElement('span');
      s.className = 'bad';
      s.textContent = 'observed: ' + Array.from(origins).join(' · ');
      elO.appendChild(s);
      elO.appendChild(document.createTextNode(' · we said zero. If you can read this, hold us to it.'));
    }
  }
  try { note(performance.getEntriesByType('resource')); } catch (e) { render(); }
  try {
    new PerformanceObserver(function (l) { note(l.getEntries()); }).observe({ type: 'resource', buffered: true });
  } catch (e) { render(); }
})();

/* ============================================================
   X7 - the guided walk: T or the hero button steps acts 0-6.
   Arrow keys advance, Escape exits. Off under reduced motion.
   ============================================================ */
(function () {
  var btn = document.getElementById('tourStart'), chip = document.getElementById('tourChip');
  if (!btn || !chip || REDUCE) return;
  btn.hidden = false;
  var STOPS = [
    ['#top',         'ACT 00', 'A tender becomes a decision system, before your eyes.'],
    ['#clock',       'ACT 01', 'India does not lack technology, capital, or talent. The bottleneck is the cycle.'],
    ['#rooms',       'ACT 02', 'Two rooms, one problem: trust in what the documents claim.'],
    ['#turn',        'ACT 03', 'What if every claim in the bundle had to show its work?'],
    ['#platform',    'ACT 03', 'Two volumes, one evidence engine.'],
    ['#console',     'ACT 04', 'The brief the team signs. Every number on it points to a page.'],
    ['#bidability',  'ACT 04', 'Why you may win, or lose. With evidence.'],
    ['#evidence',    'ACT 05', 'Every verdict carries its source. Uncertain cases go to a human. Always.'],
    ['#audit',       'ACT 05', 'Edit the record afterwards and the seam shows.'],
    ['#sovereignty', 'ACT 06', 'Nothing leaves the building. Your own browser is the witness.']
  ];
  var idx = -1, on = false;
  var pos = document.getElementById('tourPos'), line = document.getElementById('tourLine');
  function go(n) {
    if (n < 0 || n >= STOPS.length) { exit(); return; }
    idx = n;
    var s = STOPS[idx], el = document.querySelector(s[0]);
    if (!el) return;
    pos.textContent = s[1] + ' · ' + (idx + 1) + '/' + STOPS.length;
    line.textContent = s[2];
    chip.classList.add('on');
    if (lenis) lenis.scrollTo(el, { offset: -40, duration: 1.1 });
    else el.scrollIntoView({ behavior: 'smooth' });
  }
  function start() { on = true; go(0); }
  function exit() { on = false; idx = -1; chip.classList.remove('on'); }
  btn.addEventListener('click', start);
  /* touch path: tapping the caption chip advances to the next act */
  chip.addEventListener('click', function () { if (on) go(idx + 1); });
  /* taking the wheel back ends the walk; the caption never lingers
     over content it no longer describes (taps on the chip or the
     start button are not "taking the wheel back") */
  ['wheel', 'touchstart'].forEach(function (ev) {
    window.addEventListener(ev, function (e) {
      if (!on) return;
      if (e.target && e.target.closest && e.target.closest('#tourChip,#tourStart')) return;
      exit();
    }, { passive: true });
  });
  document.addEventListener('keydown', function (e) {
    if (e.target.matches && e.target.matches('input,textarea,select')) return;
    if (!on) { if (e.key === 't' || e.key === 'T') start(); return; }
    if (e.key === 'Escape') exit();
    else if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === 'Enter') { e.preventDefault(); go(idx + 1); }
    else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); go(idx - 1); }
  });
})();

/* one global re-measure now that every pin and trigger exists */
if (hasST) ScrollTrigger.refresh();

});
</script>
<style is:inline>
html.hero-fallback .scroll-cue{display:none}
.node-label{opacity:0;transition:opacity .3s}
.scroll-cue{transition:opacity .4s}
