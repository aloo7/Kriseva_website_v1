---
// /company: who we are, why defence and space, and who is on the record.
// Wording follows the claims register: titles exactly as stated, recognitions
// exactly as written, no institution named beyond the two allowed programmes.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import TitleBlock from '../components/site/company/TitleBlock.astro';
import Story from '../components/site/company/Story.astro';
import Team from '../components/site/company/Team.astro';
import Recognition from '../components/site/company/Recognition.astro';
import Facts from '../components/site/company/Facts.astro';
import Hiring from '../components/site/company/Hiring.astro';
import { breadcrumbSchema } from '../data/kriseva';

const crumbs = [{ name: 'Company', path: '/company' }];
---
<SiteLayout
  title="Company | Kriseva: building the bridge for defence and space procurement"
  description="Kriseva AI Private Limited, Hyderabad, incorporated 7 May 2026. Our story, our team and our aim: the evidence layer for Indian procurement, starting with defence and space. Pre-revenue and bootstrapped."
  path="/company"
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    eyebrow="Company"
    title="We are building the bridge for defence and space procurement."
    accent="the bridge"
    lead="Kriseva AI Private Limited is a Hyderabad company, incorporated on 7 May 2026. Our aim is to be the evidence layer that India’s suppliers and government buyers can both check."
    crumbs={crumbs}
  >
    <Fragment slot="actions">
      <a class="btn" href="#team">Meet the team <span class="arrow" aria-hidden="true">&rarr;</span></a>
      <a class="btn btn--ghost" href="/proof">See the record</a>
    </Fragment>
    <Fragment slot="visual"><TitleBlock /></Fragment>
  </PageHero>

  <Story />
  <Team />
  <Recognition />
  <Facts />
  <Hiring />
</SiteLayout>
