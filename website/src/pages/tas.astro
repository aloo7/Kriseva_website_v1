---
// /tas: TAS, for suppliers (Tender Automation System). v3 "Bridge" page.
// Hero, the supplier's morning, eight modules, the decision card, how a
// pilot works with measured numbers, sovereignty, FAQ, next move.
// Numbers come from src/data/stats.ts; every tender shown is a SPECIMEN.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import Faq from '../components/site/Faq.astro';
import TasHeroVisual from '../components/site/tas/TasHeroVisual.astro';
import TasProblem from '../components/site/tas/TasProblem.astro';
import TasModules from '../components/site/tas/TasModules.astro';
import TasDecisionCard from '../components/site/tas/TasDecisionCard.astro';
import TasPilot from '../components/site/tas/TasPilot.astro';
import TasSovereign from '../components/site/tas/TasSovereign.astro';
import TasCross from '../components/site/tas/TasCross.astro';
import { breadcrumbSchema, faqSchema, softwareSchema } from '../data/kriseva';
import { measured } from '../data/stats';
import type { Faq as FaqItem } from '../data/faq';

const title = 'TAS: tender intelligence for defence and space suppliers | Kriseva';
const description =
  'TAS reads GeM, CPPP, ISRO and defence procurement portals, scores each tender against your capability, and writes a bid or skip brief. Runs on-premise.';

const tasFaqs: FaqItem[] = [
  {
    q: 'Which tender portals does TAS read?',
    a: `On ${measured.tasSources.asOf}, TAS was reading ${measured.tasSources.value} public sources, including GeM, CPPP, ISRO e-Procurement, NSIL, IN-SPACe, Defence eProcurement, eTenders and state NIC portals, and held ${measured.tasOpenTenders.value} distinct open tenders.`,
  },
  {
    q: 'How does TAS decide between bid, review and skip?',
    a: 'It does not decide. TAS scores each tender against your own capability list and proposes a call, with the reasons written out and the clause behind each one. Your bid team reads the brief and makes the decision.',
  },
  {
    q: 'Can TAS submit a bid for us?',
    a: 'No. TAS prepares: it finds tenders, reads them, and builds the checklist and document pack. Your team reviews everything and submits on the portal.',
  },
  {
    q: 'Does our capability list leave our machine?',
    a: 'It does not have to. TAS runs on your own computer with local models, and no cloud account is needed to read a tender. TAS goes online to read public procurement portals, and only when you let it.',
  },
  {
    q: 'We make space systems, not defence equipment. Is TAS for us too?',
    a: 'Yes. TAS reads space-sector sources such as ISRO e-Procurement, NSIL and IN-SPACe alongside GeM, CPPP and the defence portals, so space-systems makers and start-ups get one shortlist across both.',
  },
  {
    q: 'What does a pilot involve, and what does it cost?',
    a: 'We set TAS up on your machine, load your capability list and run it on live tenders with your bid team. We quote per engagement after the pilot, based on the modules, deployment and team size you need. Build a request on the Plans page and the founder replies directly.',
  },
];

const schema = [
  softwareSchema({
    name: 'Kriseva TAS',
    path: '/tas',
    description:
      'Tender intelligence for defence and space suppliers: reads public procurement portals, scores each tender against your capability list, and prepares a bid or skip brief with the clause behind every reason. Runs on-premise.',
    audience: 'Defence and space suppliers',
  }),
  breadcrumbSchema([{ name: 'TAS', path: '/tas' }]),
  faqSchema(tasFaqs),
];
---
<SiteLayout title={title} description={description} path="/tas" schema={schema}>
  <PageHero
    eyebrow="Products · TAS · For suppliers"
    title="Find, read and answer the tenders you can win."
    accent="tenders you can win"
    lead="TAS reads GeM, CPPP, ISRO, defence and state portals in one search and scores each tender against your capability list. Your bid team gets a short list, and every reason points to a clause."
    crumbs={[{ name: 'TAS', path: '/tas' }]}
  >
    <Fragment slot="actions">
      <a class="btn" href="/contact?intent=pilot&amp;side=supplier">Request a TAS pilot <span class="arrow" aria-hidden="true">&rarr;</span></a>
      <a class="btn btn--ghost" href="/contact?intent=demo">Book a demo</a>
    </Fragment>
    <Fragment slot="visual">
      <TasHeroVisual />
    </Fragment>
  </PageHero>

  <TasProblem />
  <TasModules />
  <TasDecisionCard />
  <TasPilot />
  <TasSovereign />
  <Faq items={tasFaqs} index="06" title="TAS, in six answers." id="faq" />
  <TasCross />
</SiteLayout>
