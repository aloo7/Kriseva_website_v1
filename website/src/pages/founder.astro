---
// /founder - founder dossier. Photo, register-sourced bio claims
// (founder.* in publicClaims.ts), direct contact. No hagiography;
// status-labelled entries only.

import V6Layout from '../layouts/V6Layout.astro';
import SectionHead from '../components/v6/SectionHead.astro';
import { getClaim } from '../data/publicClaims';

const observation = getClaim('founder.observation')!.wording;
const insight = getClaim('founder.insight')!.wording;
const thesis = getClaim('founder.thesis')!.wording;
const education = getClaim('founder.education')!.wording;
const priorWork = getClaim('founder.prior-work')!.wording;
const iiec = getClaim('record.iiec')!.wording;

const title = 'Founder · Ayush Tiwary · KRISEVA AI';
const description = 'Ayush Tiwary, founder of KRISEVA AI. ' + observation + ' ' + thesis;
---
<V6Layout title={title} description={description} path="/founder">

  <!-- ============ HERO ============ -->
  <section class="ihero" aria-label="Founder">
    <div class="wrap fgrid">
      <div>
        <p class="eyebrow">The founder · direct line</p>
        <h1 class="display">Built from the <em class="em-brass">field, not a deck.</em></h1>
        <p class="dek">{observation}</p>
        <p class="dek" style="margin-top:14px">{insight}</p>
        <div class="acts">
          <a class="btn btn-fill" href="/contact">Speak directly <span class="arr">→</span></a>
        </div>
      </div>
      <div class="fcard regmark rv">
        <div class="fph"><img src="/assets/v6/founder_ayush.jpg" width="900" height="1125" alt="Ayush Tiwary, founder of KRISEVA AI" loading="eager" /></div>
        <b>Ayush Tiwary</b>
        <div class="fmeta">
          Founder · KRISEVA AI<br />
          {education}<br />
          <a href="mailto:ayush@kriseva.in">ayush@kriseva.in</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ THESIS ============ -->
  <section class="sec-pad sec-sunk" id="thesis">
    <div class="wrap">
      <blockquote class="fquote rv">{thesis}</blockquote>
    </div>
  </section>

  <!-- ============ THE RECORD ============ -->
  <section class="sec-pad" id="dossier">
    <div class="wrap">
      <SectionHead eyebrow="The dossier · status-labelled" folio="§01 / 02"
        dek="A record of exposure, context and discovery. Each entry carries its register category; nothing here outruns its evidence.">
        On file.
      </SectionHead>
      <div class="record rv">
        <div class="rec"><span class="date">Exposure</span><span class="what">{priorWork}</span><span class="tag">safe-with-care</span></div>
        <div class="rec"><span class="date">Context</span><span class="what">{education}</span><span class="tag">On record</span></div>
        <div class="rec"><span class="date">Origin</span><span class="what">{iiec}</span><span class="tag">On record</span></div>
        <div class="rec"><span class="date">Discovery</span><span class="what">{insight}</span><span class="tag">Field-sourced</span></div>
      </div>
    </div>
  </section>

  <!-- ============ DIRECT CONTACT ============ -->
  <section class="sec-pad sec-navy" id="direct">
    <div class="wrap">
      <SectionHead eyebrow="Speak directly" folio="§02 / 02"
        dek="Bidder-side, evaluation-side, or institutional: the conversation is direct and founder-led. No SDR funnel.">
        One inbox. <em class="em-brass">The founder's.</em>
      </SectionHead>
      <div class="acts rv" style="display:flex;flex-wrap:wrap;gap:14px">
        <a class="btn btn-fill" href="/contact">Contact the founder <span class="arr">→</span></a>
        <a class="btn btn-line" href="mailto:ayush@kriseva.in">ayush@kriseva.in</a>
      </div>
    </div>
  </section>

</V6Layout>

<style is:global>
/* /founder page-specific */
.fgrid{display:grid;grid-template-columns:minmax(0,7fr) minmax(280px,4fr);gap:clamp(28px,4vw,72px);align-items:start}
.fcard{border:1px solid var(--ink);border-radius:2px;padding:22px;background:var(--paper-raised)}
.fph{margin:-22px -22px 18px;overflow:hidden;border-bottom:1px solid var(--ink);aspect-ratio:4/5}
.fph img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.92)}
.fcard b{display:block;font-family:var(--serif);font-weight:400;font-size:1.6rem;letter-spacing:-.01em;margin-bottom:6px}
.fcard .fmeta{font-size:.9rem;line-height:1.9;color:var(--ink-sec)}
.fcard a{color:var(--brass-deep);text-decoration:none;border-bottom:1px solid rgba(168,114,41,.4)}
.fcard a:hover{border-bottom-color:var(--brass-deep)}
.fquote{font-family:var(--serif);font-weight:400;font-size:clamp(1.7rem,3.6vw,3.4rem);
  line-height:1.18;letter-spacing:-0.015em;text-wrap:balance;max-width:26ch}
@media (max-width:900px){.fgrid{grid-template-columns:1fr}.fcard{max-width:420px}}
</style>
