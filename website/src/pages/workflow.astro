---
// /workflow - the operator's day, before and after, plus the evidence trail.
// Process description, not capability inflation; before/after content carried
// over from the prior approved page, restyled to the v6 system.

import V6Layout from '../layouts/V6Layout.astro';
import SectionHead from '../components/v6/SectionHead.astro';
import Plate from '../components/v6/Plate.astro';
import { getClaim } from '../data/publicClaims';

const recommendation = getClaim('tas.recommendation')!.wording;

const title = 'Workflow · From scattered downloads to a signed decision';
const description = 'What changes when a bid team moves from portal-and-Excel discipline to a tender intelligence workflow with clause-and-page evidence and an audit-ready brief.';

const before = [
  'Manual portal search across GeM, DefProc public, DPSU sites.',
  'Scattered downloads: RFP, BOQ, ATCs, corrigenda each in a different folder.',
  'RFP, spec, BOQ, corrigenda, annexures reviewed separately.',
  'Excel tracking with manual status columns.',
  'Technical fit decided over calls and chat threads.',
  'Compliance reconstructed from memory and a tab-switching pass.',
  'Bid / no-bid decisioning lives in a person, not a record.',
];

const after = [
  'Supported import / search flows for GeM and DefProc public discovery.',
  'Tender represented as a bundle, not isolated files.',
  'Parsing status tracked per document, with retry where parse fails.',
  'Extracted key clauses and fields with clause + page citations.',
  'Relevance score against company capability context, override-able.',
  'Compliance requirements with source evidence where available.',
  'Decision brief with BID / REVIEW / SKIP recommendation.',
  'Operator records the decision and rationale against the bundle.',
];

const trail = [
  { k: 'Clause', v: 'SPEC §3.2 · p.18 · "minimum 50% indigenous content"' },
  { k: 'Extracted field', v: 'make_in_india_min: 50% · provenance kept' },
  { k: 'Compliance row', v: 'Make-in-India content ≥ 50% · evidence attached' },
  { k: 'Brief line', v: 'Met as declared; certificate on file · [SPEC §3.2]' },
  { k: 'Signed decision', v: 'REVIEW → BID · operator signature · on the record' },
];
---
<V6Layout title={title} description={description} path="/workflow">

  <!-- ============ HERO ============ -->
  <section class="ihero" aria-label="Workflow">
    <div class="wrap">
      <p class="eyebrow">The workflow · operator-shaped, not autonomous</p>
      <h1 class="display">Reading is not the work. <em class="em-brass">Reconstruction is.</em></h1>
      <p class="dek">Finding tenders is easy. The hard work sits between alert and a defensible decision: extraction, eligibility cross-check, compliance reconstruction, and a brief that survives audit.</p>
      <div class="acts">
        <a class="btn btn-fill" href="/contact">Request a demo <span class="arr">→</span></a>
        <a class="btn btn-line" href="/tas">The product behind it</a>
      </div>
    </div>
  </section>

  <!-- ============ BEFORE / AFTER ============ -->
  <section class="sec-pad sec-sunk" id="beforeafter" style="padding-top:clamp(40px,5vw,70px)">
    <div class="wrap">
      <SectionHead eyebrow="Before / after · the same operator" folio="§01 / 04"
        dek="Portal-and-Excel discipline does the work but leaves no reviewable artifact. The workflow change produces the artifact alongside the decision.">
        One workflow change.
      </SectionHead>
      <div class="ba rv">
        <div class="ba-col regmark">
          <div class="ba-h">Before · manual discipline</div>
          <ul>{before.map((b) => <li>{b}</li>)}</ul>
        </div>
        <div class="ba-col ba-after regmark">
          <div class="ba-h">After · evidence-linked workflow</div>
          <ul>{after.map((a) => <li>{a}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ THE MORNING QUEUE ============ -->
  <section class="sec-pad" id="queue">
    <div class="wrap">
      <SectionHead eyebrow="Field evidence · the operator's morning" folio="§02 / 04"
        dek="The day starts in a queue, not a search box: what needs action, what is ready, what waits, what is blocked.">
        A queue, <em class="em-brass">not a search box.</em>
      </SectionHead>
      <Plate kicker="TAS" head="00 · Home · operator control surface" meta="what-needs-action lanes"
        src="/assets/v6/console_home.jpg" width={1700} height={1200}
        alt="KRISEVA TAS home: operator control surface with what-needs-action lanes: action 5, ready 3, waiting 2, blocked 1"
        capLeft="Action 5 · ready 3 · waiting 2 · blocked 1" class="rv" />
      <p class="disclose">Synthetic / seeded demo data, not a real tender.</p>
    </div>
  </section>

  <!-- ============ EVIDENCE TRAIL ============ -->
  <section class="sec-pad sec-navy" id="trail">
    <div class="wrap">
      <SectionHead eyebrow="The evidence trail · clause to signature" folio="§03 / 04"
        dek="One requirement, traced end to end. Every step keeps the pointer back to the page it came from.">
        Follow one clause <em class="em-brass">all the way down.</em>
      </SectionHead>
      <div class="trail" role="list">
        {trail.map((t, i) => (
          <div class="trow rv" role="listitem" style={`transition-delay:${i * 120}ms`}>
            <span class="tk">{String(i + 1).padStart(2, '0')} · {t.k}</span>
            <span class="tv">{t.v}</span>
          </div>
        ))}
      </div>
      <p class="disclose">Illustrative trace on synthetic demo content.</p>
    </div>
  </section>

  <!-- ============ BOTH SIDES ============ -->
  <section class="sec-pad" id="bothsides">
    <div class="wrap">
      <SectionHead eyebrow="Both sides of the table" folio="§04 / 04"
        dek="The bidder assembles the evidence; the committee weighs it. One engine carries the provenance through both.">
        The same evidence, <em class="em-brass">twice read.</em>
      </SectionHead>
      <div class="record rv">
        <div class="rec"><span class="date">Vol. I</span><span class="what"><b>KRISEVA TAS</b> · {recommendation}</span><a class="tag" href="/tas" style="text-decoration:none">TAS →</a></div>
        <div class="rec"><span class="date">Vol. II</span><span class="what"><b>KRISEVA EVALUATOR</b> · committee-assist evaluation; uncertainty routes to humans; the audit chain keeps the record.</span><a class="tag" href="/evaluator" style="text-decoration:none">Evaluator →</a></div>
      </div>
    </div>
  </section>

</V6Layout>

<style is:global>
/* /workflow page-specific */
.ba{display:grid;grid-template-columns:1fr 1fr;gap:clamp(16px,2.4vw,34px)}
.ba-col{border:1px dashed var(--ink-sec);border-radius:2px;background:transparent;padding:clamp(16px,2.2vw,26px)}
.ba-col.ba-after{border-style:solid;border-color:var(--ink);background:var(--paper-raised)}
.ba-h{font-family:var(--mono);font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;
  color:var(--ink-sec);margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--rule)}
.ba-col ul{list-style:none}
.ba-col li{padding:9px 0;border-bottom:1px solid var(--rule);font-size:.92rem;line-height:1.5;color:var(--ink-sec)}
.ba-col.ba-after li{color:var(--ink)}
.ba-col li:last-child{border-bottom:none}
@media (max-width:860px){.ba{grid-template-columns:1fr}}

.trail{border-top:1px solid rgba(233,226,210,.3)}
.trow{display:grid;grid-template-columns:minmax(180px,260px) 1fr;gap:10px 26px;align-items:baseline;
  padding:15px 2px;border-bottom:1px solid rgba(233,226,210,.18);position:relative}
/* clause-trace: a brass tick draws in as each step of the trace lands */
.trow::before{content:"";position:absolute;left:-14px;top:18px;bottom:18px;width:2px;
  background:var(--brass-lt);transform:scaleY(0);transform-origin:top;transition:transform .5s ease .15s}
html.js .trow.in::before{transform:scaleY(1)}
html.no-js .trow::before{transform:scaleY(1)}
@media (prefers-reduced-motion: reduce){.trow::before{transform:scaleY(1);transition:none}}
.trow .tk{font-family:var(--mono);font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--brass-lt)}
.trow .tv{font-family:var(--mono);font-size:.8rem;letter-spacing:.04em;color:var(--on-navy-dim)}
@media (max-width:700px){.trow{grid-template-columns:1fr;gap:4px}}
</style>
