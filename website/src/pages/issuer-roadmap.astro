---
import BaseLayout from '../layouts/BaseLayout.astro';
import RouteHero from '../components/RouteHero.astro';
import SectionLabel from '../components/SectionLabel.astro';
import DossierCard from '../components/DossierCard.astro';
import FounderCTA from '../components/FounderCTA.astro';
import PrimaryButton from '../components/PrimaryButton.astro';
import SecondaryButton from '../components/SecondaryButton.astro';
import MotifFrame from '../components/MotifFrame.astro';
import { routes } from '../data/routes';
import { claims } from '../data/claims';

const title = 'Issuer-Side Roadmap';
const description = 'Issuer-side procurement intelligence is a roadmap direction under validation and pilot exploration. Strategic memo: AI-assisted technical and financial bid evaluation, RFP ambiguity surfacing, evidence-linked compliance review, and decision auditability.';
---
<BaseLayout title={title} description={description}>
  <RouteHero
    eyebrow="Issuer-Side · Roadmap Memo"
    title="Issuer-side procurement intelligence is<br /><span class='brass'>a roadmap direction, not a launched product.</span>"
    subtitle={claims.issuerRoadmap}
    meta="Roadmap · Validation · Pilot Exploration · No agency endorsement claimed"
  >
    <Fragment slot="cta">
      <SecondaryButton href={routes.contactWithIntent('issuer')}>Issuer-side discussion</SecondaryButton>
      <PrimaryButton href={routes.contact}>Contact Founder</PrimaryButton>
    </Fragment>
  </RouteHero>

  {/* Status banner + roadmap phases */}
  <section class="section section--paper" style="padding-top:48px;padding-bottom:64px;">
    <div class="container">
      <div class="iss-banner reveal">
        <header class="iss-banner__head">
          <p class="iss-banner__heading">STATUS · NOT LAUNCHED</p>
          <p class="iss-banner__id">§ 01 / ROADMAP MEMO</p>
        </header>
        <p>
          {claims.issuerNotProduct} The page below is a strategic memo describing capabilities under exploration. It is published so stakeholders can evaluate the direction and decide whether to engage.
        </p>
      </div>

      <ol class="iss-phases" data-stagger aria-label="Issuer-side exploration phases. Decorative.">
        <li class="reveal iss-phases__item iss-phases__item--current">
          <span class="iss-phases__num">01</span>
          <span class="iss-phases__label">Discovery</span>
          <span class="iss-phases__sub">Senior procurement-side conversations · ongoing</span>
          <span class="iss-phases__chip iss-phases__chip--active">CURRENT</span>
        </li>
        <li class="reveal iss-phases__item">
          <span class="iss-phases__num">02</span>
          <span class="iss-phases__label">Spec exploration</span>
          <span class="iss-phases__sub">Capability sketches under validation</span>
          <span class="iss-phases__chip">EXPLORING</span>
        </li>
        <li class="reveal iss-phases__item">
          <span class="iss-phases__num">03</span>
          <span class="iss-phases__label">Pilot pairing</span>
          <span class="iss-phases__sub">Identify a willing issuer-side partner · confidential</span>
          <span class="iss-phases__chip">ROADMAP</span>
        </li>
        <li class="reveal iss-phases__item">
          <span class="iss-phases__num">04</span>
          <span class="iss-phases__label">Pilot execution</span>
          <span class="iss-phases__sub">Operator-assisted evaluation workflows · scoped</span>
          <span class="iss-phases__chip">ROADMAP</span>
        </li>
        <li class="reveal iss-phases__item">
          <span class="iss-phases__num">05</span>
          <span class="iss-phases__label">Generalization</span>
          <span class="iss-phases__sub">If pilot validates, expand to broader procurement contexts</span>
          <span class="iss-phases__chip">ROADMAP</span>
        </li>
      </ol>

      <p class="iss-phases__discipline">
        Each phase is conditional on the previous · No timeline committed · No agency relationship implied
      </p>
    </div>
  </section>

  {/* Capability sketches */}
  <section class="section section--dark">
    <div class="container">
      <SectionLabel>Capability Sketches</SectionLabel>
      <h2 class="reveal" style="margin-bottom:14px;">What issuer-side intelligence could look like.</h2>
      <p class="reveal" style="color:var(--paper-mute);max-width:720px;margin-bottom:36px;">
        Each card describes a capability under validation with senior issuer-side stakeholders. Wording is exploratory by design.
      </p>
      <div class="iss-grid" data-stagger>
        <div class="reveal"><DossierCard label="01" title="AI-assisted bid evaluation" meta="Under exploration">
          Operator-assisted workflows for technical and financial bid evaluation. The evaluator stays in the loop; the system surfaces the evidence.
        </DossierCard></div>
        <div class="reveal"><DossierCard label="02" title="RFP ambiguity surfacing" meta="Under exploration">
          Pre-publication review of RFP language for ambiguity and contradiction. Reduces clarification volume and bidder confusion.
        </DossierCard></div>
        <div class="reveal"><DossierCard label="03" title="Compliance review burden" meta="Under exploration">
          Compliance evidence presented per bidder, anchored to the source clause. Reduces reconstruction time without removing the reviewer.
        </DossierCard></div>
        <div class="reveal"><DossierCard label="04" title="Evidence-linked evaluation" meta="Under exploration">
          Every evaluation note points back to a clause and a page in the bid. The decision artifact is reviewable, including by audit.
        </DossierCard></div>
        <div class="reveal"><DossierCard label="05" title="Auditability" meta="Under exploration">
          Decision history, evaluator override trail, and corrigenda watch live with the bundle, not in a separate spreadsheet.
        </DossierCard></div>
        <div class="reveal"><DossierCard label="06" title="Procurement-side decision traceability" meta="Under exploration">
          The procurement-side decision artifact is structured the same way as the bidder-side one. Both sides see the same evidence shape.
        </DossierCard></div>
      </div>
    </div>
  </section>

  {/* What this is not */}
  <section class="section section--paper">
    <div class="container">
      <SectionLabel>What this page is not</SectionLabel>
      <h2 class="reveal" style="margin-bottom:14px;">Carefully labeled, not aspirationally branded.</h2>
      <ul class="iss-not" data-stagger>
        <li class="reveal"><span class="iss-not__tag">NOT</span> A live issuer-side product.</li>
        <li class="reveal"><span class="iss-not__tag">NOT</span> Backed by any government agency.</li>
        <li class="reveal"><span class="iss-not__tag">NOT</span> Validated by Indian Army, DRDO, CRPF, or any defense PSU.</li>
        <li class="reveal"><span class="iss-not__tag">NOT</span> An official government platform.</li>
        <li class="reveal"><span class="iss-not__tag">NOT</span> A claim of CPPP or DefProc protected-flow integration.</li>
      </ul>
      <p class="reveal" style="margin-top:18px;font-family:var(--font-mono);font-size:0.74rem;color:var(--slate-600);letter-spacing:0.08em;">
        No military or government endorsement claimed or implied.
      </p>
    </div>
  </section>

  {/* Stakeholder discovery summary */}
  <section class="section section--navy">
    <div class="container iss-discovery">
      <div class="reveal">
        <SectionLabel>Stakeholder Discovery</SectionLabel>
        <h2>Conversations under way, anonymized by default.</h2>
        <p style="color:var(--paper-mute);max-width:560px;margin-bottom:18px;">
          The roadmap is informed by long-form conversations with senior procurement-side stakeholders. Identities are anonymized unless permission is on record.
        </p>
        <p style="font-family:var(--font-mono);font-size:0.72rem;letter-spacing:0.08em;color:var(--brass);text-transform:uppercase;">
          No public attribution unless authorized.
        </p>
      </div>
      <div class="reveal">
        <MotifFrame
          src="/assets/motifs/issuer-side-roadmap.svg"
          alt="Issuer-side roadmap motif — exploratory capability map"
          width={800}
          height={500}
          surface="navy"
          topLabel="ISSUER-SIDE · NOT LAUNCHED"
          caption="Decorative · Exploratory capability map · Anonymized discovery only"
        />
      </div>
    </div>
  </section>

  <FounderCTA
    heading="Issuer-side conversation?"
    body="If you sit on the procurement side and want to discuss the issuer-side direction, the conversation is direct. Confidential by default. Findings feed product spec, not marketing."
  />
</BaseLayout>

<style>
  /* ─────────────── Status banner ─────────────── */
  .iss-banner {
    border: 1px dashed rgba(154, 106, 32, 0.55);
    background: rgba(154, 106, 32, 0.06);
    border-radius: var(--radius-frame);
    padding: 24px 28px;
    box-shadow: var(--shadow-lift);
    margin-bottom: 36px;
  }
  .iss-banner__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px dashed rgba(154, 106, 32, 0.32);
  }
  .iss-banner__heading {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--decision-review);
    text-transform: uppercase;
  }
  .iss-banner__id {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    color: var(--ink-quiet);
    text-transform: uppercase;
  }
  .iss-banner p { color: var(--ink); line-height: 1.65; }

  /* ─────────────── Phases (5-stage roadmap) ─────────────── */
  .iss-phases {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid rgba(16, 35, 59, 0.18);
  }
  .iss-phases__item {
    display: grid;
    grid-template-columns: 70px 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 18px;
    padding: 16px 0;
    border-bottom: 1px dashed rgba(193, 138, 62, 0.32);
    align-items: baseline;
  }
  .iss-phases__item--current {
    border-bottom-style: solid;
    border-bottom-color: var(--accent-primary);
    background:
      linear-gradient(90deg, rgba(193, 138, 62, 0.08) 0%, transparent 50%);
    padding-left: 12px;
    margin-left: -12px;
    border-left: 3px solid var(--accent-primary);
  }
  .iss-phases__num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    color: var(--accent-soft);
    text-transform: uppercase;
    grid-row: 1 / 3;
    align-self: center;
  }
  .iss-phases__item--current .iss-phases__num { color: var(--accent-primary); }
  .iss-phases__label {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    color: var(--surface-deep);
    line-height: 1.3;
  }
  .iss-phases__sub {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--ink-quiet);
    text-transform: uppercase;
    grid-column: 2;
  }
  .iss-phases__chip {
    grid-column: 3;
    grid-row: 1 / 3;
    align-self: center;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    color: var(--ink-quiet);
    background: rgba(16, 35, 59, 0.04);
    border: 1px solid rgba(16, 35, 59, 0.16);
    padding: 4px 9px;
    border-radius: 3px;
    text-transform: uppercase;
  }
  .iss-phases__chip--active {
    color: var(--accent-primary);
    background: rgba(193, 138, 62, 0.08);
    border: 1px solid var(--accent-primary);
  }
  .iss-phases__discipline {
    margin-top: 16px;
    padding: 12px 16px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: var(--ink-quiet);
    text-transform: uppercase;
    border-left: 2px dashed rgba(193, 138, 62, 0.45);
  }
  @media (max-width: 600px) {
    .iss-phases__item {
      grid-template-columns: 56px 1fr;
      grid-template-rows: auto auto auto;
      gap: 4px 14px;
    }
    .iss-phases__num { grid-row: 1 / 2; }
    .iss-phases__label { grid-column: 2; }
    .iss-phases__sub { grid-column: 2; }
    .iss-phases__chip { grid-column: 2; grid-row: 3; justify-self: start; align-self: start; margin-top: 4px; }
  }

  /* ─────────────── Capability sketches ─────────────── */
  .iss-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  @media (max-width: 980px) { .iss-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .iss-grid { grid-template-columns: 1fr; } }

  /* ─────────────── Not-list with dashed-rule discipline ─────────────── */
  .iss-not { display: grid; gap: 10px; max-width: 760px; }
  .iss-not li {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 14px;
    padding: 14px 18px;
    border: 1px solid rgba(154, 53, 44, 0.32);
    /* Dashed left rule = "we do not claim this". */
    border-left: 2px dashed rgba(154, 53, 44, 0.55);
    background: rgba(154, 53, 44, 0.04);
    border-radius: var(--radius-control);
    color: var(--ink);
    list-style: none;
    font-size: 0.94rem;
    line-height: 1.5;
  }
  @media (max-width: 420px) {
    .iss-not li { grid-template-columns: 44px 1fr; gap: 10px; padding: 12px 14px; }
    .iss-not__tag { font-size: 0.62rem; letter-spacing: 0.14em; }
  }
  .iss-not__tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    color: var(--decision-skip);
    text-transform: uppercase;
    padding-top: 2px;
  }

  .iss-discovery {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 48px;
    align-items: center;
  }
  @media (max-width: 880px) { .iss-discovery { grid-template-columns: 1fr; gap: 32px; } }
</style>
