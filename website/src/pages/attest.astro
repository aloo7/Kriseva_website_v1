---
// /attest: Kriseva Labs, ATTEST. A calm secondary page for a research-stage
// prototype. Status wording is fixed (see STATUS below). No regulator or
// regulatory official is named, and nothing here claims a deployment, a
// filing, an approval or a result. The public demonstration hub link is kept
// because the previous /attest page already linked to it; it is labelled as a
// demonstration on synthetic data.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import StatusCard from '../components/site/attest/StatusCard.astro';
import EvidenceFigure from '../components/site/attest/EvidenceFigure.astro';
import { breadcrumbSchema, company } from '../data/kriseva';

const STATUS = "Research-stage prototype with synthetic data for IFSC fund managers' quarter-close evidence.";
const BOUNDARY = 'This prototype has shipped to nobody.';
const HUB_URL = 'https://ayushtiwary-ops.github.io/kriseva-attest';
const mail = `mailto:${company.email}?subject=${encodeURIComponent('Kriseva Labs: ATTEST')}`;
const crumbs = [{ name: 'Kriseva Labs: ATTEST', path: '/attest' }];

const beats = [
  {
    n: '01',
    t: 'Seal the sources',
    d: 'Source documents are sealed when they arrive, so every later check points back to exactly what came in.',
  },
  {
    n: '02',
    t: 'Read three ways',
    d: 'Each value is read through three independent extraction paths. Where they disagree, the disagreement is shown, never settled silently.',
  },
  {
    n: '03',
    t: 'Bind it, then hand it to a person',
    d: 'Every value is bound to the page that produced it. A named human resolves each conflict and states the reason.',
  },
];

const notClaimed = [
  'It is not connected to any regulator system.',
  'It does not interpret regulation, state what a rule requires, or claim that a number is correct. It surfaces evidence; a named human decides.',
  'It runs on synthetic data, not on real fund documents or real company data.',
];
---
<SiteLayout
  title="Kriseva Labs: ATTEST | Research prototype"
  description={`${STATUS} Every value is bound to the page that produced it.`}
  path="/attest"
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    eyebrow="Kriseva Labs · Research"
    title="ATTEST: every number, traced to its page."
    accent="traced to its page"
    lead={STATUS}
    crumbs={crumbs}
  >
    <Fragment slot="actions">
      <a class="btn" href={mail}>Email the founder <span class="arrow" aria-hidden="true">&rarr;</span></a>
      <a class="btn btn--ghost" href="#how">How it works</a>
    </Fragment>
    <Fragment slot="visual"><StatusCard /></Fragment>
  </PageHero>

  <section class="section att-how" id="how" aria-labelledby="att-how-title">
    <div class="wrap att-how__grid">
      <div class="att-how__fig rv">
        <EvidenceFigure />
      </div>
      <div class="att-how__copy">
        <header class="att-how__head">
          <p class="eyebrow">How it works · three beats</p>
          <h2 id="att-how-title" class="h2">Seal it. Read it three ways. <em>Hand it to a person.</em></h2>
          <p class="lead">ATTEST is Kriseva Labs’ research into evidence review for regulated finance. It reuses the discipline at the core of Kriseva’s products: nothing without its source, and a person who decides.</p>
        </header>
        <ol role="list" class="att-beats rv-stagger">
          {beats.map((b) => (
            <li class="att-beat">
              <span class="att-beat__n mono" aria-hidden="true">{b.n}</span>
              <h3 class="att-beat__t">{b.t}</h3>
              <p class="att-beat__d">{b.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--tight on-paper-2 att-demo" aria-labelledby="att-demo-title">
    <div class="wrap att-demo__grid">
      <div class="att-demo__copy">
        <p class="eyebrow">A demonstration</p>
        <h2 id="att-demo-title" class="h3">See the flow on invented data.</h2>
        <p class="att-demo__text">A demonstration hub, published 12 August 2026, runs on synthetic data with a deterministic review workflow. It is a demonstration, not a service.</p>
      </div>
      <div class="att-demo__cta">
        <a class="btn btn--ghost" href={HUB_URL} target="_blank" rel="noopener">Open the demonstration <span class="arrow" aria-hidden="true">&rarr;</span></a>
        <p class="mono att-demo__note">Synthetic-data demonstration. Not connected to any regulator system.</p>
      </div>
    </div>
  </section>

  <section class="section on-navy-hatch att-bound" aria-labelledby="att-bound-title">
    <div class="wrap att-bound__grid">
      <div class="att-bound__copy">
        <p class="eyebrow">The boundary</p>
        <h2 id="att-bound-title" class="h2">What this prototype <em>is not.</em></h2>
        <p class="att-bound__line">{BOUNDARY}</p>
        <p class="att-bound__more">The same discipline runs through <a href="/tas">TAS</a> and <a href="/evaluator">Evaluator</a>, Kriseva’s products for defence and space procurement.</p>
      </div>
      <div class="att-bound__side">
        <ul role="list" class="att-bound__list">
          {notClaimed.map((n) => <li>{n}</li>)}
        </ul>
        <div class="att-bound__cta">
          <a class="btn btn--brass" href={mail}>Email the founder <span class="arrow" aria-hidden="true">&rarr;</span></a>
          <a class="link-arrow" href="/">Back to Kriseva <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .att-how__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .att-how__fig {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    max-width: 440px;
    min-width: 0;
  }

  .att-how__copy {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    min-width: 0;
  }

  .att-how__head {
    display: grid;
    gap: 1.25rem;
  }

  .att-beats {
    display: grid;
    border-top: 1px solid var(--line-strong);
  }

  .att-beat {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: 0.4rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .att-beat__n {
    grid-row: span 2;
    color: var(--brass-ink);
    font-size: 0.75rem;
    padding-top: 0.45rem;
  }

  .att-beat__t {
    font-family: var(--f-serif);
    font-weight: 400;
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.65rem);
    line-height: 1.2;
  }

  .att-beat__d {
    color: var(--ink-2);
    max-width: 38rem;
  }

  .att-demo__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }

  .att-demo__copy {
    display: grid;
    gap: 0.9rem;
  }

  .att-demo__text {
    max-width: 40rem;
    color: var(--ink-2);
  }

  .att-demo__cta {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  .att-demo__note {
    font-size: 0.6875rem;
    color: var(--ink-3);
    letter-spacing: 0.1em;
    line-height: 1.6;
  }

  .att-bound__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .att-bound__copy {
    display: grid;
    gap: 1.5rem;
  }

  .att-bound__line {
    font-family: var(--f-serif);
    font-weight: 300;
    font-size: clamp(1.45rem, 1.1rem + 1.4vw, 2.3rem);
    line-height: 1.3;
    max-width: 24em;
    text-wrap: balance;
    color: var(--on-navy);
  }

  .att-bound__more {
    color: var(--on-navy-2);
  }

  .att-bound__more a {
    color: var(--on-navy);
    text-underline-offset: 3px;
  }

  .att-bound__side {
    display: grid;
    gap: 2rem;
  }

  .att-bound__list {
    display: grid;
    gap: 1rem;
  }

  .att-bound__list li {
    position: relative;
    padding: 0 0 1rem 1.5rem;
    border-bottom: 1px solid var(--line-navy);
    color: var(--on-navy-2);
  }

  .att-bound__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.6rem;
    height: 0.6rem;
    border: 1.5px solid var(--brass-light);
    transform: rotate(45deg) scale(0.75);
  }

  .att-bound__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
  }

  @media (width <= 980px) {
    .att-how__grid,
    .att-bound__grid,
    .att-demo__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .att-how__fig {
      position: static;
      max-width: 520px;
      order: 2;
    }
  }
</style>
