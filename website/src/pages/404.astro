---
// 404 - on-brand, one line, link home.

import V6Layout from '../layouts/V6Layout.astro';

const title = '404 · Not on file';
const description = 'This dossier number is not on file.';
---
<V6Layout title={title} description={description} path="/404">
  <section class="ihero" aria-label="Not found" style="min-height:62vh">
    <div class="wrap">
      <p class="eyebrow">404 · missing entry</p>
      <h1 class="display">This dossier number is <em class="em-brass">not on file.</em></h1>
      <div class="acts">
        <a class="btn btn-line" href="/">Back to the index <span class="arr">→</span></a>
      </div>
    </div>
  </section>
</V6Layout>
