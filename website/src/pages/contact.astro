---
// /contact: direct to the founder. Intent chooser, one form posting to
// /api/lead, an honest side panel. No sales queue, no third-party form vendor.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import ContactForm from '../components/site/contact/ContactForm.astro';
import { SITE, breadcrumbSchema } from '../data/kriseva';

const title = 'Contact the founder | Kriseva';
const description =
  'Book a demo, request a TAS pilot or an Evaluator sandbox, or ask for a custom quote. There is no sales queue: the founder of Kriseva reads and replies to every serious note.';

const contactPage = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Kriseva',
  url: SITE + '/contact',
  inLanguage: 'en-IN',
  about: { '@id': SITE + '/#organization' },
};
---
<SiteLayout
  title={title}
  description={description}
  path="/contact"
  schema={[breadcrumbSchema([{ name: 'Contact', path: '/contact' }]), contactPage]}
>
  <PageHero
    eyebrow="Contact · Direct to the founder"
    title="Cross the bridge with us."
    accent="the bridge"
    lead="There is no sales development rep and no queue. Tell us which side of the table you sit on, and the founder replies."
    crumbs={[{ name: 'Contact', path: '/contact' }]}
  />
  <ContactForm />
</SiteLayout>
