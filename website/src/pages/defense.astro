---
// /defense - Defense procurement sector page (CORPORATE_SITE_V2_ARCHITECTURE.md
// §4, §5 item 4, §10). Institutional entry point for the sector: the
// bidder-side / evaluation-side problem (condensed "two rooms" concept,
// D-006 disposition table), TAS and EVALUATOR as its two systems, and how
// the Evidence Spine instantiates as "Tender bundle → bid decision".
//
// Claim-bearing wording only from src/data/publicClaims.ts, read through
// src/data/company.ts (sectors, portfolio, spineStations) wherever that
// data layer already carries the right claim, and directly via getClaim()
// for the two ids company.ts does not expose (act2.two-rooms,
// boundary.notClaimed).
//
// Procurement-clock motif: dropped. The clock concept's registered wording
// (act1.cycle-insight, act1.stage-names) is scoped to index.astro's Act 1
// only in publicClaims.ts; extending it to /defense would be an
// unregistered surface use, not a layout call. See W09-W10 receipt.

import BaseLayout from '../layouts/BaseLayout.astro';
import RouteHero from '../components/RouteHero.astro';
import SectionLabel from '../components/SectionLabel.astro';
import DossierCard from '../components/DossierCard.astro';
import MaturityChip from '../components/MaturityChip.astro';
import TenderBundleDiagram from '../components/TenderBundleDiagram.astro';
import PrimaryButton from '../components/PrimaryButton.astro';
import SecondaryButton from '../components/SecondaryButton.astro';
import { getClaim } from '../data/publicClaims';
import { portfolio, sectors, spineStations } from '../data/company';
import { routes } from '../data/routes';

const sector = sectors.find((s) => s.id === 'defense')!;
const tas = portfolio.find((p) => p.id === 'tas')!;
const evaluator = portfolio.find((p) => p.id === 'evaluator')!;
const twoRooms = getClaim('act2.two-rooms')!.wording;

const heroTitle = 'Two systems. <span class="brass">One evidence spine.</span>';
const title = 'KRISEVA · Defense procurement';
const description = sector.summary;
---
<BaseLayout title={title} description={description}>

  <RouteHero
    eyebrow="Sector · Defense procurement"
    title={heroTitle}
    subtitle={sector.summary}
    meta={sector.boundaryLine}
    surface="deep"
  >
    <Fragment slot="cta">
      <!-- Gate 3 fix (docs/v2-handoffs/INDEPENDENT_REVIEW_V2.md Minor 6):
           this primary CTA read "Request a demo" directly beneath the fixed
           header's "Contact Founder" CTA - two different asks for the same
           action in one viewport. Relabeled to match the sitewide
           Contact-the-founder/Request-a-demo pairing this same page's own
           closing CTA already uses (primary=contact, secondary=demo), and
           that /finance and /attest use for their hero primary. Href
           unchanged (still tags intent=demo); only the visible verb moved,
           matching how /finance's and /attest's hero CTAs already label a
           contactWithIntent() href as "Contact the founder". -->
      <PrimaryButton href={routes.contactWithIntent('demo')}>Contact the founder</PrimaryButton>
      <SecondaryButton href="#systems">See the two systems</SecondaryButton>
    </Fragment>
  </RouteHero>

  <!-- ============ THE PROBLEM · TWO ROOMS, CONDENSED ============ -->
  <section class="section section--paper" id="problem">
    <div class="container">
      <SectionLabel>The problem · two sides, one trust gap</SectionLabel>
      <h2>One tender, two rooms.</h2>
      <div class="rooms-grid">
        <div class="room">
          <p class="room-label">Bidder side</p>
          <h3>A small team, a heavy bundle.</h3>
          <p>A defense MSME finds a tender it could win, then the bundle arrives: specifications, BOQs, ATCs, corrigenda, annexures. One missed clause can end a bid before it is read in full.</p>
        </div>
        <div class="room">
          <p class="room-label">Evaluation side</p>
          <h3>A committee that must be right.</h3>
          <p>An evaluation committee receives rival bids and checks every claim against a record that has to survive an audit, sometimes years after the file is closed.</p>
        </div>
      </div>
      <p class="rooms-merge">{twoRooms}</p>
      <div class="bundle-visual">
        <TenderBundleDiagram surface="paper" caption="One tender, many parts: the bundle both systems in this sector are built to resolve." />
      </div>
    </div>
  </section>

  <!-- ============ THE TWO SYSTEMS ============ -->
  <section class="section section--navy" id="systems">
    <div class="container">
      <SectionLabel>The two systems</SectionLabel>
      <h2>Bidder-side and evaluation-side, one thesis.</h2>
      <div class="systems-grid">
        <DossierCard label="System 01 · Bidder-side" title={tas.name} meta={tas.primaryUser} surface="navy">
          <p>{tas.purpose}</p>
          <ul class="cap-list">
            {tas.capabilities.map((c) => (
              <li><span class="dot-brass" aria-hidden="true"></span>{c}</li>
            ))}
          </ul>
          <div class="card-foot">
            <MaturityChip maturity={tas.maturity} />
            <a class="card-link" href={tas.route}>Open KRISEVA TAS →</a>
          </div>
        </DossierCard>
        <DossierCard label="System 02 · Evaluation-side" title={evaluator.name} meta={evaluator.primaryUser} surface="navy">
          <p>{evaluator.purpose}</p>
          <ul class="cap-list">
            {evaluator.capabilities.map((c) => (
              <li><span class="dot-brass" aria-hidden="true"></span>{c}</li>
            ))}
          </ul>
          <div class="card-foot">
            <MaturityChip maturity={evaluator.maturity} />
            <a class="card-link" href={evaluator.route}>Open KRISEVA Evaluator →</a>
          </div>
        </DossierCard>
      </div>
    </div>
  </section>

  <!-- ============ EVIDENCE SPINE · TENDER BUNDLE → BID DECISION ============ -->
  <!-- Gate 3 fix (docs/v2-handoffs/INDEPENDENT_REVIEW_V2.md Major 3): the
       six-station prose paragraphs (one EvidenceCard per station, each
       carrying the full capabilityV2.* description) repeated near-verbatim
       across home, /capabilities, /defense, and /finance. Control-plane
       ruling: home and /capabilities keep the full treatment; /defense and
       /finance compress to the instantiation strip only - station labels in
       sequence plus the sector's input/output framing and at most one
       introductory sentence. Full station-by-station explanation now lives
       at /capabilities only. -->
  <section class="section section--paper" id="spine">
    <div class="container">
      <SectionLabel>The Evidence Spine · tender bundle → bid decision</SectionLabel>
      <h2>The same six stations, applied to a tender.</h2>
      <p class="spine-intro">Both systems in this sector run the same evidence architecture; full walkthrough of each station at <a href={routes.capabilities}>/capabilities</a>.</p>
      <div class="spine-strip">
        <span class="spine-bound">Tender bundle</span>
        <ol class="spine-mid">
          {spineStations.map((s) => (
            <li>{s.label}</li>
          ))}
        </ol>
        <span class="spine-bound spine-bound--out">Bid decision</span>
      </div>
    </div>
  </section>

  <!-- ============ BOUNDARY ============ -->
  <section class="section section--dark section--tight" id="boundary">
    <div class="container">
      <SectionLabel>Boundary</SectionLabel>
      <p class="boundary-line">{sector.boundaryLine}</p>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section section--paper" id="cta">
    <div class="container closing-cta">
      <h2>See it on your own tenders.</h2>
      <p>If your team bids or evaluates on the defense side, the conversation is direct and founder-led.</p>
      <div class="closing-cta__buttons">
        <PrimaryButton href={routes.contact}>Contact the founder</PrimaryButton>
        <SecondaryButton href={routes.contactWithIntent('demo')} variant="ghost-paper">Request a demo</SecondaryButton>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  h2 { margin-bottom: 20px; }
  .rooms-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 3vw, 44px);
    margin-top: 8px;
  }
  /* Contrast fix (Phase 5): --accent-soft measures ~3.11:1 on this
     #problem section's --surface-paper background. AA-safe brass cut,
     same family as the N2 MaturityChip/EvidenceCard correction. */
  .room-label {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--accent-text-safe, #91601c);
    margin-bottom: 10px;
  }
  .room h3 { margin-bottom: 10px; }
  .room p:not(.room-label) { color: var(--ink-secondary); }
  .rooms-merge {
    margin-top: clamp(28px, 4vw, 44px);
    padding-top: clamp(20px, 3vw, 32px);
    border-top: var(--rule-paper);
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    line-height: 1.35;
    max-width: 46ch;
  }
  .bundle-visual { max-width: 420px; margin: clamp(28px, 4vw, 40px) auto 0; }
  @media (max-width: 780px) {
    .rooms-grid { grid-template-columns: 1fr; gap: 28px; }
  }

  .systems-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(18px, 2.6vw, 32px);
  }
  .cap-list { margin: 16px 0 0; display: flex; flex-direction: column; gap: 10px; }
  .cap-list li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }
  .card-foot {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(193, 138, 62, 0.18);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .card-link { font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.06em; }
  @media (max-width: 780px) {
    .systems-grid { grid-template-columns: 1fr; }
  }

  .spine-intro { max-width: 66ch; color: var(--ink-secondary); margin-bottom: clamp(20px, 3vw, 32px); }
  .spine-intro a { color: var(--accent-text-safe, #91601c); }

  /* Instantiation strip (Gate 3 compression): station labels only, no
     per-station prose. Adapted from EvidenceSpine.astro's own
     .spine-instantiation row (homepage), same paper-surface token set. */
  .spine-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 4px;
  }
  .spine-bound {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-primary);
    border: 1px solid rgba(16, 35, 59, 0.28);
    border-radius: var(--radius-badge);
    padding: 6px 11px;
  }
  .spine-bound--out { color: var(--accent-text-safe, #91601c); border-color: var(--accent-line); }
  .spine-mid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    flex: 1 1 auto;
    min-width: 220px;
  }
  .spine-mid li {
    font-family: var(--font-mono);
    font-size: var(--text-discipline);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-quiet);
    white-space: nowrap;
  }
  .spine-mid li:not(:last-child)::after {
    content: "\2192";
    display: inline-block;
    margin: 0 6px;
    color: var(--ink-quiet);
    opacity: 0.6;
  }
  @media (max-width: 640px) {
    .spine-mid { min-width: 0; }
  }

  .boundary-line {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    color: var(--text-secondary);
    max-width: 64ch;
  }

  .closing-cta { max-width: 720px; text-align: center; }
  .closing-cta h2 { margin-bottom: 14px; }
  .closing-cta p { color: var(--ink-secondary); margin-bottom: 26px; }
  .closing-cta__buttons { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
</style>
