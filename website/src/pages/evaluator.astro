---
// /evaluator - Kriseva Evaluator product page (issuer-side, Vol. II).
// Restructured at W08 (CORPORATE_SITE_V2_ARCHITECTURE.md §10, §16): keeps
// the six-state model, the three-path convergence explanation, the audit
// chain, and the committee-assist framing (load-bearing: the system
// recommends, committees decide). Adds the D-011-adjudicated
// evaluatorV2.e2e-candidate claim in its exact registered wording, paired
// with the working-prototype MaturityChip. Sector-level framing (why
// defense procurement needs this, how it relates to TAS) now lives on
// /defense; this page links out rather than repeating it.
//
// The interactive SVG "convergence instrument" (a client-script-drawn
// diagram whose findings text and verdict chip were empty without JS) and
// VerdictSimulator (free-typed exhibit copy, not sourced from a registered
// claim id, whose output panel also rendered blank without JS) are both
// dropped from this page: the former in favor of the three static path
// cards below, which explain the same convergence architecture fully via
// SSR; the latter per this work order's own carve-out ("keep VerdictSimulator
// if its copy is registered and it renders statically; otherwise archive its
// usage"). See the W08 receipt in docs/v2-handoffs/ for the full reasoning.
// The audit chain below is kept (explicitly required) with its default
// three-block state now server-rendered so the exhibit is complete before
// any script runs; the inline script only adds verify / tamper / reset.
//
// Claim-bearing wording: src/data/publicClaims.ts (evaluator.*, evaluatorV2.*)
// and the founder-signed v6 homepage corpus.

import V6Layout from '../layouts/V6Layout.astro';
import SectionHead from '../components/v6/SectionHead.astro';
import MaturityChip from '../components/MaturityChip.astro';
import { getClaim } from '../data/publicClaims';

const positioning = getClaim('evaluator.positioning')!.wording;
const oneLiner = getClaim('evaluator.one-liner')!.wording;
const evalStatus = getClaim('evaluator.eval-status')!.wording;
const sovereign = getClaim('evaluator.sovereign')!.wording;
const sixState = getClaim('evaluator.six-state')!.wording;
const auditChain = getClaim('evaluator.audit-chain')!.wording;
const threePath = getClaim('evaluator.three-path')!.wording;
const e2eClaim = getClaim('evaluatorV2.e2e-candidate')!.wording;
const notClaimed = getClaim('boundary.notClaimed')!.wording;

const title = 'KRISEVA · Evaluator · Committee-assist bid evaluation, on-premise';
const description = oneLiner + ' Three-path convergence, a six-state verdict model, and a hash-chained audit log.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Kriseva Evaluator',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'On-premise deployment',
    description: oneLiner,
    publisher: { '@type': 'Organization', name: 'KRISEVA AI Private Limited' },
  },
];

// Six verdict states. Wording mirrors the founder-signed homepage verdict
// vocabulary and reason map; the two uncertain states route to humans.
const states = [
  { k: 'v', name: 'Verified', text: 'Declared and evidenced; meets the clause as written.', hitl: false },
  { k: 'q', name: 'Verified · qualified', text: 'Met, but scope qualifies a sub-line; flagged for the committee.', hitl: false },
  { k: 'd', name: 'Requires demonstration', text: 'Partially evidenced; a demonstration is required to confirm.', hitl: false },
  { k: 'i', name: 'Insufficient', text: 'Some evidence present; not enough to clear the clause.', hitl: true },
  { k: 'm', name: 'Missing', text: 'No instrument or document located in the bundle.', hitl: true },
  { k: 'f', name: 'Failed', text: 'Evidence present and clearly non-compliant. Never silent.', hitl: false },
];

// Audit chain: three-block demonstration, rendered server-side so the
// exhibit is complete before the verify/tamper/reset script runs.
const auditBlocks = [
  { id: '0148', ev: 'verdict_signed', ts: '14:22:07 IST', h: '9f3a…c1d2', p: '4e58…a907', b: 'Criterion 31 · Verified · member B' },
  { id: '0149', ev: 'clarification', ts: '14:26:41 IST', h: 'b70e…44af', p: '9f3a…c1d2', b: 'Criterion 47 · clarification requested' },
  { id: '0150', ev: 'recommendation', ts: '15:03:12 IST', h: 'c2d8…91b6', p: 'b70e…44af', b: 'Tender recommendation sealed' },
];
---
<V6Layout title={title} description={description} path="/evaluator" schema={schema}>

  <!-- ============ HERO ============ -->
  <section class="ihero" aria-label="Kriseva Evaluator">
    <div class="wrap">
      <p class="eyebrow">Kriseva Evaluator · Issuer-side · Vol. II</p>
      <h1 class="display">Evaluation that <em class="em-brass">shows its work.</em></h1>
      <p class="dek">{positioning}</p>
      <div class="acts">
        <a class="btn btn-fill" href="/contact">Request a demo <span class="arr">→</span></a>
        <a class="btn btn-line" href="#audit">Walk the audit chain</a>
      </div>
      <!-- Gate 3 fix (docs/v2-handoffs/INDEPENDENT_REVIEW_V2.md Major 2):
           evaluator.eval-status used to render here too, immediately beside
           the working-prototype MaturityChip. Control-plane ruling caps it
           at one appearance on this page; kept at the Field Status section
           below ("On the record", §06) instead of here, since pairing it
           directly against the maturity chip in the hero was the exact
           amplification the review flagged ("working prototype" plus a
           named government security-force category reading as stronger
           validation than either states alone). -->
      <div class="ihero-meta" aria-label="Product status">
        <MaturityChip maturity="working-prototype" />
        <span>Committee-assist · the committee signs</span>
      </div>
    </div>
  </section>

  <!-- ============ THREE-PATH CONVERGENCE ============ -->
  <section class="sec-pad" id="threepath" style="padding-top:clamp(30px,4vw,56px)">
    <div class="wrap">
      <SectionHead eyebrow="The reasoning · three paths, one criterion" folio="§01 / 07"
        dek="Every criterion is evaluated three independent ways. The paths must converge; disagreement is surfaced to the committee, never averaged away.">
        Three paths to <em class="em-brass">one verdict.</em>
      </SectionHead>
      <div class="paths" role="list" aria-label={threePath}>
        <div class="path regmark" role="listitem">
          <span class="pno">Path 01</span>
          <h3>Deterministic</h3>
          <p>Rule and clause checks run first. What can be decided by rule is decided by rule, and recorded as such.</p>
          <span class="ptag">reproducible</span>
        </div>
        <div class="path regmark" role="listitem">
          <span class="pno">Path 02</span>
          <h3>Retrieval</h3>
          <p>Evidence retrieval against the bid bundle. Every citation carries its clause and page.</p>
          <span class="ptag">evidence-linked</span>
        </div>
        <div class="path regmark" role="listitem">
          <span class="pno">Path 03</span>
          <h3>Local-model judgment</h3>
          <p>A local model reasons over the same criterion, on-premise. No cloud inference.</p>
          <span class="ptag">sovereign-by-design</span>
        </div>
      </div>
      <div class="converge" aria-hidden="true">
        <span class="cv-line"></span><span class="cv-label">convergence</span><span class="cv-line"></span>
      </div>
      <div class="verdict-out regmark">
        <span class="eyebrow">The output</span>
        <p>One of six states, with the source clause beside it. {sixState}</p>
      </div>
    </div>
  </section>

  <!-- ============ SIX-STATE VERDICT MODEL ============ -->
  <section class="sec-pad sec-sunk" id="verdicts">
    <div class="wrap">
      <SectionHead eyebrow="The verdict model · six states, none silent" folio="§02 / 07"
        dek="Saturated pass/fail hides judgment. Six desaturated states carry it: what is met, what is qualified, what needs a human, and what failed, each with its clause.">
        Six states. <em class="em-brass">Nothing silent.</em>
      </SectionHead>
      <div class="vgrid" role="list">
        {states.map((s) => (
          <div class={`vcard regmark${s.hitl ? ' hitl' : ''}`} role="listitem">
            <div class="vhead"><span class={`sq ${s.k}`} aria-hidden="true"></span><b class={`vname t-${s.k}`}>{s.name}</b></div>
            <p>{s.text}</p>
            {s.hitl && <span class="vroute">→ auto-routes to human review</span>}
            {!s.hitl && <span class="vroute quiet">→ recorded with source · the committee signs</span>}
          </div>
        ))}
      </div>
      <p class="disclose">Verdict vocabulary as shipped · the two uncertain states always reach a human</p>
    </div>
  </section>

  <!-- ============ DEMONSTRATED END TO END ============ -->
  <section class="sec-pad" id="e2e">
    <div class="wrap">
      <SectionHead eyebrow="Demonstrated · end to end" folio="§03 / 07"
        dek="The six-state model above is not only a design.">
        One tender, <em class="em-brass">all six states.</em>
      </SectionHead>
      <div class="teststatus regmark">
        <div class="teststatus-row">
          <p>{e2eClaim}</p>
          <MaturityChip maturity="working-prototype" />
        </div>
        <span class="src-note">Register entry evaluatorV2.e2e-candidate · safe-with-care · adjudicated D-011 · full wording, no paraphrase</span>
      </div>
    </div>
  </section>

  <!-- ============ AUDIT CHAIN (interactive) ============ -->
  <section class="sec-pad sec-navy" id="audit">
    <div class="wrap">
      <SectionHead eyebrow="The audit chain · append-only" folio="§04 / 07"
        dek="Every event is hash-chained to the last. Verify the chain, then tamper with a block and watch the break propagate. The database enforces this; the demo simulates it.">
        A record that cannot<br />be quietly edited.
      </SectionHead>
      <div class="chaingrid">
        <div>
          <div class="chain" id="chain" aria-label="Hash-chained audit log demonstration">
            {auditBlocks.map((bl, i) => (
              <>
                {i > 0 && <div class="clink"></div>}
                <div class="cblock">
                  <div class="bh"><span>Block {bl.id} · {bl.ev}</span><span>{bl.ts}</span></div>
                  <div class="hash">{bl.h} ← {bl.p}</div>
                  <div class="bbody">{bl.b}</div>
                  <div class="flag ok">✓ hash matches previous block</div>
                  <div class="flag bad">✕ hash mismatch · tamper detected</div>
                </div>
              </>
            ))}
          </div>
          <p class="chain-status" id="chainStatus" aria-live="polite">Chain unverified. Run a verification pass.</p>
          <div class="chain-controls">
            <button class="btn btn-line btn-sm" id="verifyBtn">Verify chain</button>
            <button class="btn btn-line btn-sm" id="tamperBtn">Tamper with block 0149</button>
            <button class="btn btn-line btn-sm" id="resetBtn">Reset</button>
          </div>
          <p class="disclose">Simulated for demonstration: synthetic events, not a real evaluation.</p>
        </div>
        <!-- a11y fix (Phase 5): was <aside>, nested inside <main>, which
             trips axe's landmark-complementary-is-top-level. Plain <div>
             keeps the identical box and position. -->
        <div class="chainaside">
          <p>{auditChain} Not a screenshot, not a summary. A vigilance officer can walk it end to end.</p>
          <p class="trust">append-only<br />sha-256-chained<br />mutation-blocked at the database</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SOVEREIGN POSTURE ============ -->
  <section class="sec-pad" id="posture">
    <div class="wrap">
      <SectionHead eyebrow="Deployment posture · inside the building" folio="§05 / 07"
        dek="Built for evaluation networks where documents do not leave the room, let alone the country.">
        The network is the <em class="em-brass">perimeter.</em>
      </SectionHead>
      <ul class="caps" aria-label="Deployment posture">
        <li><span><b>{sovereign}</b></span><span class="ref">sovereign-by-design</span></li>
        <li><span>Bid documents, verdicts and the audit log live in the customer deployment. Nothing routes through a vendor cloud.</span><span class="ref">on-premise</span></li>
        <li><span>{threePath} The reasoning is shown, not summarised away.</span><span class="ref">reproducible</span></li>
        <li><span>Committee-assist only. The system recommends; <b>the committee signs.</b></span><span class="ref">committee-assist</span></li>
      </ul>
      <div class="acts" style="margin-top:34px">
        <a class="btn btn-line" href="/security">Read the boundary <span class="arr">→</span></a>
      </div>
    </div>
  </section>

  <!-- ============ ON THE RECORD ============ -->
  <section class="sec-pad sec-sunk" id="status">
    <div class="wrap">
      <SectionHead eyebrow="Field status" folio="§06 / 07"
        dek="Status-labelled, no hype. Named relationships appear with consent. This system is one of two KRISEVA runs in defense procurement; the sector page covers how bidder-side and evaluation-side connect.">
        On the record.
      </SectionHead>
      <div class="record">
        <div class="rec"><span class="date">Active</span><span class="what">{evalStatus}</span><span class="tag">In evaluation</span></div>
        <div class="rec"><span class="date">Standing</span><span class="what">{notClaimed}</span><span class="tag">Boundary</span></div>
      </div>
      <div class="acts" style="margin-top:40px">
        <a class="btn btn-line" href="/defense">The sector this serves <span class="arr">→</span></a>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="sec-pad sec-navy" id="cta">
    <div class="wrap">
      <SectionHead eyebrow="Next step" folio="§07 / 07"
        dek="If your committee evaluates GeM or DefProc tenders, the conversation is direct and founder-led.">
        See it on your <em class="em-brass">own evaluations.</em>
      </SectionHead>
      <div class="acts" style="display:flex;flex-wrap:wrap;gap:14px">
        <a class="btn btn-fill" href="/contact">Speak with the founder <span class="arr">→</span></a>
      </div>
    </div>
  </section>

</V6Layout>

<style is:global>
/* /evaluator page-specific */

/* three-path exhibit */
.paths{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(16px,2.4vw,34px)}
.path{border-top:2px solid var(--ink);padding:20px 18px 22px;background:var(--paper-raised)}
.path .pno{font-family:var(--mono);font-size:.6rem;letter-spacing:.22em;text-transform:uppercase;color:var(--ink-sec)}
.path h3{font-family:var(--serif);font-weight:400;font-size:clamp(1.4rem,2vw,1.9rem);letter-spacing:-0.01em;margin-top:10px}
.path p{margin-top:10px;font-size:.92rem;line-height:1.55;color:var(--ink-sec)}
/* Contrast fix (Phase 5): raw --brass measured 3.52:1 on --paper-raised.
   --brass-deep is the AA-safe darker brass cut used sitewide for
   chrome/text on this surface. */
.path .ptag{display:inline-block;margin-top:14px;font-family:var(--mono);font-size:.56rem;letter-spacing:.14em;
  text-transform:uppercase;color:var(--brass-deep);border:1px solid var(--rule);border-radius:2px;padding:4px 9px}
.converge{display:flex;align-items:center;gap:14px;margin:clamp(22px,3vw,38px) auto;max-width:520px}
.converge .cv-line{flex:1;height:1px;background:var(--ink-sec)}
.converge .cv-label{font-family:var(--mono);font-size:.58rem;letter-spacing:.26em;text-transform:uppercase;color:var(--ink-sec)}
.verdict-out{max-width:640px;margin-inline:auto;border:1px solid var(--ink);border-radius:2px;
  background:var(--paper-raised);padding:22px 24px;text-align:left}
.verdict-out p{margin-top:10px;font-size:.98rem;line-height:1.6}
@media (max-width:860px){.paths{grid-template-columns:1fr}}

/* six-state verdict grid */
.vgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(14px,2vw,26px)}
.vcard{background:var(--paper-raised);border:1px solid var(--rule);border-radius:2px;padding:18px 18px 20px}
.vcard.hitl{border-style:dashed;border-color:var(--ink-sec)}
.vcard .vhead{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.vcard .vname{font-family:var(--mono);font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;font-weight:600}
.vcard p{font-size:.9rem;line-height:1.55;color:var(--ink-sec)}
/* Contrast fix (Phase 5): raw --brass measured 3.52:1 on --paper-raised;
   --ink-quiet measured 3.26:1 on the same surface. --brass-deep /
   --ink-sec are the AA-safe cuts already used for this pairing
   elsewhere on this page (.path .ptag / .path p). */
.vcard .vroute{display:block;margin-top:12px;font-family:var(--mono);font-size:.58rem;letter-spacing:.1em;
  text-transform:uppercase;color:var(--brass-deep)}
.vcard .vroute.quiet{color:var(--ink-sec)}
.t-v{color:var(--vt-verified)}.t-q{color:var(--vt-qualified)}.t-i{color:var(--vt-insufficient)}
.t-m{color:var(--vt-missing)}.t-d{color:var(--vt-demo)}.t-f{color:var(--vt-failed)}
@media (max-width:860px){.vgrid{grid-template-columns:1fr}}

/* demonstrated end-to-end callout */
.teststatus{border:1px solid var(--ink);border-radius:2px;background:var(--paper-raised);
  padding:clamp(20px,3vw,34px)}
.teststatus-row{display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-start;justify-content:space-between}
.teststatus p{font-size:1.06rem;line-height:1.75;max-width:64ch;margin:0}
.teststatus .src-note{display:block;margin-top:14px}

/* audit chain (ported from the v6 homepage) */
.chaingrid{display:grid;grid-template-columns:minmax(0,7fr) minmax(260px,4fr);gap:clamp(24px,4vw,64px);align-items:start}
.chain{display:flex;flex-direction:column;gap:0}
.cblock{border:1px solid rgba(233,226,210,.28);background:rgba(233,226,210,.045);border-radius:2px;
  padding:16px 18px;transition:border-color .3s,background .3s;position:relative}
.clink{width:1px;height:26px;background:rgba(233,226,210,.3);margin-left:34px;position:relative}
.clink::after{content:"⌄";position:absolute;left:-6px;bottom:-4px;color:rgba(233,226,210,.45);font-size:.7rem}
.cblock .bh{display:flex;justify-content:space-between;gap:12px;font-family:var(--mono);font-size:.6rem;
  letter-spacing:.14em;text-transform:uppercase;color:rgba(233,226,210,.65);margin-bottom:8px}
.cblock .hash{font-family:var(--mono);font-size:.72rem;letter-spacing:.06em;color:var(--brass-lt);margin-bottom:8px}
.cblock .bbody{font-size:.9rem;color:var(--on-navy-dim)}
.cblock .flag{display:none;margin-top:10px;font-family:var(--mono);font-size:.62rem;letter-spacing:.1em}
.cblock.valid{border-color:rgba(122,200,160,.55)}
.cblock.valid .flag.ok{display:block;color:#9CD3B4}
.cblock.broken{border-color:rgba(220,120,105,.6);background:rgba(131,51,45,.16)}
.cblock.broken .flag.bad{display:block;color:#E8A99C}
.chain-status{margin-top:18px;font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;
  color:var(--on-navy-dim);min-height:2.6em}
.chain-controls{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
.chainaside p{color:var(--on-navy-dim);max-width:44ch;text-wrap:pretty}
.chainaside .trust{margin-top:22px;font-family:var(--mono);font-size:.66rem;letter-spacing:.12em;
  color:var(--brass-lt);line-height:2}
@media (max-width:1080px){.chaingrid{grid-template-columns:1fr}}
</style>

<script is:inline>
// Audit chain: verify / tamper / reset. The three blocks already render via
// SSR above (see auditBlocks in the frontmatter); render() below keeps that
// same default state in JS so verify/tamper/reset can mutate it, then
// re-renders identically on load (idempotent, no visible change until a
// button is used). Synthetic events, simulated for demonstration.
(function () {
  var REDUCE = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var blocks = [
    { id: '0148', ev: 'verdict_signed', ts: '14:22:07 IST', h: '9f3a…c1d2', p: '4e58…a907', b: 'Criterion 31 · Verified · member B' },
    { id: '0149', ev: 'clarification', ts: '14:26:41 IST', h: 'b70e…44af', p: '9f3a…c1d2', b: 'Criterion 47 · clarification requested' },
    { id: '0150', ev: 'recommendation', ts: '15:03:12 IST', h: 'c2d8…91b6', p: 'b70e…44af', b: 'Tender recommendation sealed' }
  ];
  var chain = document.getElementById('chain'), status = document.getElementById('chainStatus');
  if (!chain) return;
  function render() {
    chain.innerHTML = '';
    blocks.forEach(function (bl, i) {
      if (i > 0) { var l = document.createElement('div'); l.className = 'clink'; chain.appendChild(l); }
      var d = document.createElement('div');
      d.className = 'cblock' + (bl.state || '');
      d.innerHTML =
        '<div class="bh"><span>Block ' + bl.id + ' · ' + bl.ev + '</span><span>' + bl.ts + '</span></div>' +
        '<div class="hash">' + bl.h + ' ← ' + bl.p + '</div>' +
        '<div class="bbody">' + bl.b + '</div>' +
        '<div class="flag ok">✓ hash matches previous block</div>' +
        '<div class="flag bad">✕ hash mismatch · tamper detected</div>';
      chain.appendChild(d);
    });
  }
  render();
  document.getElementById('verifyBtn').addEventListener('click', function () {
    var broken = false;
    blocks.forEach(function (bl, i) {
      setTimeout(function () {
        if (bl.tampered || broken) { broken = true; bl.state = ' broken'; } else { bl.state = ' valid'; }
        render();
        if (i === blocks.length - 1) {
          status.textContent = broken
            ? 'CHAIN BROKEN: an edited block no longer matches the next. Tamper is visible.'
            : 'CHAIN VERIFIED: every block hashes to the next. Untampered.';
          status.style.color = broken ? '#E8A99C' : '#9CD3B4';
        }
      }, REDUCE ? 0 : i * 460);
    });
  });
  document.getElementById('tamperBtn').addEventListener('click', function () {
    blocks[1].tampered = true;
    blocks[1].b = 'Criterion 47 · verdict ALTERED post-hoc';
    blocks[1].h = 'b70e…0000';
    blocks.forEach(function (b) { b.state = ''; });
    render();
    status.textContent = 'Block 0149 edited. Now run "Verify chain".';
    status.style.color = '#C89A4C';
  });
  document.getElementById('resetBtn').addEventListener('click', function () {
    blocks[1].tampered = false;
    blocks[1].b = 'Criterion 47 · clarification requested';
    blocks[1].h = 'b70e…44af';
    blocks.forEach(function (b) { b.state = ''; });
    render();
    status.textContent = 'Chain unverified. Run a verification pass.';
    status.style.color = '';
  });
})();
</script>
