---
// /evaluator: Evaluator, for buyers. v3 "Bridge" page.
// Hero, five moves, finding states, comparative statement, tamper-evident
// chain, sovereignty, FAQ, the sandbox offer. Every bid shown is a SPECIMEN.
// Wording ceiling (00_BRAIN/FACTS.md): every finding links to the source page
// and is recorded in a tamper-evident audit chain; officers decide.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import Faq from '../components/site/Faq.astro';
import Sovereign from '../components/site/home/Sovereign.astro';
import EvalHeroVisual from '../components/site/evaluator/EvalHeroVisual.astro';
import EvalMoves from '../components/site/evaluator/EvalMoves.astro';
import EvalStates from '../components/site/evaluator/EvalStates.astro';
import EvalStatement from '../components/site/evaluator/EvalStatement.astro';
import EvalChain from '../components/site/evaluator/EvalChain.astro';
import EvalCross from '../components/site/evaluator/EvalCross.astro';
import { breadcrumbSchema, faqSchema, softwareSchema } from '../data/kriseva';
import type { Faq as FaqItem } from '../data/faq';

const title = 'Evaluator: bid evaluation with evidence for government committees | Kriseva';
const description =
  'Evaluator helps defence and space evaluation committees check every bid: each finding opens its source page, records are tamper-evident, officers decide. Offline.';

const evalFaqs: FaqItem[] = [
  {
    q: 'Does Evaluator decide which bid wins?',
    a: 'No. Evaluator proposes findings with evidence, and each one links to the page it came from. The committee reviews them, and a named officer makes and records the decision.',
  },
  {
    q: 'What happens when a finding is uncertain?',
    a: 'It is marked as needing clarification or not found, with the page or the pages searched, and it goes to a person. Nothing is disqualified silently.',
  },
  {
    q: 'Are price bids visible during technical evaluation?',
    a: 'No. Price annexes stay sealed while the technical evaluation runs, so findings on eligibility and compliance are made without seeing prices.',
  },
  {
    q: 'Can an auditor check the record later?',
    a: 'Yes. Every finding and decision is written to a hash-chained record. An auditor can verify the chain; one edit after the fact breaks it, visibly.',
  },
  {
    q: 'Does Evaluator need the internet?',
    a: 'No. It runs on your own machines with local models. In a test on 6 October 2026, it cold-started with the Wi-Fi off and zero application requests left the machine.',
  },
  {
    q: 'How can our committee try it?',
    a: 'With a sandbox on one closed tender. We run Evaluator on a tender your committee has already decided, offline and in your room, so you can check every finding against your own result.',
  },
];

const schema = [
  softwareSchema({
    name: 'Kriseva Evaluator',
    path: '/evaluator',
    description:
      'Bid evaluation support for government committees: criteria in the tender’s words, every finding linked to its source page, a comparative statement, and a tamper-evident record. Officers decide. Runs offline, on-premise.',
    audience: 'Government evaluation committees',
  }),
  breadcrumbSchema([{ name: 'Evaluator', path: '/evaluator' }]),
  faqSchema(evalFaqs),
];
---
<SiteLayout title={title} description={description} path="/evaluator" schema={schema}>
  <PageHero
    eyebrow="Products · Evaluator · For buyers"
    title="Check every bid, with a page behind every finding."
    accent="a page behind every finding"
    lead="Evaluator reads every bid packet against the tender’s own criteria. Each finding opens the page it came from, uncertain ones go to a person, and the record cannot be quietly edited. Officers decide."
    crumbs={[{ name: 'Evaluator', path: '/evaluator' }]}
  >
    <Fragment slot="actions">
      <a class="btn" href="/contact?intent=pilot&amp;side=buyer">Request a sandbox <span class="arrow" aria-hidden="true">&rarr;</span></a>
      <a class="btn btn--ghost" href="/contact?intent=demo">Book a demo</a>
    </Fragment>
    <Fragment slot="visual">
      <EvalHeroVisual />
    </Fragment>
  </PageHero>

  <EvalMoves />
  <EvalStates />
  <EvalStatement />
  <EvalChain />
  <Sovereign compact />
  <Faq items={evalFaqs} index="06" title="Evaluator, in six answers." id="faq" />
  <EvalCross />
</SiteLayout>
